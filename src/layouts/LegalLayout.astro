---
import BaseLayout from "@/layouts/BaseLayout.astro";

export interface Props {
  title: string;
  kicker: string;
  /** HTML already escaped by the caller. */
  summary?: string;
  version?: string;
  updatedAt?: string;
  locale?: "en" | "it";
  /** The same document in the other language. */
  alternate?: { href: string; label: string; hreflang: "en" | "it" };
}

const { title, kicker, summary, version, updatedAt, locale = "it", alternate } = Astro.props;
const etichette = locale === "en"
  ? { aggiornato: "Last updated", versione: "Version" }
  : { aggiornato: "Ultimo aggiornamento", versione: "Versione" };
const meta = [
  updatedAt ? `${etichette.aggiornato}: ${updatedAt}` : null,
  version ? `${etichette.versione} ${version}` : null,
].filter(Boolean).join(" · ");
---

<BaseLayout title={title} description={summary ? summary.replace(/<[^>]+>/g, "") : title} noIndex locale={locale}>
  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-prose">
      <p class="eyebrow mb-6 text-accent-glow">{kicker}</p>
      <h1 class="entry-title mb-5">{title}</h1>
      {summary && <p class="prose-ink text-lg max-w-prose" set:html={summary} />}
      {(meta || alternate) && (
        <p class="mt-6 text-xs font-mono text-ink-500">
          {meta}
          {meta && alternate && " · "}
          {alternate && <a href={alternate.href} hreflang={alternate.hreflang} lang={alternate.hreflang} class="underline underline-offset-2">{alternate.label}</a>}
        </p>
      )}
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="container-prose">
      <article class="prose-v2 prose-v2-legal">
        <slot />
      </article>
    </div>
  </section>

</BaseLayout>
