---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/sv";
import pricing from "@/data/pricing/sv";
import copy from "@/data/homeCopy/sv";

const description = "En canvas för att lära, inte en anteckningsapp. Fluera gör dina handskrivna anteckningar till en levande karta över utbildningen och förhör dig innan minnet sviker.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/sv/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="sv">
  <PremiumHome locale="sv" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
