---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Kryptering",
    body: "På din enhet är databasen med dina canvasar krypterad i vila med sqlite3mc (ChaCha20-Poly1305, 256-bitars nyckel); foton, PDF:er och ljud från föreläsningar är filer i appens privata mapp, skyddade av operativsystemet. En exporterad .fluera-fil är inte krypterad; den Krypterade säkerhetskopian är förseglad med AES-256-GCM. Trafiken går över TLS. Cloud sync är inte end-to-end-krypterad: synkade canvasar lagras på EU-infrastruktur (Supabase, eu-north-1), krypterade under överföring och i vila på infrastrukturnivå. Som personuppgiftsansvarig kan vi tekniskt komma åt synkat innehåll — men vi säljer det aldrig och använder det aldrig för reklam.",
  },
  {
    title: "Dataägande",
    body: "Varje byte du skriver kan exporteras med ett klick: PNG, JPEG, WebP, SVG, PDF och vårt .fluera-format. Dina canvasar lever först på dina enheter. Molnet är en bekvämlighet, inte ett fängelse — inlåsning är en affärsmodell vi valt bort.",
  },
  {
    title: "GDPR från grunden",
    body: "Fluera hostas på servrar i Europa och är designad efter GDPR-principerna. Ett Data Processing Agreement finns på begäran för varje utbildningsinstitution. Fullständig dataexport och rätten att bli glömd hanteras inom 30 dagar (oftast inom 48 timmar).",
  },
  {
    title: "Local-first, alltid",
    body: "Du kan använda Fluera helt offline. Synkning mellan dina enheter är av tills du slår på den, och den gäller hela ditt konto. Med synk avstängd stannar dina canvasar på enheten. Allt annat lämnar den bara så som guiden Integritet och AI-samtycke beskriver, reglage för reglage: telemetri till exempel bara med ditt samtycke, kopplad till ditt konto och aldrig med innehåll.",
  },
  {
    title: "Vad vi inte gör",
    body: "Vi visar ingen reklam. Vi säljer inte din data. Vi tränar inga modeller på dina canvasar om du inte väljer det: Träningsdata för AI är av tills du slår på det. Vi spårar dig inte på webben. Vi lämnar inte ut data till tredje part utöver namngivna underbiträden (listade på sidan Underbiträden) — alla under biträdesavtal.",
  },
];
---

<BaseLayout
  title="Säkerhet och integritet"
  description="Krypterad lokal databas, GDPR från grunden, servrar i Europa, noll ad-tech. Flueras säkerhetsarkitektur och löftet om att din data är din."
  locale="sv"
>
  <PageHero
    kicker="Säkerhet och integritet"
    title="Krypterat i vila och under överföring.<br />Servrar i EU."
    titleSize="2xl"
    description="Kryptering som standard. Ingen ad-tech. Servrar i Europa. Full export. Integritet är en designrestriktion, inte en compliance-uppgift."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Hittade du något?</h2>
          <p class="prose-ink mb-6">
            Säkerhetsforskare är välkomna här. Rapportera sårbarheter till <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Vi svarar inom 5 arbetsdagar. Det finns inget bug bounty-program.
          </p>
          <p class="text-sm text-ink-500 italic">
            Reglerna för rapporter finns också i /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance och utrullning</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Ska du införa Fluera på en institution?</h2>
          <p class="prose-ink mb-6">
            Universitet, skolor, forskningslabb: vi kan guida dig genom DPA och listan över underbiträden. Piloter brukar börja med en klass, en termin, utan kostnad.
          </p>
          <a href="/sv/contact" class="btn-primary">Prata om utrullning →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Den här sidan täcker det väsentliga. Hela arkitekturen och listan över underbiträden bor på
        <a href="/sv/security/architecture" class="text-paper-300 underline">/sv/security/architecture</a> och
        <a href="/sv/security/sub-processors" class="text-paper-300 underline">/sv/security/sub-processors</a>. Specifika compliance-frågor? Skriv till
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
