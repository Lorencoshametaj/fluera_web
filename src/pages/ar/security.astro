---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "التشفير",
    body: "على جهازك، قاعدة البيانات التي تحفظ لوحاتك مشفّرة أثناء التخزين بـ sqlite3mc ‏(ChaCha20-Poly1305، مفتاح 256 بت)؛ أما الصور وملفات PDF وصوت المحاضرات فهي ملفات في مجلد التطبيق الخاص، يحميها نظام التشغيل. ملف .fluera المُصدَّر غير مشفّر؛ والنسخة الاحتياطية المشفّرة مختومة بـ AES-256-GCM. تمرّ حركة البيانات عبر TLS. المزامنة السحابية ليست مشفّرة من طرف إلى طرف: اللوحات المتزامنة محفوظة على بنية تحتية في الاتحاد الأوروبي (Supabase،‏ eu-north-1)، مشفّرة أثناء النقل وأثناء التخزين على مستوى البنية التحتية. وبصفتنا المتحكّم في البيانات يمكننا تقنياً الوصول إلى المحتوى المتزامن — لكننا لا نبيعه أبداً ولا نستخدمه للإعلانات.",
  },
  {
    title: "ملكية البيانات",
    body: "كل بايت تكتبه قابل للتصدير بنقرة واحدة: PNG وJPEG وWebP وSVG وPDF وصيغة .fluera. تعيش لوحاتك أولاً على أجهزتك. السحابة راحة لا سجن — والاحتجاز نموذج عمل اخترنا رفضه.",
  },
  {
    title: "متوافق مع GDPR",
    body: "Fluera مستضافة في الاتّحاد الأوروبي ومتوافقة مع GDPR من البداية. اتفاقية معالجة بيانات متاحة عند الطلب لأيّ مؤسّسة تعليمية. تصدير كامل للبيانات وحقّ النسيان، مُحترَمَين خلال 30 يومًا (عادة خلال 48 ساعة).",
  },
  {
    title: "محلّي أوّلًا، دائمًا",
    body: "يمكنك استخدام Fluera دون اتصال تماماً. المزامنة بين أجهزتك مطفأة إلى أن تشغّلها، وتسري على حسابك كله. ومع إطفاء المزامنة تبقى لوحاتك على الجهاز. أما ما عدا ذلك فلا يغادره إلا كما يصفه دليل «الخصوصية وموافقة الذكاء الاصطناعي»، مفتاحاً مفتاحاً: القياس عن بُعد مثلاً بموافقتك فقط، مرتبطاً بحسابك ودون أي محتوى.",
  },
  {
    title: "ما لا نفعله",
    body: "لن نعرض إعلانات. لن نبيع بياناتك. لا ندرّب نماذج على لوحاتك إلا إذا اخترت ذلك: بيانات تدريب الذكاء الاصطناعي مطفأة إلى أن تشغّلها. لن نتتبّعك عبر الويب. لن نسلّم بيانات لأطراف ثالثة غير المعالجين الفرعيين المسمّين (المدرجين في صفحة المعالجين الفرعيين) — وجميعهم بموجب اتفاقية معالجة بيانات.",
  },
];
---

<BaseLayout
  title="الأمان والخصوصية"
  description="قاعدة بيانات محلية مشفّرة، GDPR افتراضياً، خوادم في أوروبا، بلا تقنيات إعلانية. بنية الأمان في Fluera والتزامها بملكيتك لبياناتك."
  locale="ar"
>
  <PageHero
    kicker="الأمان والخصوصية"
    title="مشفّر محليًا.<br />ومزامنة سحابية بشرح صريح."
    titleSize="2xl"
    description="تشفير افتراضي. صفر تتبّع إعلاني. استضافة في الاتّحاد الأوروبي. تصدير كامل. الخصوصية قيد تصميم، لا مهمّة التزام."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">الإفصاح المسؤول</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">وجدت شيئًا؟</h2>
          <p class="prose-ink mb-6">
            الباحثون الأمنيون مرحَّب بهم هنا. أبلغ عن الثغرات إلى <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. نردّ خلال 5 أيام عمل. لا يوجد برنامج مكافآت للثغرات.
          </p>
          <p class="text-sm text-ink-500 italic">
            قواعد الإبلاغ منشورة أيضاً في ‎/.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">الالتزام والنشر</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">تنشر Fluera في مؤسّستك؟</h2>
          <p class="prose-ink mb-6">
            الجامعات والمدارس ومختبرات الأبحاث: نُحدّثكم عن اتفاقية معالجة البيانات وقائمة المعالجين الفرعيين. تبدأ التجارب عادة بفصل واحد لفصل دراسي واحد دون رسوم.
          </p>
          <a href="/ar/contact" class="btn-primary">تحدّث إلينا عن النشر ←</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        تُغطّي هذه الصفحة الأساسيات. البنية الكاملة وسجلّ المعالجين الفرعيين موجودان على
        <a href="/ar/security/architecture" class="text-paper-300 underline">/ar/security/architecture</a> و
        <a href="/ar/security/sub-processors" class="text-paper-300 underline">/ar/security/sub-processors</a>. أسئلة التزام محدّدة؟
        راسل <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
