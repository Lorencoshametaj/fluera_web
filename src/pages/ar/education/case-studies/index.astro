---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout
  title="دراسات حالة تعليمية"
  description="لم نُجرِ أي برنامج تجريبي بعد. تبقى هذه الصفحة فارغة حتى يستوفي أحدها ثلاثة شروط كتبناها مسبقاً."
  locale="ar"
>

  <PageHero
    kicker="دراسات الحالة"
    title="لا توجد دراسات حالة بعد.<br />هذه هي الإجابة الصادقة."
    description="لم نُجرِ أي برنامج تجريبي بعد. وبدل ملء هذه الصفحة بما يبدو دليلاً وليس كذلك، هذه هي الشروط الثلاثة التي يجب أن يستوفيها أي برنامج تجريبي قبل أن يظهر هنا أي شيء — مكتوبة مسبقاً كي تُحاسبونا عليها."
    breadcrumb={{ label: "التعليم", href: "/ar/education" }}
  />

  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-site max-w-4xl">
      <div class="grid md:grid-cols-3 gap-4">
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">فصل دراسي كامل</h2>
          <p class="text-sm text-paper-300">
            ليس عرضاً توضيحياً ولا تجربة من أسبوعين. تستخدم دفعة كاملة Fluera طوال فصل دراسي بامتحاناته، قبل أن نكتب عنه سطراً واحداً.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">موافقة عضو هيئة التدريس</h2>
          <p class="text-sm text-paper-300">
            يقرأ الأستاذ ما كتبناه ويوافق عليه قبل النشر. وإن اختلف مع قراءتنا لفصله، لا يُنشَر.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">أرقام مجهّلة ومُدقّقة</h2>
          <p class="text-sm text-paper-300">
            مجمّعة ومجهّلة الهوية ومراجَعة للتأكد من دقتها. لا حكايات ننتقيها نحن، ولا اقتباسات بلا سياقها الكامل.
          </p>
        </article>
      </div>

      <div class="mt-12 p-6 rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.05] max-w-3xl">
        <h2 class="font-serif text-xl text-paper-50 mb-2">أتريد أن تكون الأول؟</h2>
        <p class="text-sm text-paper-200 mb-4 leading-relaxed">
          نُجري برنامجاً تجريبياً واحداً كل فصل — صف واحد، فصل واحد، بلا مقابل. وفي المقابل نطلب ملاحظات منظّمة وخيار نشر دراسة حالة مجهّلة في النهاية، وفق الشروط الثلاثة أعلاه.
        </p>
        <a href="/contact/sales" class="btn-primary">لنتحدّث عن برنامج تجريبي →</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-500 max-w-xl mx-auto">
        لماذا هذه الصفحة فارغة؟ لأن جمع دراسة حالة بأرقام حقيقية بنزاهة يستغرق وقتاً — ونشر «دراسات حالة» تسويقية مبنية على حكايات ينتقيها المزوّد هو بالضبط نوع المحتوى الذي لا نريد إنتاجه. الصفحة الفارغة هي النسخة الوحيدة من هذه الصفحة التي نستطيع الدفاع عنها.
      </p>
    </div>
  </section>

</BaseLayout>
