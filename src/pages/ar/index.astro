---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/ar";
import pricing from "@/data/pricing/ar";
import copy from "@/data/homeCopy/ar";

const description = "لوحة واحدة للتعلّم، لا تطبيق ملاحظات. تحوّل Fluera ملاحظاتك المكتوبة بخط اليد إلى خريطة حية لدراستك وتعيد اختبارك قبل أن تخذلك الذاكرة.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/ar/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="ar">
  <PremiumHome locale="ar" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
