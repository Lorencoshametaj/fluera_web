---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CatalogueMark from "@/components/CatalogueMark.astro";

// ─────────────────────────────────────────────────────────────────────────────
// Every claim on this page was checked against the shipped source (app, engine,
// Supabase migrations, edge functions) — not against the design docs, which
// describe intent rather than behaviour. Two rules the copy must keep obeying:
//
//   1. No numbers about the catalog or its usage. The catalog is new; any
//      install/creator/template count would be a vanity claim.
//   2. No retention PERCENTAGE. The ranking signal is shipped, but the on-device
//      baseline currently subtracts a superseded forgetting curve
//      (mastery_checkpoint_service.dart:161 uses exp(-N/1.5) while retrievability
//      is measured with the FSRS-6 power curve), so the magnitude is not yet
//      quotable. Describing the ORDERING is fine; publishing a number is not.
//
// See also: the creator terms for publishing are still an unreviewed draft, so this
// page must not link to them or imply that open publishing is a finished product.
// ─────────────────────────────────────────────────────────────────────────────

const whatItCarries = [
  {
    title: "ورقة عمل داخل إطار",
    body: "ليست دفترًا كاملًا، بل منطقة أطّرها صاحبها على لوحته. ما داخل الإطار من خطوط وأشكال ونصّ مكتوب وصور ينتقل، وما خارجه لا ينتقل. ولا يُرفَق بها ملفّ PDF مصدري.",
  },
  {
    title: "هيكل المفاهيم",
    body: "البنية القائمة تحت الحبر: ما المفاهيم، وإلى أيّ موضوع ينتمي كلّ مفهوم، وعلى أيّها يتوقّف. بهذا يُعلّمك القالب بدل أن يُقرأ فحسب.",
  },
  {
    title: "وصفة بطاقات من الصفر",
    body: "ليست ذاكرة المؤلّف، بل وصفة تبني بها ذاكرتك أنت: الاحتفاظ المرغوب، ونوع المادّة، وموعد المراجعة الأولى. ومنها يُبنى جدولك لحظة التثبيت.",
  },
];

const install = [
  {
    step: "01",
    title: "الصفحة تصل حبرًا",
    body: "تُستعاد ورقة العمل في لوحة تخصّك. كتابةُ يدٍ حقيقية على ورق حقيقي، وليست ملفَّ PDF مُصيَّرًا: تكتب فوقها، وتمدّها، وتقطّعها كما تشاء.",
  },
  {
    step: "02",
    title: "كلّ مفهوم يصير بطاقة",
    body: "لكلّ مفهوم مُسمّى بطاقةُ تكرار متباعد جديدة تمامًا، بلا سجلّ مراجعة خلفها: عددُ تكراراتها صفر، وصعوبتها الأوّليّة في منتصف نطاق Fluera. وتحلّ المراجعة الأولى بعد يوم واحد.",
  },
  {
    step: "03",
    title: "من هنا يصير الجدول جدولك",
    body: "يُحفَظ على القرص، ويغذّي شارة الاستحقاق وملخّصك اليومي مثل أيّ شيء كتبته بيدك. وإن أعدت تثبيت القالب نفسه، لن يُمحى سجلّ مراجعةٍ بنيته من قبل.",
  },
];

const ranking = [
  {
    label: "القياس يجري على جهازك",
    body: "حين تعيد فتح لوحة قالبٍ في اليوم 1 و7 و30 أو بعده، تسأل Fluera نموذجَ التكرار المتباعد كم بقي عندك من تلك المفاهيم بعينها، ثمّ تشتقّ من جوابه رقمًا واحدًا.",
  },
  {
    label: "رقم واحد، لا شيء سواه",
    body: "ذلك الرقم وحده هو ما يُرسَل: لا عناوين مفاهيم، ولا محتوى بطاقات، ولا سجلّ مراجعة، ولا هويّة. ولا يُرسَل إلّا إن كنت مسجَّل الدخول ووافقت على التحليلات، ولا يُرسَل أبدًا إن كان القالب قالبك أنت.",
  },
  {
    label: "صامت دون خمسة متعلّمين",
    body: "لا رقم عامّ للقالب إطلاقًا حتى يساهم فيه خمسة متعلّمين مختلفين على الأقلّ. وتحت هذه العتبة يعود الترتيب إلى عدد التثبيتات، وتصمت البطاقة.",
  },
  {
    label: "التحميل ليس ترتيبًا",
    body: "تُرتَّب شبكة «كلّ القوالب» افتراضيًّا بتلك الإشارة المقيسة، لا بالشعبية. والانتشار السريع لا يشتري للقالب مكانًا في أعلاها.",
  },
];

const cardMarks = [
  { mark: "رسمي", body: "يضعه الكتالوج وحده، لا ما يكتبه مؤلّف في نموذج. ولا يُنال بتهجئته في اسم العرض." },
  { mark: "جديد", body: "يُستحَقّ بصرامة: بلا تثبيتات، وبلا تقييمات، ونُشر خلال الأسبوع الماضي. وينطفئ من تلقاء نفسه، لا بيد أحد." },
  { mark: "المادّة", body: "المادّة التي صُنّف فيها القالب، لتميّز بنظرة واحدة صفحةَ كيمياء ممّا يجاور الكيمياء." },
  { mark: "التقييم", body: "لا يظهر إلّا بعد أن يُقيَّم القالب فعلًا، وممّن ثبّتوه دون سواهم. والقالب غير المُقيَّم يصمت بدل أن يبدأ من صفر." },
];

const privacy = [
  {
    title: "نموذجك بوصفك متعلّمًا ليس في الملفّ",
    body: "المكوّن الذي يبني الهيكل العامّ للقالب لا يقرأ — بنيةً لا اختيارًا — سجلّ مراجعتك، ولا ثقتك، ولا كم مرّة درست شيئًا، ولا مدى تمسّكك به، ولا التضمينات وراءه. لو نشر خبيرٌ ومتعثّرٌ الصفحة نفسها، لخرج الهيكلان متطابقين بايتًا ببايت.",
  },
  {
    title: "اختبارٌ يحرس الخطّ الفاصل داخل الـCI",
    body: "يُثبّت هذا الضمانَ اختبارٌ يمرّ على المُخرَج المُسلسَل ويفشل إن ظهر فيه، في أيّ موضع، اسمٌ من ستّة وعشرين حقلًا من حقول نموذج المتعلّم أو سلوكه. وهو في الـCI بوّابةٌ مُسمّاة لا تُتخطّى، وتفشل أيضًا إن حُذف ملفّ الاختبار.",
  },
  {
    title: "الحبر حدٌّ لا نُخفيه",
    body: "ما لا يبلغه أيّ تنقية هو الكتابة اليدوية نفسها. والهيكل يحمل فعلًا مقتطفًا قصيرًا من النصّ المتعرَّف عليه — ليس النصّ كاملًا، وليس محجوبًا أيضًا. لهذا تعرض ورقةُ النشر الصورةَ الدقيقة التي ستصير عامّة، فوق مربّع موافقة، قبل أن يُرفع أيّ شيء.",
  },
  {
    title: "اسمك لا يصير مُعرِّفًا",
    body: "لا تُرجع القراءات العامّة معرّف حسابٍ إطلاقًا، ويُعرَف المُنشئ برمزٍ مشتقّ من حسابه باتّجاه واحد: مُملَّح، مُجزَّأ، مقتطع. اسمٌ مستعار ثابت، لا هويّة.",
  },
];

const safety = [
  {
    label: "لا شيء يُدرَج بمجرّد الإرسال",
    body: "يُسجَّل القالب الجديد في حالة «بانتظار المراجعة». وإلى أن يُفحص، لا يظهر في التصفّح ولا في البحث ولا في الكتالوج أصلًا، ورابط مشاركته لا يؤدّي إلى شيء.",
  },
  {
    label: "الفحص يقرأ الملفّ نفسه",
    body: "يستخرج المُصنِّف الصور المضمّنة في القالب بدل أن يثق بالصورة المصغّرة التي رفعها صاحبه، ويأخذ أسوأ حكمٍ فيها، ويعمل داخل مناطق الاتّحاد الأوروبي. يستطيع أن يمرّر عنصرًا أو يصعّده؛ ولا يستطيع أبدًا أن ينقض قرار مشرف.",
  },
  {
    label: "البلاغ يصل إلى بشر، لا إلى آلة",
    body: "البلاغ إشارة تدخل طابورًا بشريًّا: بلاغ واحد لكلّ مُبلِّغ، ولا بلاغ لصاحب القالب على قالبه. تستطيع مجموعةٌ منسّقة أن تلفت الانتباه. ولا تستطيع أن تُسقط إدراجًا.",
  },
  {
    label: "الإزالة تُزيل البايتات",
    body: "حين يُزال إدراج، تُحفَظ الأدلّة أوّلًا في حاوية خاصّة لا يبلغها إلّا المسؤولون، ثمّ تُمحى الكائنات المنشورة من الـCDN محوًا، لا شطبًا من القائمة فحسب.",
  },
  {
    label: "القرار يأتي ومعه سببه",
    body: "يُبلَّغ المُنشئ بما جرى لقالبه، وهل كان القرار آليًّا، وله أن يتظلّم. والتظلّم إن نجح أعاد الإدراج.",
  },
  {
    label: "التقييم يُستحَقّ",
    body: "لا يمكنك أن تقيّم قالبًا لم تثبّته، ولا قالبك أنت، ولا أن تقيّم وأنت مجهول. وتُحسَب المتوسّطات من جديد في كلّ مرّة، لا تُراكَم زيادةً بعد زيادة.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "كتالوج Fluera",
  description:
    "كتالوج قوالب دراسة بخطّ اليد، تُثبَّت فتصير جداول تكرار متباعد، ويرتّبها ما احتفظ به المتعلّمون لا عدد التحميلات.",
  isPartOf: { "@type": "WebSite", name: "Fluera", url: "https://fluera.dev" },
  inLanguage: "ar",
};
---

<BaseLayout
  title="الكتالوج — قوالب دراسة تُثبَّت في الذاكرة، لا في مجلّد"
  description="قالب الدراسة صفحة بخطّ اليد، وتحتها بنية مفاهيمها. ثبّته فيزرع جدولَ مراجعةٍ خاصًّا بك. والترتيب بما احتفظ به المتعلّمون، لا بما انتشر."
  ogImage="/og/page/catalogue.png"
  jsonLd={jsonLd}
  locale="ar"
>
  <PageHero
    kicker="الكتالوج"
    title="سبقك غيرك إلى هذا الفصل.<br />ثبّت صفحته، ودَعْها تمتحنك."
    titleSize="2xl"
    description="قالب الدراسة في Fluera ليس ملفّ PDF ولا رزمة بطاقات. صفحةٌ بخطّ يد حقيقي، وبنية المفاهيم القائمة تحتها، ووصفةٌ لجدول المراجعة الذي ينبغي أن تسير عليه. ثبّته فيزرع ذلك الجدول في لوحة من لوحاتك."
    orbs
    noise
  >
    <CatalogueMark slot="mark" size={30} class="mb-4" />
    <div slot="copy" class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/ar/beta" class="btn-primary">اطلب وصولًا مبكرًا ←</a>
      <a href="/ar/features/spaced-repetition" class="btn-secondary">كيف يُبنى جدول المراجعة</a>
    </div>
  </PageHero>

  <!-- WHAT A TEMPLATE IS -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="الوحدة"
        title="ثلاثةٌ تنتقل إليك. والرابع يبقى عند صاحبه."
        sub="المتاجر الأخرى كلّها ترسل إليك مستندًا وتتمنّى لك التوفيق. أمّا قالب الدراسة فيحمل الصفحة، والبنيةَ التي تجعلها قادرة على تعليمك، وتعليماتِ جدولتها — ويترك عمدًا الجزء الذي يخصّ من صنعها وحده."
      />

      <div class="grid md:grid-cols-3 gap-6">
        {whatItCarries.map((c, i) => (
          <article class="card p-7">
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="font-serif text-xl text-paper-50 mb-3">{c.title}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT INSTALLING DOES -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <p class="eyebrow mb-6 text-accent-glow">التثبيت</p>
          <h2 class="font-serif text-display-xl text-paper-50 mb-6">
            أن تملك ملفًّا شيء،<br />وأن تكون على موعدٍ شيء آخر.
          </h2>
          <p class="prose-ink mb-4">
            تحميل المادّة لم يكن يومًا هو الصعب. الصعب أن تعود إليها في اليوم الذي كنت ستنساها فيه، وهذا ما لم يحلّه مجلّدٌ قطّ.
          </p>
          <p class="prose-ink">
            لذلك لا ينتهي التثبيت بمستندٍ في مكان ما، بل يزرع بطاقات لها مواعيد. ترث مفاهيم المؤلّف والبنية التي تربط بينها، ولا ترث سجلّ مراجعته ولا ثقته ولا مدى إتقانه هو لأيّ منها. وصيغة القالب لا تحمل شيئًا من ذلك أصلًا.
          </p>
        </div>

        <ol class="space-y-4 list-none p-0 m-0">
          {install.map((s) => (
            <li class="card p-7">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-xs tracking-widest text-ink-500 shrink-0">{s.step}</span>
                <div>
                  <h3 class="font-serif text-lg text-paper-50 mb-2">{s.title}</h3>
                  <p class="text-sm text-paper-300 leading-relaxed">{s.body}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- RANKING -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="الترتيب"
        title="الترتيب بما بقي في الرؤوس،<br />لا بما انتشر بين الأيدي."
        sub="يقيس عدد التحميلات قرارًا اتُّخذ قبل أن يتعلّم أحدٌ شيئًا، وهو أسهل رقم يُنفَخ في أيّ متجر. تستطيع Fluera أن ترتّب بما هو أفضل من ذلك، لأنّ التطبيق يُنمذج أصلًا مدى تمسّك كلّ متعلّم بكلّ مفهوم."
      />

      <div class="grid sm:grid-cols-2 gap-4 max-w-5xl">
        {ranking.map((r) => (
          <article class="card p-7">
            <h3 class="font-serif text-lg text-paper-50 mb-3">{r.label}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{r.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 max-w-3xl rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
        <p class="text-sm text-paper-300 leading-relaxed">
          <strong class="text-paper-100">ما لا ندّعيه.</strong> هذا تقديرُ نموذجٍ لما بقي من مفاهيم القالب عند من عادوا إلى الدراسة؛ ليس نتيجة امتحان، ولا مجموعة ضابطة، ولا قولًا في شأن من ثبّت قالبًا ثمّ لم يفتحه. ونحن نفضّل وصف الإشارة كما هي على تزيينها.
        </p>
      </div>
    </div>
  </section>

  <!-- DISCOVERY -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <SectionHeader
        kicker="العثور على قالب"
        title="ثلاث طرق تضيّق بها البحث،<br />وطريقةٌ لا يملكها إلّا جهازك."
        sub="تفشل كتالوجات موادّ الدراسة فشلًا واحدًا بعينه: كلّ ما فيها عن مادّتك بالاسم، وقلَّ ما فيها عن مقرّرك أنت. لذلك جاءت المرشِّحات هنا كما يفكّر فيها الطلّاب فعلًا."
      />

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <p class="prose-ink mb-4">
            ضيّق النتائج بحسب <strong class="text-paper-100">المادّة</strong>، أو بحسب <strong class="text-paper-100">المقرّر أو الامتحان</strong> — نصّ حرّ، فـ<em>Maturità</em> و<em>MCAT</em> صالحان تمامًا مثل <em>التحليل الرياضي 1</em> — أو بحسب <strong class="text-paper-100">اللغة</strong>. لكلّ مرشِّح عدّاد حيّ، وكلّ اختيار يعيد استعلام ما بقي، والمرشِّح الذي لا شيء خلفه لا يظهر أصلًا. فلن يُعرض عليك خيارٌ يفضي إلى صفحة فارغة.
          </p>
          <p class="prose-ink mb-4">
            يُفتَح الكتالوج بلغة تطبيقك، لأنّ جدارًا من موادّ لا تقرؤها ليس كتالوجًا. وهو تفضيل لا سياج: نقرة واحدة تفتحه على اللغات كلّها.
          </p>
          <p class="prose-ink">
            يشمل البحث النصّ كلّه ويتسامح مع الحركات والهمزات. وهو يُسقط ذلك الترتيب ويرتّب بالصلة مكانه — فمن كتب ما يريد، لم يعد سؤاله ما احتفظ به غيره.
          </p>
        </div>

        <div class="card p-8">
          <h3 class="eyebrow text-accent-glow mb-5">ما الذي تعنيه علامات البطاقة</h3>
          <dl class="space-y-4 m-0">
            {cardMarks.map((m) => (
              <div>
                <dt class="font-serif text-base text-paper-50 mb-1">{m.mark}</dt>
                <dd class="text-sm text-paper-300 leading-relaxed m-0">{m.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="mt-10 max-w-3xl rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.08] p-6">
        <p class="text-sm text-paper-200 leading-relaxed">
          <strong class="text-paper-50">وثمّة ترتيبٌ لا يقدر على بنائه سواها.</strong> تعرف Fluera ما المفاهيم التي تعمل عليها، لأنّك أنت من كتبها بيدك. فتستطيع أن ترتّب القوالب بمقدار تقاطعها مع ما على لوحتك الآن — والحساب كلّه يجري على جهازك. أمّا ما يغادر هاتفك فهو المادّة التي تدرسها أكثر من غيرها، ومعرّفات القوالب التي سبق أن جلبها. ومجموعةُ مفاهيمك ليست منها.
        </p>
      </div>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="ما ينتقل وما لا ينتقل"
        title="انشر الصفحة، لا حالَك وأنت تتعلّمها."
