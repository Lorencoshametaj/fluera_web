---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/da";
import pricing from "@/data/pricing/da";
import copy from "@/data/homeCopy/da";

const description = "Et canvas til at lære, ikke en note-app. Fluera gør dine håndskrevne noter til et levende kort over din uddannelse og spørger dig igen, før hukommelsen svigter.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/da/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="da">
  <PremiumHome locale="da" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
