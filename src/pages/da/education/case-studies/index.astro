---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout
  title="Casestudier for uddannelse"
  description="Vi har endnu ikke kørt et pilotprojekt. Denne side står tom, indtil ét opfylder tre betingelser, vi har skrevet ned på forhånd."
  locale="da"
>

  <PageHero
    kicker="Casestudier"
    title="Ingen casestudier endnu.<br />Det er det ærlige svar."
    description="Vi har endnu ikke kørt et pilotprojekt. I stedet for at fylde denne side med noget, der ligner dokumentation uden at være det, står her de tre betingelser, et pilotprojekt skal opfylde, før noget som helst vises her — skrevet ned på forhånd, så du kan holde os fast på dem."
    breadcrumb={{ label: "Uddannelse", href: "/da/education" }}
  />

  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-site max-w-4xl">
      <div class="grid md:grid-cols-3 gap-4">
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Et helt semester</h2>
          <p class="text-sm text-paper-300">
            Ikke en demo, ikke to ugers prøve. Et hold bruger Fluera et helt semester, eksamener inklusive, før vi skriver en linje om det.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Underviserens godkendelse</h2>
          <p class="text-sm text-paper-300">
            Underviseren læser det, vi har skrevet, og godkender det, før det går online. Er hun uenig i vores læsning af semestret, bliver det ikke udgivet.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Tal, anonymiserede og efterprøvede</h2>
          <p class="text-sm text-paper-300">
            Aggregerede, anonymiserede og kontrolleret for korrekthed. Ingen leverandørvalgte anekdoter, ingen citater uden hele konteksten.
          </p>
        </article>
      </div>

      <div class="mt-12 p-6 rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.05] max-w-3xl">
        <h2 class="font-serif text-xl text-paper-50 mb-2">Vil du være den første?</h2>
        <p class="text-sm text-paper-200 mb-4 leading-relaxed">
          Vi kører ét pilotprojekt pr. semester — ét hold, ét semester, gratis. Til gengæld beder vi om struktureret feedback og muligheden for at udgive et anonymiseret casestudie til sidst, under de tre betingelser ovenfor.
        </p>
        <a href="/contact/sales" class="btn-primary">Tal om et pilotprojekt →</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-500 max-w-xl mx-auto">
        Hvorfor er denne side tom? Fordi et casestudie med rigtige tal tager tid at indsamle ærligt — og at udgive «casestudier» af marketingkvalitet baseret på leverandørvalgte anekdoter er præcis den genre indhold, vi ikke vil producere. En tom side er den version af denne side, vi kan forsvare.
      </p>
    </div>
  </section>

</BaseLayout>
