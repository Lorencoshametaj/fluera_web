---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Database, autentificering, cloud-storage, realtime-signaling, AI-proxy Edge Functions.",
    dataTypes: "Konto-e-mail, hashet bruger-ID, synkroniseret canvas-indhold (krypteret undervejs via TLS og i hvile på EU-infrastruktur — ikke ende-til-ende-krypteret; tilgængeligt for Fluera som dataansvarlig, aldrig solgt og aldrig brugt til annoncering), synkroniseringsmetadata.",
    region: "Stockholm, EU (eu-north-1) — produktion. Dublin, EU (eu-west-1) — staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (Gemini-modeller) til Socratic Mode, Ghost Map, LaTeX-OCR og generering af Exam Sessions.",
    dataTypes: "Udvalgt canvas-indhold, som kun indsendes, når AI-funktionerne er samtykket til og anvendes — tekstuddrag og gengivne PNG-billeder af enkelte håndskriftsklynge-områder. Aldrig hele notesbogen.",
    region: "Kun Den Europæiske Union — europe-west4 (Nederlandene) primært, europe-west1 (Belgien) failover. Ingen overførsel af canvas-indhold uden for EU til AI-inferens.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "Google LLC",
    purpose: "Autentificering med Sign in with Google (identitetsudbyder).",
    dataTypes: "Google-kontoens e-mail og konto-identifikator. Ingen canvas-data.",
    region: "USA; SCC + EU-US DPF.",
    privacy: "https://policies.google.com/privacy",
  },
  {
    name: "Apple Inc.",
    purpose: "Autentificering Sign in with Apple; in-app-køb på iOS og macOS via App Store.",
    dataTypes: "Apple-ID-relæ-e-mail, kvitteringsidentifikatorer. Ingen canvas-data.",
    region: "USA; SCC + EU-US DPF.",
    privacy: "https://www.apple.com/legal/privacy/",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Administration af abonnementer og validering af kvitteringer på iOS, Android og web.",
    dataTypes: "Anonymiseret bruger-ID i RevenueCat, abonnementsstatus, kvitterings-metadata. Ingen kortdata.",
    region: "USA; SCC + EU-US DPF.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Crash-rapportering og fejl-monitoring.",
    dataTypes: "Stack-traces, OS-version, enhedsmodel, app-version. sendDefaultPii er eksplicit deaktiveret, og IP-adresser gemmes ikke — intet brugerindhold.",
    region: "Den Europæiske Union (Frankfurt) — produktions-DSN'en ingesterer i Sentrys europæiske dataregion. Databehandlerens juridiske enhed er registreret i USA; SCC + EU-US DPF.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hosting af share.fluera.dev: webkataloget, kortenes sider, anmeldelsesformularen og connectoren til AI-assistenten.",
    dataTypes: "IP-adresse og anmodningsdata fra besøgende (tekniske logs). Anmeldelser sendt via formularen passerer her på vej til Supabase. Ingen cookies.",
    region: "Global edge; virksomhed med hjemsted i USA. DPA indarbejdet i Deno Deploys vilkår; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-09-29";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "Selve fluera.dev hostes på GitHub Pages. GitHub Inc. er ikke en underdatabehandler: GitHub registrerer de tekniske data om besøg (IP-adresse, tidspunkt, side) for at beskytte sin egen tjeneste, som selvstændig dataansvarlig efter sin egen privatlivserklæring. Det samme gælder de skrifttyper, som share.fluera.dev henter fra fluera.dev.";
---

<BaseLayout
  title="Underdatabehandlere"
  description="De tredjeparter, Fluera er afhængig af for at levere produktet. Formål, delte data, region og link til hver underdatabehandlers privatlivserklæring."
  locale="da"
>
  <PageHero
    kicker="Underdatabehandlere"
    title="Hver tredjepart, vi læner os op ad."
    description="I henhold til GDPR Art. 28 er hver underdatabehandler, der behandler persondata på vores vegne, anført her — hvad vi deler, hvorfor, og hvor det bor. Vi underretter kunderne før enhver ændring."
    breadcrumb={{ label: "Sikkerhed", href: "/da/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Senest opdateret: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Privatlivserklæring ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Formål</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Delte data</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Region</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHubs privatlivserklæring ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Ændringer og underretninger</h2>
      <p class="prose-ink text-sm mb-4">
        Vi opdaterer denne liste, så snart en underdatabehandler tilføjes, ændres eller fjernes. Institutionelle og enterprise-kunder modtager en e-mail-underretning mindst 30 dage før ændringen, i henhold til GDPR Art. 28 stk. 2.
      </p>
      <p class="prose-ink text-sm">
        For at tilmelde dig underretninger om ændringer i underdatabehandlere, skriv til <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> fra e-mail-adressen på din konto.
      </p>
    </div>
  </section>
</BaseLayout>
