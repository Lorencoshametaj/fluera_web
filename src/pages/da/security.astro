---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Kryptering",
    body: "På din enhed er databasen med dine canvasser krypteret i hvile med sqlite3mc (ChaCha20-Poly1305, 256-bit nøgle); fotos, PDF'er og lyd fra forelæsninger er filer i appens private mappe, beskyttet af styresystemet. En eksporteret .fluera-fil er ikke krypteret; den Krypterede sikkerhedskopi er forseglet med AES-256-GCM. Trafikken går over TLS. Cloud sync er ikke end-to-end-krypteret: synkroniserede canvasser ligger på EU-infrastruktur (Supabase, eu-north-1), krypteret under overførsel og i hvile på infrastrukturniveau. Som dataansvarlig kan vi teknisk tilgå synkroniseret indhold — men vi sælger det aldrig og bruger det aldrig til reklame.",
  },
  {
    title: "Ejerskab over dine data",
    body: "Hver byte, du skriver, kan eksporteres med ét klik: PNG, JPEG, WebP, SVG, PDF og vores .fluera-format. Dine canvasser lever først på dine enheder. Skyen er en bekvemmelighed, ikke et fængsel — lock-in er en forretningsmodel, vi har fravalgt.",
  },
  {
    title: "GDPR fra fabrikken",
    body: "Fluera hostes på servere i Europa og er bygget efter GDPR-principperne. En databehandleraftale er tilgængelig for enhver uddannelsesinstitution på anmodning. Fuld dataeksport og retten til at blive glemt opfyldes inden for 30 dage (typisk inden for 48 timer).",
  },
  {
    title: "Local-first, altid",
    body: "Du kan bruge Fluera helt offline. Synkronisering mellem dine enheder er slået fra, indtil du slår den til, og den gælder hele din konto. Med sync slået fra bliver dine canvasser på enheden. Alt andet forlader den kun som beskrevet, kontakt for kontakt, i guiden Privatliv og AI-samtykke: telemetri for eksempel kun med dit samtykke, knyttet til din konto og aldrig med indhold.",
  },
  {
    title: "Hvad vi ikke gør",
    body: "Vi viser ikke reklamer. Vi sælger ikke dine data. Vi træner ikke modeller på dine canvasser, medmindre du vælger det: AI-træningsdata er slået fra, indtil du slår det til. Vi sporer dig ikke på nettet. Vi giver ikke data til tredjeparter ud over navngivne underdatabehandlere (listet på siden Underdatabehandlere) — alle under databehandleraftale.",
  },
];
---

<BaseLayout
  title="Sikkerhed og privatliv"
  description="Krypteret lokal database, GDPR fra fabrikken, servere i Europa, nul ad-tech. Flueras sikkerhedsarkitektur og løftet om, at dine data er dine."
  locale="da"
>
  <PageHero
    kicker="Sikkerhed og privatliv"
    title="Kryptering fra fabrikken.<br />Dine data bliver hos dig."
    titleSize="2xl"
    description="Kryptering fra fabrikken. Ingen ad-tech. Servere i Europa. Fuld eksport. Privatliv er en designbegrænsning, ikke en compliance-opgave."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Fundet noget?</h2>
          <p class="prose-ink mb-6">
            Sikkerhedsforskere er velkomne her. Rapportér sårbarheder til <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Vi svarer inden for 5 arbejdsdage. Der er intet bug bounty-program.
          </p>
          <p class="text-sm text-ink-500 italic">
            Reglerne for rapporter er også offentliggjort i /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance og deployment</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Planlagt udrulning på en institution?</h2>
          <p class="prose-ink mb-6">
            Universiteter, skoler, forskningslabs: vi kan tage dig igennem DPA og listen over underdatabehandlere. Pilotprogrammer starter typisk med ét kursus, ét semester, uden omkostninger.
          </p>
          <a href="/da/contact" class="btn-primary">Tal om deployment →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Denne side dækker det væsentlige. Den fulde arkitektur og registret over underdatabehandlere ligger på
        <a href="/da/security/architecture" class="text-paper-300 underline">/da/security/architecture</a> og
        <a href="/da/security/sub-processors" class="text-paper-300 underline">/da/security/sub-processors</a>. Specifikke compliance-spørgsmål? Skriv til
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
