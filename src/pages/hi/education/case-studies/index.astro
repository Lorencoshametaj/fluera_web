---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout
  title="शिक्षा केस स्टडी"
  description="हमने अभी तक कोई पायलट नहीं चलाया। पहले से लिखी तीन शर्तें पूरी होने तक यह पेज खाली रहेगा।"
  locale="hi"
>

  <PageHero
    kicker="केस स्टडी"
    title="अभी कोई केस स्टडी नहीं।<br />यही ईमानदार जवाब है।"
    description="हमने अभी तक कोई पायलट नहीं चलाया। इस पेज को ऐसी चीज़ से भरने के बजाय जो प्रमाण जैसी दिखे पर हो नहीं, यहाँ वे तीन शर्तें हैं जो किसी भी चीज़ के यहाँ छपने से पहले पायलट को पूरी करनी होंगी — पहले से लिखी हुई, ताकि आप हमसे इनका हिसाब माँग सकें।"
    breadcrumb={{ label: "संस्थान", href: "/hi/education" }}
  />

  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-site max-w-4xl">
      <div class="grid md:grid-cols-3 gap-4">
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">पूरा एक सेमेस्टर</h2>
          <p class="text-sm text-paper-300">
            न डेमो, न दो हफ़्ते का ट्रायल। एक कक्षा परीक्षाओं सहित पूरे सेमेस्टर Fluera इस्तेमाल करे, तभी हम एक पंक्ति लिखेंगे।
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">शिक्षक की स्वीकृति</h2>
          <p class="text-sm text-paper-300">
            शिक्षक हमारा लिखा पढ़ते हैं और छपने से पहले स्वीकृति देते हैं। यदि वे हमारी व्याख्या से असहमत हों, तो हम प्रकाशित नहीं करते।
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">गुमनाम और जाँचे गए आँकड़े</h2>
          <p class="text-sm text-paper-300">
            समेकित, गुमनाम और सटीकता के लिए जाँचे गए। हमारे चुने हुए क़िस्से नहीं, बिना संदर्भ के उद्धरण नहीं।
          </p>
        </article>
      </div>

      <div class="mt-12 p-6 rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.05] max-w-3xl">
        <h2 class="font-serif text-xl text-paper-50 mb-2">पहले बनना चाहेंगे?</h2>
        <p class="text-sm text-paper-200 mb-4 leading-relaxed">
          हम प्रति सेमेस्टर एक पायलट चलाते हैं — एक कक्षा, एक सेमेस्टर, नि:शुल्क। बदले में हम संरचित प्रतिक्रिया और ऊपर की तीन शर्तों के तहत अंत में एक गुमनाम केस स्टडी छापने का विकल्प माँगते हैं।
        </p>
        <a href="/contact/sales" class="btn-primary">पायलट पर बात करें →</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-500 max-w-xl mx-auto">
        यह पेज खाली क्यों है? क्योंकि असली आँकड़ों वाली केस स्टडी ईमानदारी से जुटाने में समय लगता है — और विक्रेता के चुने हुए क़िस्सों पर टिकी मार्केटिंग-स्तर की «केस स्टडी» ठीक वही विधा है जो हम बनाना नहीं चाहते। खाली पेज ही इस पेज का वह रूप है जिसका हम बचाव कर सकते हैं।
      </p>
    </div>
  </section>

</BaseLayout>
