  },
  {
    label: "रेटिंग कमानी पड़ती है",
    body: "जो टेम्पलेट आपने कभी इंस्टॉल नहीं किया, उसे आप रेट नहीं कर सकते; अपना ख़ुद का नहीं कर सकते; और गुमनाम रहकर नहीं कर सकते। औसत में थोड़ा-थोड़ा जोड़ा नहीं जाता, हर बार पूरा दोबारा निकाला जाता है।",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Fluera कैटलॉग",
  description:
    "हाथ से लिखे अध्ययन टेम्पलेट का कैटलॉग, जो अंतराल-पुनरावृत्ति के कार्यक्रम बनकर इंस्टॉल होते हैं — और जिनका क्रम डाउनलोड से नहीं, इससे बनता है कि याद कितना रह गया।",
  isPartOf: { "@type": "WebSite", name: "Fluera", url: "https://fluera.dev" },
  inLanguage: "hi",
};
---

<BaseLayout
  title="कैटलॉग — अध्ययन टेम्पलेट, जो आपकी याददाश्त में इंस्टॉल होते हैं"
  description="अध्ययन टेम्पलेट: हाथ से लिखा पन्ना और नीचे अवधारणाओं की संरचना। इंस्टॉल करें, दोहराव का कार्यक्रम अपने आप बनता है। क्रम डाउनलोड से नहीं, याद कितना रहा उससे।"
  ogImage="/og/page/catalogue.png"
  jsonLd={jsonLd}
  locale="hi"
>
  <PageHero
    kicker="कैटलॉग"
    title="यह अध्याय किसी ने पहले ही सुलझा लिया है।<br />इंस्टॉल करें — कल से यह आपको परखेगा।"
    titleSize="2xl"
    description="Fluera का अध्ययन टेम्पलेट न PDF है, न फ़्लैशकार्ड का ढेर। यह हाथ से लिखा एक पन्ना है, उसके नीचे खड़ी अवधारणाओं की संरचना, और उस दोहराव-कार्यक्रम का नुस्ख़ा जिस पर आपको चलना चाहिए। इंस्टॉल करते ही वह कार्यक्रम आपके अपने कैनवास में बो दिया जाता है।"
    orbs
    noise
  >
    <CatalogueMark slot="mark" size={30} class="mb-4" />
    <div slot="copy" class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/hi/beta" class="btn-primary">शुरुआती एक्सेस का अनुरोध करें →</a>
      <a href="/hi/features/spaced-repetition" class="btn-secondary">दोहराव का कार्यक्रम कैसे बनता है</a>
    </div>
  </PageHero>

  <!-- WHAT A TEMPLATE IS -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="इकाई"
        title="तीन चीज़ें साथ जाती हैं। लेखक उनमें नहीं है।"
        sub="बाक़ी हर स्टोर आपको एक दस्तावेज़ थमाता है, और आगे आपकी क़िस्मत। अध्ययन टेम्पलेट पन्ना ले जाता है, वह संरचना ले जाता है जो पन्ने को सिखाने लायक बनाती है, और उसे कार्यक्रम में बांधने के निर्देश ले जाता है — और जानबूझकर वह हिस्सा नहीं ले जाता जो उसे बनाने वाले का अपना है।"
      />

      <div class="grid md:grid-cols-3 gap-6">
        {whatItCarries.map((c, i) => (
          <article class="card p-7">
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="font-serif text-xl text-paper-50 mb-3">{c.title}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT INSTALLING DOES -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <p class="eyebrow mb-6 text-accent-glow">इंस्टॉल करना</p>
          <h2 class="font-serif text-display-xl text-paper-50 mb-6">
            फ़ाइल आपके पास आती है।<br />और कार्यक्रम आपके नाम चल पड़ता है।
          </h2>
