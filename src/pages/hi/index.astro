---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/hi";
import pricing from "@/data/pricing/hi";
import copy from "@/data/homeCopy/hi";

const description = "सीखने के लिए एक कैनवास, नोट्स ऐप नहीं। Fluera आपके हाथ से लिखे नोट्स को आपकी डिग्री के जीवंत मानचित्र में बदलता है और याददाश्त कमज़ोर पड़ने से पहले आपसे दोबारा पूछता है।";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/hi/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="hi">
  <PremiumHome locale="hi" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
