---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";
---

<BaseLayout
  title="सुरक्षा वास्तुकला"
  description="Fluera आपके canvas को at-rest और ट्रांज़िट में कैसे एन्क्रिप्ट करता है, और क्लाउड सिंक कैसे काम करता है। sqlite3mc, TLS, EU इंफ्रास्ट्रक्चर पर सिंक, opt-in टेलीमेट्री।"
  locale="hi"
>
  <PageHero
    kicker="वास्तुकला"
    title="Fluera आपके canvas को कैसे सुरक्षित रखता है।"
    description={`यह पृष्ठ सुरक्षा मॉडल को उस स्तर पर वर्णित करता है जिसकी एक तकनीकी पाठक — सुरक्षा अधिकारी, विश्वविद्यालय CISO, जिज्ञासु डेवलपर — अपेक्षा करता है। गैर-तकनीकी सारांश के लिए, <a href="/hi/security">/hi/security</a> से शुरू करें।`}
    breadcrumb={{ label: "सुरक्षा", href: "/hi/security" }}
  />

  <article class="py-16 md:py-20 border-b border-white/[0.04]">
    <div class="container-prose prose-v2">

      <h2>खतरा मॉडल</h2>
      <p>
        हम डिवाइस चोरी, नेटवर्क अवरोधन, और बैकअप या क्लाउड सिंक के माध्यम से आकस्मिक एक्सपोज़र मानते हैं। हम मानते हैं कि उपयोगकर्ता क्रेडेंशियल समझौता हो सकते हैं। हम <em>नहीं</em> मानते कि अनलॉक डिवाइसों तक भौतिक पहुंच वाले राज्य-स्तरीय विरोधी — Fluera गोपनीयता उपकरण नहीं है, यह अध्ययन उपकरण है।
      </p>
      <p>उस मॉडल के भीतर, तीन गारंटी:</p>
      <ul>
        <li><strong>लोकल डेटाबेस चाबी के बिना पढ़ा नहीं जा सकता।</strong> चोरी हुए डिवाइस से सिर्फ़ एन्क्रिप्टेड डेटाबेस मिलता है। फ़ोटो, PDF और लेक्चर का ऑडियो ऑपरेटिंग सिस्टम सुरक्षित रखता है, वह चाबी नहीं।</li>
        <li><strong>सिंक किया गया डेटा पारगमन में (TLS) और EU अवसंरचना (Supabase, eu-north-1) पर विश्राम पर एन्क्रिप्टेड है।</strong> यह एंड-टू-एंड एन्क्रिप्टेड नहीं है — डेटा नियंत्रक के रूप में Fluera इस तक तकनीकी रूप से पहुंच सकता है, लेकिन हम इसे कभी बेचते नहीं और न ही विज्ञापन के लिए उपयोग करते हैं।</li>
        <li><strong>टेलीमेट्री सिर्फ़ सहमति से होती है और उसमें कभी सामग्री नहीं होती।</strong> वह आपके अकाउंट की पहचान से जुड़ी है ताकि आप उसे देख और मिटा सकें: वह गुमनाम नहीं है।</li>
      </ul>

      <h2>At rest: sqlite3mc, 256-बिट चाबी</h2>
      <p>
        आपके canvas — स्ट्रोक, टेक्स्ट, फ़ॉर्मूले, आपकी पढ़ाई — रखने वाला लोकल SQLite डेटाबेस SQLite3 Multiple Ciphers (sqlite3mc) की ChaCha20-Poly1305 स्कीम से एन्क्रिप्टेड है: डेटाबेस का हर पेज एन्क्रिप्टेड और प्रमाणित होता है। फ़ोटो, PDF और लेक्चर का ऑडियो ऐप के निजी फ़ोल्डर में फ़ाइलों के रूप में रहते हैं: उन्हें ऑपरेटिंग सिस्टम सुरक्षित रखता है, यह चाबी नहीं।
      </p>
      <p>
        चाबी आपके डिवाइस पर बने 256 रैंडम बिट हैं, जो प्लेटफ़ॉर्म के सुरक्षित की-स्टोर में रखे जाते हैं — iOS/macOS पर Keychain, Android पर Keystore, Windows पर DPAPI, Linux पर libsecret। यह एक कच्ची चाबी है, आपके अकाउंट के पासवर्ड से नहीं बनती, और कभी Fluera के सर्वरों पर नहीं भेजी जाती। ताकि नया फ़ोन आपके canvas न छीने, चाबी की एक कॉपी सिस्टम के एन्क्रिप्टेड बैकअप में भी है: Android पर Block Store में, जो आपके Google अकाउंट में तभी सहेजी जाती है जब वह बैकअप स्क्रीन लॉक से end-to-end एन्क्रिप्टेड हो; iOS पर iCloud या Finder के एन्क्रिप्टेड बैकअप में।
      </p>

      <h2>ट्रांज़िट में: TLS</h2>
      <p>
        ऐप और हमारी सेवाओं — साइन-इन, सिंक, AI प्रॉक्सी — के बीच का ट्रैफ़िक HTTPS (TLS) पर चलता है।
      </p>

      <h2>डिवाइसों के बीच सिंक: अकाउंट के लिए एक स्विच</h2>
      <p>
        <em>अपने डिवाइसों के बीच सिंक करें</em> पूरे अकाउंट के लिए एक ही स्विच है (सेटिंग्स → डेटा और सिंक), जो तब तक बंद रहता है जब तक आप उसे चालू न करें, और इसके लिए Cloud प्लान चाहिए। आपके canvas Supabase (EU क्षेत्र, eu-north-1) पर रखे जाते हैं, ट्रांज़िट में TLS से और इंफ्रास्ट्रक्चर स्तर पर at-rest एन्क्रिप्टेड। सिंक end-to-end एन्क्रिप्टेड <em>नहीं</em> है: डेटा कंट्रोलर के रूप में Fluera तकनीकी रूप से सिंक हुई सामग्री तक पहुँच सकता है। हम उसे कभी नहीं बेचते और कभी विज्ञापन के लिए इस्तेमाल नहीं करते। अपवाद ब्राउज़र के मोड़ हैं: वे end-to-end एन्क्रिप्टेड होकर जाते हैं।
      </p>
      <p>
        एक canvas पर एक समय में एक ही डिवाइस से लिखा जाता है: बाकी डिवाइसों पर वह सिर्फ़ पढ़ने के लिए खुलता है, जब तक आप <em>यहाँ लिखें</em> न दबाएँ। अगर वही canvas बिना कनेक्शन के दो डिवाइसों पर बदला, तो कुछ भी ऊपर से नहीं लिखा जाता: जो काम कम है वह गैलरी में अलग canvas के रूप में रहता है, जिसे आप हाथ से मिला सकते हैं। पूरी गाइड: <a href="/hi/docs/cloud-sync">अपने डिवाइसों के बीच सिंक करें</a>।
      </p>
      <p>
        एक्सपोर्ट की गई <code>.fluera</code> फ़ाइल एन्क्रिप्टेड नहीं होती: उसे किसी भी दूसरी फ़ाइल की तरह संभालें। <em>एन्क्रिप्टेड बैकअप</em> कमांड इस डिवाइस के की-स्टोर में रखी चाबी से AES-256-GCM में सील की गई <code>.fluerabackup</code> फ़ाइल लिखती है; वह सिर्फ़ उसी डिवाइस पर खुलती है जिसके पास वह चाबी हो।
      </p>

      <h2>P2P सहयोग: सीधा, एन्क्रिप्टेड</h2>
      <p>
        रियल-टाइम सहयोग WebRTC DataChannels का इस्तेमाल करता है, जो DTLS से एन्क्रिप्टेड हैं। Supabase Realtime सिर्फ़ signalling broker का काम करता है — कनेक्शन बनाने के लिए — असली canvas ट्रैफ़िक का relay नहीं। handshake के बाद canvas के बदलाव peer-to-peer चलते हैं। सर्वर उन्हें नहीं देखता।
      </p>
      <p>
        कोई relay सर्वर नहीं है: सार्वजनिक STUN सर्वर (Google) सिर्फ़ दोनों डिवाइसों को एक-दूसरे को ढूँढने में मदद करते हैं। अगर कोई नेटवर्क सीधा कनेक्शन रोकता है, तो सेशन नहीं जुड़ता।
      </p>

      <h2>AI कॉल: प्रॉक्सी के माध्यम से, कभी सीधे नहीं</h2>
      <p>
        Google Gemini मॉडल (Socratic Mode, Ghost Map, LaTeX OCR, Exam Session) Google Vertex AI के माध्यम से सेव किए जाते हैं और EU में संसाधित होते हैं (europe-west4 NL / europe-west1 BE)। कॉल एक प्रॉक्सी के माध्यम से जाती हैं जो प्रमाणीकरण को सर्वर साइड पर रखती है; क्लाइंट डिवाइस कुंजी कभी नहीं देखते। प्रॉक्सी प्रति-योजना दर सीमाएं लागू करता है और लेखांकन के लिए कॉल अवधि लॉग करता है — कैनवास सामग्री कभी नहीं।
      </p>

      <h2>टेलीमेट्री: सहमति से, allowlist, बिना सामग्री</h2>
      <p>
        प्रोडक्ट एनालिटिक्स तब तक बंद रहते हैं जब तक आप सहमति न दें। चालू होने पर इवेंट सर्वर की allowlist तक सीमित रहते हैं (सेशन की शुरुआत और अंत, फ़ीचर का इस्तेमाल, अवधि और टोकन के साथ AI कॉल — कभी सामग्री नहीं)। उनमें एक रैंडम सेशन ID और आपके अकाउंट की पहचान होती है, ताकि आप अपनी टेलीमेट्री देख और मिटा सकें। क्रैश रिपोर्ट (Sentry, अलग सहमति) को उस पहचान का सिर्फ़ SHA-256 हैश मिलता है। सहमति वापस लेने पर आपके अकाउंट से इकट्ठा हुई टेलीमेट्री मिट जाती है; हर हाल में इवेंट ज़्यादा से ज़्यादा 180 दिन रखे जाते हैं।
      </p>

      <h2>डेटा रिकवरी</h2>
      <p>
        अगर आप फ़ोन बदलते हैं या दोबारा इंस्टॉल करके सिस्टम बैकअप रीस्टोर करते हैं, तो डेटाबेस और उसकी चाबी साथ लौटते हैं और आपके canvas वैसे ही खुलते हैं जैसे सिस्टम के आख़िरी बैकअप के समय थे। वे नहीं लौटते अगर सिस्टम बैकअप बंद है, Android पर Google Play services न हों या ऐप का डेटा बैकअप की 25 MB सीमा से ज़्यादा हो, अगर आप ऐप का डेटा साफ़ करें, या बिना रीस्टोर के अनइंस्टॉल करें। तब लोकल डेटाबेस पढ़ा नहीं जा सकता — न आप, न हम — और रिकवरी का रास्ता है «अपने डिवाइसों के बीच सिंक करें»: नए डिवाइस पर साइन इन करें और आपके सिंक हुए canvas लौट आते हैं। याद रखने या खोने के लिए कोई अलग सिंक पासफ़्रेज़ नहीं है।
      </p>

      <h2>जिम्मेदार प्रकटीकरण</h2>
      <p>
        सुरक्षा शोधकर्ताओं का स्वागत है। कमज़ोरियाँ <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a> पर रिपोर्ट करें। हम 5 कार्यदिवसों के भीतर जवाब देते हैं। कोई bug bounty कार्यक्रम नहीं है।
      </p>
      <p>
        दायरा: Fluera ऐप (सभी प्लेटफ़ॉर्म), सिंक सेवा, AI प्रॉक्सी, और यह मार्केटिंग साइट। दायरे से बाहर: तृतीय-पक्ष सेवाएं (Supabase, Google, Apple, Sentry, RevenueCat) — संबंधित विक्रेताओं को रिपोर्ट करें।
      </p>

      <h2>बाहरी आकलन</h2>
      <p>
        Fluera के पास वर्तमान में SOC 2 या ISO 27001 प्रमाणन नहीं है। ये एंटरप्राइज़ रोडमैप पर हैं और पूरा होने पर सार्वजनिक रूप से घोषित किए जाएंगे। हम उन नियंत्रणों को घोषित करना नहीं पसंद करते जिन्हें हमने स्वतंत्र रूप से सत्यापित नहीं किया है।
      </p>
      <p>
        <a href="/hi/security/sub-processors">सब-प्रोसेसर सूची</a> सार्वजनिक और अद्यतन है। डेटा प्रोसेसिंग समझौता <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> पर अनुरोध पर उपलब्ध है।
      </p>

    </div>
  </article>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/hi/security/sub-processors" class="btn-secondary">सब-प्रोसेसर →</a>
        <a href="/hi/contact" class="btn-primary">परिनियोजन के बारे में बात करें</a>
      </div>
    </div>
  </section>
</BaseLayout>
