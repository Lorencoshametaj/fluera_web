---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "डेटाबेस, प्रमाणीकरण, क्लाउड स्टोरेज, रियल-टाइम सहयोग, AI प्रॉक्सी Edge Functions।",
    dataTypes: "खाता ईमेल, हैश किया गया उपयोगकर्ता ID, सिंक की गई कैनवास सामग्री (ट्रांज़िट में TLS और EU इंफ्रास्ट्रक्चर पर at-rest एन्क्रिप्टेड; एंड-टू-एंड एन्क्रिप्टेड नहीं — डेटा नियंत्रक के रूप में Fluera इस तक पहुंच सकता है, लेकिन इसे कभी नहीं बेचता और न ही विज्ञापन के लिए उपयोग करता है), सिंक मेटाडेटा।",
    region: "स्टॉकहोम, EU (eu-north-1) — प्रोडक्शन। डबलिन, EU (eu-west-1) — स्टेजिंग।",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Socratic Mode, Ghost Map, LaTeX OCR और exam session निर्माण के लिए Vertex AI (Gemini मॉडल)।",
    dataTypes: "चयनित कैनवास सामग्री, जो केवल तभी भेजी जाती है जब AI सुविधाओं के लिए सहमति दी गई हो और उनका उपयोग किया गया हो — अलग-अलग हस्तलेखन-क्लस्टर क्षेत्रों के टेक्स्ट भाग और रेंडर की गई PNG छवियां। पूरी नोटबुक कभी नहीं। इसके अलावा, अवैध सामग्री की स्वचालित जांच के लिए, AI सुविधाओं की सहमति के बिना: कैटलॉग में अपलोड किए गए या निजी रूप से साझा किए गए कार्ड का थंबनेल, चित्र, शीर्षक और विवरण, तथा किसी क्रिएटर की प्रोफ़ाइल फ़ोटो।",
    region: "केवल यूरोपीय संघ — Vertex AI के EU एंडपॉइंट: europe-west4 (नीदरलैंड) और europe-west1 (बेल्जियम) क्षेत्र, या EU मल्टी-रीजन एंडपॉइंट, जिसे Google EU सदस्य देशों तक सीमित रखता है। AI अनुमान के लिए कैनवास सामग्री का EU के बाहर कोई स्थानांतरण नहीं।",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "App Store और Google Play (iOS, macOS, Android) से की गई खरीदारी के लिए सदस्यता प्रबंधन और रसीद सत्यापन।",
    dataTypes: "खाते की छद्मनामी ID (Fluera खाते की उपयोगकर्ता ID, या साइन इन से पहले RevenueCat की एक अनाम ID), सदस्यता स्थिति, रसीद मेटाडेटा। सदस्यता प्रबंधित करने के लिए iOS, macOS और Android पर ऐप शुरू होते ही भेजा जाता है। कोई भुगतान कार्ड डेटा नहीं।",
    region: "US; SCC।",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "क्रैश रिपोर्टिंग और त्रुटि निगरानी।",
    dataTypes: "स्टैक ट्रेस, OS संस्करण, डिवाइस मॉडल, ऐप संस्करण। sendDefaultPii स्पष्ट रूप से अक्षम है और IP पते संग्रहीत नहीं किए जाते — कोई उपयोगकर्ता सामग्री नहीं।",
    region: "यूरोपीय संघ (फ्रैंकफर्ट) — प्रोडक्शन DSN, Sentry के EU डेटा क्षेत्र में इंजेस्ट होता है। प्रोसेसर इकाई US में निगमित है; SCC।",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "share.fluera.dev की होस्टिंग: वेब कैटलॉग, कार्ड के पेज, रिपोर्ट फ़ॉर्म और AI असिस्टेंट कनेक्टर।",
    dataTypes: "विज़िटर्स का IP पता और अनुरोध डेटा (तकनीकी लॉग)। फ़ॉर्म से भेजी गई रिपोर्ट यहीं से होकर Supabase तक पहुँचती हैं। कोई कुकी नहीं।",
    region: "ग्लोबल एज; अमेरिका में स्थित कंपनी। Deno Deploy की शर्तों में शामिल DPA; SCC।",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "fluera.dev स्वयं GitHub Pages पर होस्ट है। GitHub Inc. सब-प्रोसेसर नहीं है: यह अपनी सेवा की सुरक्षा के लिए विज़िट का तकनीकी डेटा (IP पता, समय, पेज) दर्ज करता है, एक स्वतंत्र नियंत्रक के रूप में और अपने गोपनीयता कथन के अनुसार। यही बात उन फ़ॉन्ट पर भी लागू होती है जिन्हें share.fluera.dev, fluera.dev से लोड करता है।";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "Apple और Google भी सब-प्रोसेसर नहीं हैं। Sign in with Apple, Sign in with Google और App Store व Google Play से खरीदारी में वे अपने प्लेटफ़ॉर्म के डेटा के लिए स्वतंत्र नियंत्रक के रूप में काम करते हैं, अपनी शर्तों और गोपनीयता नीतियों के अनुसार।";
---

<BaseLayout
  title="सब-प्रोसेसर"
  description="वे तृतीय पक्ष जिन पर Fluera उत्पाद वितरित करने के लिए निर्भर है। प्रत्येक सब-प्रोसेसर के लिए उद्देश्य, साझा डेटा, क्षेत्र, और गोपनीयता नीति लिंक।"
  locale="hi"
>
  <PageHero
    kicker="सब-प्रोसेसर"
    title="हर तृतीय पक्ष जिस पर हम निर्भर हैं।"
    description="GDPR अनुच्छेद 28 के अनुसार, हमारी ओर से व्यक्तिगत डेटा संसाधित करने वाला प्रत्येक सब-प्रोसेसर यहां सूचीबद्ध है — हम क्या साझा करते हैं, क्यों, और यह कहां रहता है। हम हर परिवर्तन से पहले ग्राहकों को सूचित करते हैं।"
    breadcrumb={{ label: "सुरक्षा", href: "/hi/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">अंतिम अपडेट: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  गोपनीयता नीति ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">उद्देश्य</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">साझा डेटा</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">क्षेत्र</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub का गोपनीयता कथन ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Apple की गोपनीयता नीति ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Google की गोपनीयता नीति ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">परिवर्तन और सूचनाएं</h2>
      <p class="prose-ink text-sm mb-4">
        जब भी कोई सब-प्रोसेसर जोड़ा, बदला या हटाया जाता है हम इस सूची को अपडेट करते हैं। GDPR अनुच्छेद 28(2) के अनुसार, संस्थागत और एंटरप्राइज़ ग्राहकों को परिवर्तन से कम से कम 30 दिन पहले ईमेल अधिसूचना मिलती है।
      </p>
      <p class="prose-ink text-sm">
        सब-प्रोसेसर परिवर्तन सूचनाओं की सदस्यता लेने के लिए, अपने खाता पते से <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> पर लिखें।
      </p>
    </div>
  </section>
</BaseLayout>
