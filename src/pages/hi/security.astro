---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "एन्क्रिप्शन",
    body: "आपके डिवाइस पर, आपके canvas रखने वाला डेटाबेस sqlite3mc (ChaCha20-Poly1305, 256-बिट चाबी) से at-rest एन्क्रिप्टेड है; फ़ोटो, PDF और लेक्चर का ऑडियो ऐप के निजी फ़ोल्डर में फ़ाइलें हैं, जिन्हें ऑपरेटिंग सिस्टम सुरक्षित रखता है। एक्सपोर्ट की गई .fluera फ़ाइल एन्क्रिप्टेड नहीं होती; एन्क्रिप्टेड बैकअप AES-256-GCM से सील होता है। ट्रैफ़िक TLS पर चलता है। क्लाउड सिंक end-to-end एन्क्रिप्टेड नहीं है: सिंक हुए canvas EU इंफ्रास्ट्रक्चर (Supabase, eu-north-1) पर रखे जाते हैं, ट्रांज़िट में और इंफ्रास्ट्रक्चर स्तर पर at-rest एन्क्रिप्टेड। डेटा कंट्रोलर के रूप में हम तकनीकी रूप से सिंक हुई सामग्री तक पहुँच सकते हैं — पर हम उसे कभी नहीं बेचते और कभी विज्ञापन के लिए इस्तेमाल नहीं करते।",
  },
  {
    title: "डेटा स्वामित्व",
    body: "आप जो भी बाइट लिखते हैं, वह एक क्लिक में एक्सपोर्ट हो सकती है: PNG, JPEG, WebP, SVG, PDF और हमारा .fluera फ़ॉर्मेट। आपके canvas पहले आपके डिवाइसों पर रहते हैं। क्लाउड एक सुविधा है, जेल नहीं — lock-in एक बिज़नेस मॉडल है जिसे हमने ठुकराया।",
  },
  {
    title: "GDPR मूल",
    body: "Fluera EU-होस्टेड और GDPR-मूल है। किसी भी शैक्षणिक संस्थान को अनुरोध पर डेटा प्रोसेसिंग समझौता उपलब्ध है। पूर्ण डेटा निर्यात और भूले जाने का अधिकार 30 दिनों के भीतर सम्मानित किया जाता है (आमतौर पर 48 घंटों के भीतर)।",
  },
  {
    title: "लोकल-फर्स्ट, हमेशा",
    body: "आप Fluera पूरी तरह ऑफ़लाइन चला सकते हैं। आपके डिवाइसों के बीच सिंक तब तक बंद रहता है जब तक आप उसे चालू न करें, और वह पूरे अकाउंट पर लागू होता है। सिंक बंद हो तो आपके canvas डिवाइस पर रहते हैं। बाकी सब कुछ डिवाइस से सिर्फ़ वैसे ही निकलता है जैसा गाइड «गोपनीयता और AI consent» में हर स्विच के लिए लिखा है: टेलीमेट्री, उदाहरण के लिए, सिर्फ़ आपकी सहमति से, आपके अकाउंट से जुड़ी और कभी सामग्री के साथ नहीं।",
  },
  {
    title: "हम क्या नहीं करते",
    body: "हम विज्ञापन नहीं दिखाएँगे। हम आपका डेटा नहीं बेचेंगे। जब तक आप ख़ुद न चुनें, हम आपके canvas पर मॉडल ट्रेन नहीं करते: AI प्रशिक्षण डेटा तब तक बंद है जब तक आप उसे चालू न करें। हम वेब पर आपको ट्रैक नहीं करेंगे। नामित sub-processors (Sub-processors पेज पर सूचीबद्ध) के अलावा किसी तीसरे पक्ष को डेटा नहीं देंगे — सभी DPA के तहत।",
  },
];
---

<BaseLayout
  title="सुरक्षा और गोपनीयता"
  description="एन्क्रिप्टेड लोकल डेटाबेस, शुरू से GDPR, यूरोप में सर्वर, कोई ad-tech नहीं। Fluera की सुरक्षा वास्तुकला और आपके डेटा पर आपके स्वामित्व का वादा।"
  locale="hi"
>
  <PageHero
    kicker="सुरक्षा और गोपनीयता"
    title="विश्राम और पारगमन में एन्क्रिप्टेड।<br />EU में सर्वर।"
    titleSize="2xl"
    description="डिफ़ॉल्ट रूप से एन्क्रिप्शन। कोई विज्ञापन-तकनीक नहीं। EU-होस्टेड। पूर्ण निर्यात। गोपनीयता एक डिज़ाइन बाधा है, अनुपालन कार्य नहीं।"
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">जिम्मेदार प्रकटीकरण</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">कुछ मिला?</h2>
          <p class="prose-ink mb-6">
            सुरक्षा शोधकर्ताओं का स्वागत है। कमज़ोरियाँ <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a> पर रिपोर्ट करें। हम 5 कार्यदिवसों के भीतर जवाब देते हैं। कोई bug bounty कार्यक्रम नहीं है।
          </p>
          <p class="text-sm text-ink-500 italic">
            रिपोर्ट करने के नियम /.well-known/security.txt (RFC 9116) में भी प्रकाशित हैं।
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">अनुपालन और परिनियोजन</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">अपने संस्थान में Fluera तैनात कर रहे हैं?</h2>
          <p class="prose-ink mb-6">
            विश्वविद्यालय, स्कूल और अनुसंधान प्रयोगशालाएं: हम आपको हमारे DPA और उप-प्रोसेसर सूची के बारे में बताते हैं। पायलट आमतौर पर एक कक्षा, एक सेमेस्टर, बिना शुल्क के शुरू होते हैं।
          </p>
          <a href="/hi/contact" class="btn-primary">परिनियोजन के बारे में हमसे बात करें →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        यह पृष्ठ आवश्यकताओं को कवर करता है। पूरी वास्तुकला और उप-प्रोसेसर रजिस्टर
        <a href="/hi/security/architecture" class="text-paper-300 underline">/hi/security/architecture</a> और
        <a href="/hi/security/sub-processors" class="text-paper-300 underline">/hi/security/sub-processors</a> पर रहते हैं। विशिष्ट अनुपालन प्रश्न?
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a> पर लिखें।
      </p>
    </div>
  </section>
</BaseLayout>
