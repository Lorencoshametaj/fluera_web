---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "暗号化",
    body: "デバイス上では、キャンバスを収めたデータベースが sqlite3mc（ChaCha20-Poly1305、256ビット鍵）で保存時暗号化されます。写真、PDF、講義の音声はアプリ専用フォルダ内のファイルで、OS によって保護されます。書き出した .fluera ファイルは暗号化されません。暗号化バックアップは AES-256-GCM で封印されます。通信は TLS で行われます。クラウド同期はエンドツーエンド暗号化ではありません。同期されたキャンバスは EU のインフラ（Supabase、eu-north-1）に保存され、転送時とインフラレベルの保存時に暗号化されます。データ管理者として、私たちは技術的には同期されたコンテンツにアクセスできますが、販売することも広告に使うことも決してありません。",
  },
  {
    title: "データの所有権",
    body: "あなたが書いたすべてのバイトはワンクリックで書き出せます: PNG、JPEG、WebP、SVG、PDF、そして .fluera 形式。キャンバスはまずあなたのデバイスにあります。クラウドは便利さであって牢獄ではありません — ロックインは私たちが選ばなかったビジネスモデルです。",
  },
  {
    title: "GDPR準拠デフォルト",
    body: "Fluera はヨーロッパのサーバーでホストされ、GDPR の原則に基づいて設計されています。Data Processing Agreement は、教育機関であればご請求に応じて提供します。データの完全エクスポートと忘れられる権利は、最大30日以内 (通常48時間以内) に対応します。",
  },
  {
    title: "ローカルファースト、常に",
    body: "Fluera は完全にオフラインで使えます。デバイス間の同期はあなたがオンにするまでオフで、アカウント全体に適用されます。同期がオフなら、キャンバスはデバイスに残ります。それ以外のものは、ガイド「プライバシーとAI同意」にスイッチごとに書かれているとおりにだけデバイスを出ます。たとえばテレメトリは、あなたの同意がある場合だけで、アカウントに結びつき、コンテンツは含みません。",
  },
  {
    title: "私たちがしないこと",
    body: "広告は出しません。データを販売しません。あなたが選ばない限り、キャンバスでモデルを学習させません: AIの学習データはあなたがオンにするまでオフです。ウェブ上であなたを追跡しません。名前を挙げたサブプロセッサ（サブプロセッサのページに掲載）以外の第三者にデータを渡しません — すべて DPA のもとで。",
  },
];
---

<BaseLayout
  title="セキュリティとプライバシー"
  description="暗号化されたローカルデータベース、GDPR準拠、EU のサーバー、アドテクなし。Fluera のセキュリティアーキテクチャとデータ所有に関する約束。"
  locale="ja"
>
  <PageHero
    kicker="セキュリティとプライバシー"
    title="ローカルでは強固に暗号化。<br />クラウド同期も正直に説明。"
    titleSize="2xl"
    description="暗号化はデフォルト。アドテックなし。ヨーロッパのサーバー。完全エクスポート。プライバシーは設計上の制約であり、コンプライアンスのタスクではありません。"
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">何か見つけましたか?</h2>
          <p class="prose-ink mb-6">
            セキュリティ研究者の方を歓迎します。脆弱性は <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a> までご報告ください。5営業日以内に返信します。バグ報奨金プログラムはありません。
          </p>
          <p class="text-sm text-ink-500 italic">
            報告のルールは /.well-known/security.txt（RFC 9116）にも掲載しています。
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">コンプライアンスと展開</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">教育機関で Fluera を導入予定ですか?</h2>
          <p class="prose-ink mb-6">
            大学、学校、研究機関: DPA とサブプロセッサ一覧についてご案内します。パイロットは通常、1クラス・1学期・無料で始まります。
          </p>
          <a href="/ja/contact" class="btn-primary">導入について相談する →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        このページは要点のみをカバーしています。完全なアーキテクチャとサブプロセッサのレジストリは
        <a href="/ja/security/architecture" class="text-paper-300 underline">/ja/security/architecture</a> および
        <a href="/ja/security/sub-processors" class="text-paper-300 underline">/ja/security/sub-processors</a> にあります。コンプライアンスに関する具体的な質問は
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a> までどうぞ。
      </p>
    </div>
  </section>
</BaseLayout>
