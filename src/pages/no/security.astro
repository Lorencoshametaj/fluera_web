---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Kryptering",
    body: "På enheten din er databasen med canvasene dine kryptert i ro med sqlite3mc (ChaCha20-Poly1305, 256-bits nøkkel); bilder, PDF-er og lyd fra forelesninger er filer i appens private mappe, beskyttet av operativsystemet. En eksportert .fluera-fil er ikke kryptert; den Krypterte sikkerhetskopien er forseglet med AES-256-GCM. Trafikken går over TLS. Cloud sync er ikke ende-til-ende-kryptert: synkroniserte canvaser lagres på EU-infrastruktur (Supabase, eu-north-1), kryptert under overføring og i ro på infrastrukturnivå. Som behandlingsansvarlig kan vi teknisk få tilgang til synkronisert innhold — men vi selger det aldri og bruker det aldri til reklame.",
  },
  {
    title: "Eierskap til dataene dine",
    body: "Hver byte du skriver kan eksporteres med ett klikk: PNG, JPEG, WebP, SVG, PDF og vårt .fluera-format. Canvasene dine lever først på enhetene dine. Skyen er en bekvemmelighet, ikke et fengsel — innlåsing er en forretningsmodell vi har valgt bort.",
  },
  {
    title: "GDPR fra start",
    body: "Fluera kjører på servere i Europa og er bygd etter GDPR-prinsippene. En Data Processing Agreement er tilgjengelig for hver utdanningsinstitusjon på forespørsel. Full dataeksport og rett til å bli glemt oppfylles innen 30 dager (vanligvis innen 48 timer).",
  },
  {
    title: "Local-first, alltid",
    body: "Du kan bruke Fluera helt uten nett. Synkronisering mellom enhetene dine er av til du slår den på, og den gjelder hele kontoen din. Med synk av blir canvasene dine på enheten. Alt annet forlater den bare slik veiledningen Personvern og AI-samtykke beskriver, bryter for bryter: telemetri for eksempel bare med samtykket ditt, knyttet til kontoen din og aldri med innhold.",
  },
  {
    title: "Det vi ikke gjør",
    body: "Vi viser ikke reklame. Vi selger ikke dataene dine. Vi trener ingen modeller på canvasene dine med mindre du velger det: Treningsdata for AI er av til du slår det på. Vi sporer deg ikke på nettet. Vi gir ikke data til tredjeparter utover navngitte underdatabehandlere (oppført på siden Underdatabehandlere) — alle under databehandleravtale.",
  },
];
---

<BaseLayout
  title="Sikkerhet og personvern"
  description="Kryptert lokal database, GDPR fra start, servere i Europa, null ad-tech. Flueras sikkerhetsarkitektur og løftet om at dataene dine er dine."
  locale="no"
>
  <PageHero
    kicker="Sikkerhet og personvern"
    title="Kryptert i hvile og under overføring.<br />Servere i EU."
    titleSize="2xl"
    description="Kryptering fra start. Ingen ad-tech. Servere i Europa. Full eksport. Personvern er en designbegrensning, ikke en compliance-oppgave."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Funnet noe?</h2>
          <p class="prose-ink mb-6">
            Sikkerhetsforskere er velkomne her. Rapporter sårbarheter til <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Vi svarer innen 5 virkedager. Det finnes ikke noe bug bounty-program.
          </p>
          <p class="text-sm text-ink-500 italic">
            Reglene for rapporter er også publisert i /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance og deployment</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Planlegger adopsjon på en institusjon?</h2>
          <p class="prose-ink mb-6">
            Universiteter, skoler, forskningslabber: vi kan ta deg gjennom DPA og listen over underleverandører. Pilotprogrammer starter som regel med ett emne, ett semester, kostnadsfritt.
          </p>
          <a href="/no/contact" class="btn-primary">Snakk om deployment →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Denne siden dekker det vesentlige. Hele arkitekturen og registeret over underleverandører ligger på
        <a href="/no/security/architecture" class="text-paper-300 underline">/no/security/architecture</a> og
        <a href="/no/security/sub-processors" class="text-paper-300 underline">/no/security/sub-processors</a>. Spesifikke compliance-spørsmål? Skriv til
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
