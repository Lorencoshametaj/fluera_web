---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/no";
import pricing from "@/data/pricing/no";
import copy from "@/data/homeCopy/no";

const description = "Et canvas for å lære, ikke en notat-app. Fluera gjør de håndskrevne notatene dine om til et levende kart over studiet og spør deg igjen før hukommelsen svikter.";
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/no/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
},
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Fluera",
    url: "https://fluera.dev/",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Fluera",
    url: "https://fluera.dev/",
    logo: "https://fluera.dev/press/logo-full.png",
    sameAs: ["https://github.com/Lorencoshametaj/fluera_engine"],
  },
];
---

<BaseLayout title="Fluera — den digitale notatboken som eksaminerer deg" description={description} jsonLd={jsonLd} locale="no">
  <PremiumHome locale="no" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
