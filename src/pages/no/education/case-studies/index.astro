---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout
  title="Casestudier for utdanning"
  description="Vi har ennå ikke kjørt et pilotprosjekt. Denne siden står tom til ett oppfyller tre betingelser vi skrev ned på forhånd."
  locale="no"
>

  <PageHero
    kicker="Casestudier"
    title="Ingen casestudier ennå.<br />Det er det ærlige svaret."
    description="Vi har ennå ikke kjørt et pilotprosjekt. I stedet for å fylle denne siden med noe som ligner dokumentasjon uten å være det, står her de tre betingelsene et pilotprosjekt må oppfylle før noe som helst vises her — skrevet ned på forhånd, så du kan holde oss til dem."
    breadcrumb={{ label: "Utdanning", href: "/no/education" }}
  />

  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-site max-w-4xl">
      <div class="grid md:grid-cols-3 gap-4">
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Et helt semester</h2>
          <p class="text-sm text-paper-300">
            Ikke en demo, ikke to ukers prøve. En klasse bruker Fluera et helt semester, eksamener inkludert, før vi skriver en linje om det.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Underviserens godkjenning</h2>
          <p class="text-sm text-paper-300">
            Underviseren leser det vi har skrevet og godkjenner det før det går ut. Er hun uenig i vår lesning av semesteret, blir det ikke publisert.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Tall, anonymisert og etterprøvd</h2>
          <p class="text-sm text-paper-300">
            Aggregert, anonymisert og kontrollert for riktighet. Ingen leverandørvalgte anekdoter, ingen sitater uten hele konteksten.
          </p>
        </article>
      </div>

      <div class="mt-12 p-6 rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.05] max-w-3xl">
        <h2 class="font-serif text-xl text-paper-50 mb-2">Vil du være den første?</h2>
        <p class="text-sm text-paper-200 mb-4 leading-relaxed">
          Vi kjører ett pilotprosjekt per semester — én klasse, ett semester, gratis. Til gjengjeld ber vi om strukturert tilbakemelding og muligheten til å publisere et anonymisert casestudie til slutt, under de tre betingelsene over.
        </p>
        <a href="/contact/sales" class="btn-primary">Snakk om et pilotprosjekt →</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-500 max-w-xl mx-auto">
        Hvorfor er denne siden tom? Fordi et casestudie med ekte tall tar tid å samle ærlig — og å publisere «casestudier» av markedsføringskvalitet basert på leverandørvalgte anekdoter er nøyaktig den sjangeren innhold vi ikke vil lage. En tom side er den versjonen av denne siden vi kan forsvare.
      </p>
    </div>
  </section>

</BaseLayout>
