---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Database, autentisering, sky-lagring, samarbeid i sanntid, AI-proxy Edge Functions.",
    dataTypes: "Konto-e-post, hashet bruker-ID, synkronisert canvas-innhold (kryptert under overføring med TLS og i ro på EU-infrastruktur — ikke ende-til-ende-kryptert; tilgjengelig for Fluera som behandlingsansvarlig, aldri solgt og aldri brukt til annonsering), synkroniseringsmetadata.",
    region: "Stockholm, EU (eu-north-1) — produksjon. Dublin, EU (eu-west-1) — staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (Gemini-modeller) for Socratic Mode, Ghost Map, LaTeX-OCR og generering av Exam Sessions.",
    dataTypes: "Utvalgt canvas-innhold som kun sendes inn når KI-funksjonene er samtykket til og i bruk — tekstutdrag og gjengitte PNG-bilder av enkelte håndskriftsklynge-områder. Aldri hele notatboken. Separat, for den automatiske kontrollen av ulovlig innhold og uten samtykke til KI-funksjonene: miniatyrbildet, bildene, tittelen og beskrivelsen av et kort du laster opp til katalogen eller deler privat, og profilbildet til en skaper.",
    region: "Kun Den europeiske union — EU-endepunkter i Vertex AI: regionene europe-west4 (Nederland) og europe-west1 (Belgia), eller EUs flerregion-endepunkt, som Google begrenser til EUs medlemsstater. Ingen overføring av canvas-innhold ut av EU for KI-inferens.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Administrasjon av abonnementer og validering av kvitteringer for kjøp via App Store og Google Play (iOS, macOS, Android).",
    dataTypes: "Pseudonym konto-ID (bruker-ID-en til Fluera-kontoen, eller en anonym RevenueCat-ID før innlogging), abonnementsstatus, kvitteringsmetadata. Sendes fra appen startes på iOS, macOS og Android, for å administrere abonnementet. Ingen kortdata.",
    region: "USA; SCC.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Crash-rapportering og feilovervåking.",
    dataTypes: "Stack traces, OS-versjon, enhetsmodell, app-versjon. sendDefaultPii er eksplisitt deaktivert og IP-adresser lagres ikke — ingen brukerinnhold.",
    region: "Den europeiske union (Frankfurt) — produksjons-DSN-en ingesterer i Sentrys europeiske dataregion. Databehandlerens juridiske enhet er registrert i USA; SCC.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hosting av share.fluera.dev: nettkatalogen, kortenes sider, varslingsskjemaet og koblingen til AI-assistenten.",
    dataTypes: "IP-adresse og forespørselsdata fra besøkende (tekniske logger). Varsler sendt via skjemaet går herfra videre til Supabase. Ingen informasjonskapsler.",
    region: "Global edge; selskap med hovedsete i USA. DPA innlemmet i vilkårene for Deno Deploy; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "Selve fluera.dev driftes på GitHub Pages. GitHub Inc. er ikke en underleverandør: GitHub registrerer tekniske data om besøk (IP-adresse, tidspunkt, side) for å sikre sin egen tjeneste, som selvstendig behandlingsansvarlig etter sin egen personvernerklæring. Det samme gjelder skrifttypene som share.fluera.dev henter fra fluera.dev.";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "Heller ikke Apple og Google er underleverandører. Ved Sign in with Apple, Sign in with Google og kjøp via App Store og Google Play opptrer de som selvstendige behandlingsansvarlige for dataene på sine egne plattformer, etter sine egne vilkår og personvernerklæringer.";
---

<BaseLayout
  title="Underleverandører"
  description="Tredjepartene Fluera støtter seg på for å levere produktet. Formål, delte data, region og lenke til personvernerklæringen for hver underleverandør."
  locale="no"
>
  <PageHero
    kicker="Underleverandører"
    title="Hver tredjepart vi støtter oss på."
    description="I tråd med GDPR art. 28 er hver underleverandør som behandler personopplysninger på våre vegne listet her — hva vi deler, hvorfor og hvor det bor. Vi varsler kundene før hver endring."
    breadcrumb={{ label: "Sikkerhet", href: "/no/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Sist oppdatert: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Personvernerklæring ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Formål</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Delte data</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Region</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHubs personvernerklæring ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Apples personvernerklæring ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Googles personvernerklæring ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Endringer og varsler</h2>
      <p class="prose-ink text-sm mb-4">
        Vi oppdaterer denne listen så snart en underleverandør legges til, endres eller fjernes. Institusjonelle og enterprise-kunder mottar en e-postvarsling minst 30 dager før endringen, i tråd med GDPR art. 28 nr. 2.
      </p>
      <p class="prose-ink text-sm">
        For å melde deg på varsler om underleverandør-endringer, skriv til <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> fra e-postadressen på kontoen din.
      </p>
    </div>
  </section>
</BaseLayout>
