---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Versleuteling",
    body: "Op je apparaat is de database met je canvassen in rust versleuteld met sqlite3mc (ChaCha20-Poly1305, sleutel van 256 bits); foto's, pdf's en audio van colleges zijn bestanden in de privémap van de app, beschermd door het besturingssysteem. Een geëxporteerd .fluera-bestand is niet versleuteld; de Versleutelde back-up is verzegeld met AES-256-GCM. Verkeer gaat via TLS. Cloud sync is niet end-to-end versleuteld: gesynchroniseerde canvassen staan op EU-infrastructuur (Supabase, eu-north-1), versleuteld tijdens transport en in rust op infrastructuurniveau. Als verwerkingsverantwoordelijke kunnen we technisch bij gesynchroniseerde inhoud — maar we verkopen die nooit en gebruiken die nooit voor advertenties.",
  },
  {
    title: "Eigenaarschap van data",
    body: "Elke byte die je schrijft is met één klik te exporteren: PNG, JPEG, WebP, SVG, PDF en ons .fluera-formaat. Je canvassen leven eerst op je apparaten. De cloud is een gemak, geen gevangenis — lock-in is een businessmodel waar we bewust tegen gekozen hebben.",
  },
  {
    title: "AVG vanaf de basis",
    body: "Fluera wordt gehost op servers in Europa en is ontworpen rond de principes van de AVG. Een verwerkersovereenkomst is op verzoek beschikbaar voor elke onderwijsinstelling. Volledige data-export en het recht om vergeten te worden worden binnen 30 dagen afgehandeld (meestal binnen 48 uur).",
  },
  {
    title: "Local-first, altijd",
    body: "Je kunt Fluera volledig offline gebruiken. Synchroniseren tussen je apparaten staat uit tot je het aanzet, en geldt voor je hele account. Met sync uit blijven je canvassen op het apparaat. De rest verlaat het alleen zoals de gids Privacy en AI-toestemming het schakelaar voor schakelaar beschrijft: telemetrie bijvoorbeeld alleen met je toestemming, gekoppeld aan je account en nooit met inhoud.",
  },
  {
    title: "Wat we niet doen",
    body: "We tonen geen advertenties. We verkopen je data niet. We trainen geen modellen op je canvassen, tenzij je daarvoor kiest: AI-trainingsdata staat uit tot je het aanzet. We volgen je niet over het web. We geven geen data aan derden buiten de genoemde subverwerkers (op de pagina Subverwerkers) — allemaal onder verwerkersovereenkomst.",
  },
];
---

<BaseLayout
  title="Beveiliging en privacy"
  description="Versleutelde lokale database, AVG vanaf de basis, servers in Europa, nul ad-tech. De beveiligingsarchitectuur van Fluera en de belofte over het eigendom van je data."
  locale="nl"
>
  <PageHero
    kicker="Beveiliging en privacy"
    title="Versleuteld in rust en onderweg.<br />Jouw data blijft van jou."
    titleSize="2xl"
    description="Versleuteling als standaard. Geen ad-tech. Servers in Europa. Volledige export. Privacy is een ontwerpbeperking, geen compliance-taakje."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Iets gevonden?</h2>
          <p class="prose-ink mb-6">
            Beveiligingsonderzoekers zijn hier welkom. Meld kwetsbaarheden bij <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. We antwoorden binnen 5 werkdagen. Er is geen bug-bountyprogramma.
          </p>
          <p class="text-sm text-ink-500 italic">
            De regels voor meldingen staan ook in /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance en uitrol</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Fluera in een instelling uitrollen?</h2>
          <p class="prose-ink mb-6">
            Universiteiten, scholen, onderzoekslabs: we kunnen je begeleiden bij de verwerkersovereenkomst en de lijst van subverwerkers. Pilots beginnen meestal met één klas, één semester, kosteloos.
          </p>
          <a href="/nl/contact" class="btn-primary">Praat over uitrol →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Deze pagina dekt het essentiële. De volledige architectuur en het register van subverwerkers staan op
        <a href="/nl/security/architecture" class="text-paper-300 underline">/nl/security/architecture</a> en
        <a href="/nl/security/sub-processors" class="text-paper-300 underline">/nl/security/sub-processors</a>. Specifieke compliance-vragen? Schrijf naar
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
