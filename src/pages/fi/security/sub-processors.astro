---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Tietokanta, autentikointi, pilvitallennus, Realtime-signalointi, tekoälyvälityksen Edge Functions -toiminnot.",
    dataTypes: "Tilin sähköposti, hashattu käyttäjä-ID, synkronoitu canvas-sisältö (salattu siirron aikana TLS:llä ja levossa EU-infrastruktuurissa — ei päästä päähän -salattu; Fluera pääsee siihen rekisterinpitäjänä käsiksi, mutta sitä ei koskaan myydä eikä käytetä mainontaan) sekä synkronoinnin metatiedot.",
    region: "Tukholma, EU (eu-north-1) — tuotanto. Dublin, EU (eu-west-1) — testiympäristö.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (Gemini-mallit) Socratic Modea, Ghost Mapia, LaTeX-OCR:ää ja Exam Sessionien generointia varten.",
    dataTypes: "Valittu canvas-sisältö, joka lähetetään vain silloin, kun tekoälyominaisuuksiin on annettu suostumus ja niitä käytetään — tekstiosuudet sekä yksittäisistä käsinkirjoitusklustereiden alueista renderöidyt PNG-kuvat. Ei koskaan koko muistikirjaa. Erikseen, laittoman sisällön automaattista tarkistusta varten ja ilman tekoälytoimintojen suostumusta: luetteloon lataamasi tai yksityisesti jakamasi kortin pikkukuva, kuvat, otsikko ja kuvaus sekä sisällöntuottajan profiilikuva.",
    region: "Vain Euroopan unioni — Vertex AI:n EU-päätepisteet: alueet europe-west4 (Alankomaat) ja europe-west1 (Belgia) tai EU:n monialueinen päätepiste, jonka Google rajaa EU:n jäsenvaltioihin. Canvas-sisältöä ei siirretä EU:n ulkopuolelle tekoälypäättelyä varten.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Tilausten hallinta ja App Storen ja Google Playn kautta tehtyjen ostojen kuittien validointi (iOS, macOS, Android).",
    dataTypes: "Tilin pseudonyymi tunniste (Fluera-tilin käyttäjä-ID tai ennen kirjautumista RevenueCatin anonyymi ID), tilauksen tila, kuitin metatiedot. Lähetetään sovelluksen käynnistyksestä alkaen iOS:ssä, macOS:ssä ja Androidissa tilauksen hallintaa varten. Ei korttidataa.",
    region: "USA; SCC:t.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Kaatumisraportointi ja virheiden valvonta.",
    dataTypes: "Stack-jäljet, käyttöjärjestelmäversio, laitemalli, sovellusversio. sendDefaultPii on nimenomaisesti pois päältä eikä IP-osoitteita tallenneta — ei käyttäjäsisältöä.",
    region: "Euroopan unioni (Frankfurt) — tuotannon DSN ohjaa datan Sentryn EU-data-alueelle. Käsittelijäyhtiö on rekisteröity Yhdysvalloissa; SCC:t.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "share.fluera.dev-palvelun ylläpito: verkkoluettelo, korttien sivut, ilmoituslomake ja tekoälyavustajan liitin.",
    dataTypes: "Kävijöiden IP-osoite ja pyyntötiedot (tekniset lokit). Lomakkeella lähetetyt ilmoitukset kulkevat tätä kautta Supabaseen. Ei evästeitä.",
    region: "Maailmanlaajuinen edge; yhtiön kotipaikka Yhdysvallat. DPA sisällytetty Deno Deployn ehtoihin; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "Itse fluera.dev on GitHub Pagesin ylläpitämä. GitHub Inc. ei ole alikäsittelijä: se tallentaa käyntien tekniset tiedot (IP-osoite, aika, sivu) oman palvelunsa suojaamiseksi, itsenäisenä rekisterinpitäjänä oman tietosuojaselosteensa mukaisesti. Sama koskee kirjasimia, jotka share.fluera.dev lataa fluera.dev-sivustolta.";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "Myöskään Apple ja Google eivät ole alikäsittelijöitä. Sign in with Applessa, Sign in with Googlessa sekä App Storen ja Google Playn ostoissa ne toimivat omien alustojensa tietojen itsenäisinä rekisterinpitäjinä omien ehtojensa ja tietosuojakäytäntöjensä mukaisesti.";
---

<BaseLayout
  title="Alikäsittelijät"
  description="Kolmannet osapuolet, joihin Fluera nojaa tuotteen toimittamiseksi. Jokaisen alikäsittelijän tarkoitus, jaettu data, alue ja linkki tietosuojaselosteeseen."
  locale="fi"
>
  <PageHero
    kicker="Alikäsittelijät"
    title="Jokainen kolmas osapuoli, johon nojaamme."
    description="GDPR:n 28 artiklan mukaisesti tässä on lueteltu jokainen alikäsittelijä, joka käsittelee henkilötietoja puolestamme — mitä jaamme, miksi ja missä se sijaitsee. Ilmoitamme asiakkaille ennen jokaista muutosta."
    breadcrumb={{ label: "Turvallisuus", href: "/fi/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Viimeksi päivitetty: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Tietosuojaseloste ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Tarkoitus</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Jaettu data</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Alue</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHubin tietosuojaseloste ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Applen tietosuojakäytäntö ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Googlen tietosuojakäytäntö ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Muutokset ja ilmoitukset</h2>
      <p class="prose-ink text-sm mb-4">
        Päivitämme tätä listaa heti, kun alikäsittelijä lisätään, vaihdetaan tai poistetaan. Institutionaaliset ja Enterprise-asiakkaat saavat sähköposti-ilmoituksen vähintään 30 päivää ennen muutosta, GDPR:n 28 artiklan 2 kohdan mukaisesti.
      </p>
      <p class="prose-ink text-sm">
        Tilataksesi alikäsittelijöiden muutosilmoitukset kirjoita osoitteeseen <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> tilisi sähköpostiosoitteesta.
      </p>
    </div>
  </section>
</BaseLayout>
