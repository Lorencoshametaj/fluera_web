---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Salaus",
    body: "Laitteellasi canvas-näkymäsi sisältävä tietokanta on salattu levossa sqlite3mc:llä (ChaCha20-Poly1305, 256-bittinen avain); kuvat, PDF:t ja luentojen ääni ovat tiedostoja sovelluksen yksityisessä kansiossa, käyttöjärjestelmän suojaamina. Viety .fluera-tiedosto ei ole salattu; Salattu varmuuskopio on sinetöity AES-256-GCM:llä. Liikenne kulkee TLS:llä. Cloud sync ei ole päästä päähän salattu: synkronoidut canvas-näkymät tallennetaan EU-infrastruktuuriin (Supabase, eu-north-1), salattuina siirrossa ja levossa infrastruktuurin tasolla. Rekisterinpitäjänä pystymme teknisesti pääsemään synkronoituun sisältöön — mutta emme koskaan myy sitä emmekä käytä sitä mainontaan.",
  },
  {
    title: "Datan omistajuus",
    body: "Jokaisen kirjoittamasi tavun voi viedä yhdellä napautuksella: PNG, JPEG, WebP, SVG, PDF ja .fluera-muotomme. Canvas-näkymäsi elävät ensin laitteillasi. Pilvi on mukavuus, ei vankila — lukitseminen on liiketoimintamalli, jonka päätimme hylätä.",
  },
  {
    title: "GDPR oletuksena",
    body: "Fluera on isännöity Euroopan palvelimilla ja suunniteltu GDPR:n periaatteiden päälle. Data Processing Agreement on saatavilla pyynnöstä jokaiselle oppilaitokselle. Datan täydellinen vienti ja oikeus tulla unohdetuksi täytetään 30 päivän kuluessa (yleensä 48 tunnin sisällä).",
  },
  {
    title: "Local-first, aina",
    body: "Voit käyttää Flueraa täysin ilman verkkoa. Synkronointi laitteidesi välillä on pois päältä, kunnes kytket sen päälle, ja se koskee koko tiliäsi. Kun synkronointi on pois, canvas-näkymäsi pysyvät laitteella. Muu lähtee laitteelta vain niin kuin opas Yksityisyys ja AI-suostumus kertoo, kytkin kytkimeltä: telemetria esimerkiksi vain suostumuksellasi, tiliisi sidottuna eikä koskaan sisällön kanssa.",
  },
  {
    title: "Mitä emme tee",
    body: "Emme näytä mainoksia. Emme myy dataasi. Emme kouluta malleja canvas-näkymilläsi, ellet itse valitse niin: AI-harjoitusaineisto on pois päältä, kunnes kytket sen päälle. Emme seuraa sinua verkossa. Emme luovuta dataa kolmansille osapuolille nimettyjen alikäsittelijöiden lisäksi (lueteltu Alikäsittelijät-sivulla) — kaikki käsittelysopimuksen alaisina.",
  },
];
---

<BaseLayout
  title="Tietoturva ja yksityisyys"
  description="Salattu paikallinen tietokanta, GDPR oletuksena, palvelimet Euroopassa, nolla ad-techiä. Flueran turvallisuusarkkitehtuuri ja lupaus siitä, että data on sinun."
  locale="fi"
>
  <PageHero
    kicker="Tietoturva ja yksityisyys"
    title="Salattu levossa ja siirrossa.<br />Palvelimet EU:ssa."
    titleSize="2xl"
    description="Salaus oletuksena. Ei ad-techia. Palvelimet Euroopassa. Täydellinen vienti. Yksityisyys on suunnittelurajoite, ei compliance-tehtävä."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Vastuullinen ilmoittaminen</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Löysitkö jotain?</h2>
          <p class="prose-ink mb-6">
            Tietoturvatutkijat ovat tervetulleita. Ilmoita haavoittuvuuksista osoitteeseen <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Vastaamme 5 arkipäivän kuluessa. Bug bounty -ohjelmaa ei ole.
          </p>
          <p class="text-sm text-ink-500 italic">
            Ilmoitusten säännöt on julkaistu myös tiedostossa /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance ja käyttöönotto</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Otatko Flueran käyttöön instituutiossa?</h2>
          <p class="prose-ink mb-6">
            Yliopistot, koulut, tutkimuslaboratoriot: voimme opastaa DPA:n ja alikäsittelijöiden listan kanssa. Pilotit alkavat tyypillisesti yhdellä kurssilla, yhdellä lukukaudella, ilman kustannuksia.
          </p>
          <a href="/fi/contact" class="btn-primary">Keskustele käyttöönotosta →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Tämä sivu kattaa olennaisen. Täydellinen arkkitehtuuri ja alikäsittelijöiden rekisteri löytyvät osoitteista
        <a href="/fi/security/architecture" class="text-paper-300 underline">/fi/security/architecture</a> ja
        <a href="/fi/security/sub-processors" class="text-paper-300 underline">/fi/security/sub-processors</a>. Erityisiä compliance-kysymyksiä? Kirjoita osoitteeseen
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
