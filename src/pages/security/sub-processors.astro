---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Database, authentication, cloud storage, real-time collaboration, AI proxy Edge Functions.",
    dataTypes: "Account email, hashed user ID, synced canvas content (encrypted in transit via TLS and at rest on EU infrastructure — not end-to-end encrypted; accessible to Fluera as data controller, never sold or used for advertising), sync metadata.",
    region: "Stockholm, EU (eu-north-1) — production. Dublin, EU (eu-west-1) — staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (Gemini models) for Socratic mode, Ghost Map, LaTeX OCR, and exam-session generation.",
    dataTypes: "Selected canvas content submitted only when AI features are consented and used — text portions and rendered PNG images of individual handwriting-cluster regions. Never the full notebook. Separately, for the automated check for illegal content, without the AI-features consent: the thumbnail, images, title and description of a card you upload to the catalogue or share privately, and a creator's profile photo.",
    region: "European Union only — EU endpoints of Vertex AI: the europe-west4 (Netherlands) and europe-west1 (Belgium) regions, or the EU multi-region endpoint, which Google limits to EU member states. No transfer of canvas content outside the EU for AI inference.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Subscription management and receipt validation for purchases made through the App Store and Google Play (iOS, macOS, Android).",
    dataTypes: "Pseudonymous account ID (the user ID of the Fluera account, or an anonymous RevenueCat ID before sign-in), subscription status, receipt metadata. Sent from app launch on iOS, macOS and Android, to manage the subscription. No payment card data.",
    region: "US; SCC.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Crash reporting and error monitoring.",
    dataTypes: "Stack traces, OS version, device model, app version. sendDefaultPii is explicitly disabled and IP addresses are not stored — no user content.",
    // 🇪🇺 Corrected 2026-08-01: the production DSN ingests into
    // `ingest.de.sentry.io`, i.e. Sentry's European data region. Since April
    // this page had named the United States instead — understating our own
    // posture, but wrong either way in an Art. 28 disclosure, and wrong in all
    // sixteen languages at once.
    region: "European Union (Frankfurt) — the production DSN ingests into Sentry's EU data region. Processor entity is US-incorporated; SCC.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hosting of share.fluera.dev: the web catalogue, card pages, the report form and the AI assistant connector.",
    dataTypes: "IP address and request data of visitors (technical logs). Reports sent through the form pass through here on their way to Supabase. No cookies.",
    region: "Global edge; company based in the US. DPA incorporated in the Deno Deploy terms; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "fluera.dev itself is hosted on GitHub Pages. GitHub Inc. is not a sub-processor: it records the technical data of visits (IP address, time, page) to secure its own service, as an independent controller under its own privacy statement. The same applies to the typefaces that share.fluera.dev loads from fluera.dev.";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "Apple and Google are not sub-processors either. For Sign in with Apple, Sign in with Google and purchases through the App Store and Google Play, they act as independent controllers for the data of their own platforms, under their own terms and privacy policies.";
---

<BaseLayout
  title="Sub-processors"
  description="The third-party services Fluera relies on to deliver the product. Purpose, data shared, region, and link to each sub-processor's privacy policy."
>

  <PageHero
    kicker="Sub-processors"
    title="Every third party we rely on."
    description="Under GDPR Art. 28, every sub-processor that handles personal data on our behalf is listed here — what we share, why, and where it lives. We notify customers of changes before they take effect."
    breadcrumb={{ label: "Security", href: "/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Last updated: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Privacy policy ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Purpose</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Data shared</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Region</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub privacy statement ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Apple privacy policy ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Google privacy policy ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Changes and notifications</h2>
      <p class="prose-ink text-sm mb-4">
        We update this list whenever a sub-processor is added, changed, or removed. Education and enterprise customers receive email notice at least 30 days before the change takes effect, per Art. 28(2) GDPR.
      </p>
      <p class="prose-ink text-sm">
        To subscribe to sub-processor change notifications, email <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> from the address on your account.
      </p>
    </div>
  </section>

</BaseLayout>
