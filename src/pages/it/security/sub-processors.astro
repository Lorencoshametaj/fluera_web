---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Database, autenticazione, storage cloud, signaling realtime, Edge Function di proxy AI.",
    dataTypes: "Email account, ID utente hashato, contenuti del canvas in sync (cifrati in transito via TLS e a riposo su infrastruttura UE — non end-to-end; accessibili a Fluera in qualità di titolare del trattamento, mai venduti né usati per pubblicità), metadata di sync.",
    region: "Stoccolma, UE (eu-north-1) — produzione. Dublino, UE (eu-west-1) — staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (modelli Gemini) per Socratic Mode, Ghost Map, LaTeX OCR e generazione delle exam session.",
    dataTypes: "Contenuti selezionati del canvas, trasmessi solo quando le funzioni AI sono consentite e utilizzate — porzioni di testo e immagini PNG renderizzate delle singole regioni dei cluster di scrittura a mano. Mai l'intero quaderno.",
    region: "Solo Unione Europea — europe-west4 (Paesi Bassi) primaria, europe-west1 (Belgio) di failover. Nessun trasferimento di contenuti del canvas fuori dall'UE per l'inferenza AI.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "Google LLC",
    purpose: "Autenticazione Sign in with Google (identity provider).",
    dataTypes: "Email dell'account Google e identificativo dell'account. Nessun dato del canvas.",
    region: "US; SCC + EU-US DPF.",
    privacy: "https://policies.google.com/privacy",
  },
  {
    name: "Apple Inc.",
    purpose: "Autenticazione Sign in with Apple; acquisti in-app su iOS e macOS via App Store.",
    dataTypes: "Email relay Apple ID, identificativi ricevute. Nessun dato del canvas.",
    region: "US; SCC + EU-US DPF.",
    privacy: "https://www.apple.com/legal/privacy/",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Gestione abbonamenti e validazione ricevute su iOS, Android e web.",
    dataTypes: "ID utente RevenueCat anonimizzato, stato abbonamento, metadata ricevute. Nessun dato di carta di pagamento.",
    region: "US; SCC + EU-US DPF.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Segnalazione crash e monitoring errori.",
    dataTypes: "Stack trace, versione OS, modello dispositivo, versione app. sendDefaultPii è esplicitamente disabilitato e gli indirizzi IP non vengono conservati — nessun contenuto utente.",
    region: "Unione Europea (Francoforte) — il DSN di produzione ingesta nella regione dati UE di Sentry. L'entità che tratta i dati è costituita negli Stati Uniti; SCC + EU-US DPF.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hosting di share.fluera.dev: catalogo web, pagine delle schede, modulo di segnalazione e connettore dell'assistente AI.",
    dataTypes: "Indirizzo IP e dati delle richieste di chi visita (log tecnici). Le segnalazioni inviate dal modulo passano di qui per arrivare a Supabase. Nessun cookie.",
    region: "Edge globale; società con sede negli Stati Uniti. DPA richiamato nei termini di Deno Deploy; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-09-29";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "fluera.dev è ospitato su GitHub Pages. GitHub Inc. non è un sub-processor: registra i dati tecnici delle visite (indirizzo IP, ora, pagina) per la sicurezza del proprio servizio, come titolare autonomo e secondo la propria informativa. Lo stesso vale per i caratteri tipografici che share.fluera.dev carica da fluera.dev.";
---

<BaseLayout
  title="Sub-processor"
  description="Le terze parti su cui Fluera si appoggia per erogare il prodotto. Finalità, dati condivisi, regione e link alla privacy policy di ogni sub-processor."
  locale="it"
>
  <PageHero
    kicker="Sub-processor"
    title="Ogni terza parte su cui ci appoggiamo."
    description="Ai sensi dell'art. 28 GDPR, ogni sub-processor che tratta dati personali per nostro conto è elencato qui — cosa condividiamo, perché e dove vive. Notifichiamo i clienti prima di ogni cambio."
    breadcrumb={{ label: "Sicurezza", href: "/it/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Ultimo aggiornamento: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Privacy policy ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Finalità</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Dati condivisi</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Regione</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">Informativa di GitHub ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Cambiamenti e notifiche</h2>
      <p class="prose-ink text-sm mb-4">
        Aggiorniamo questa lista ogni volta che un sub-processor viene aggiunto, cambiato o rimosso. I clienti Istituzionali ed enterprise ricevono notifica email almeno 30 giorni prima del cambio, ai sensi dell'art. 28(2) GDPR.
      </p>
      <p class="prose-ink text-sm">
        Per iscriverti alle notifiche di cambio sub-processor, scrivi a <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> dall'indirizzo del tuo account.
      </p>
    </div>
  </section>
</BaseLayout>
