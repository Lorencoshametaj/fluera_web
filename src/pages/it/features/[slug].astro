---
import FeatureDetailPage from "@/components/FeatureDetailPage.astro";
import { baseFeatureSlug } from "@/lib/features";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const features = await getCollection("features", ({ data }) => data.lang === "it");
  return features.map((feature) => ({
    params: { slug: baseFeatureSlug(feature.id) },
    props: { feature },
  }));
}

const { feature } = Astro.props;
---

<FeatureDetailPage feature={feature} locale="it" />
