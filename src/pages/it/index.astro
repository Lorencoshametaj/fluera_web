---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/it";
import pricing from "@/data/pricing/it";
import copy from "@/data/homeCopy/it";

const description = "Un canvas per imparare, non un'app di note. Fluera trasforma i tuoi appunti a mano in una mappa viva della laurea e ti ri-studia prima che la memoria ceda.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/it/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="it">
  <PremiumHome locale="it" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
