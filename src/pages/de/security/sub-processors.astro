---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Datenbank, Authentifizierung, Cloud-Storage, Realtime-Signaling, Edge Functions als KI-Proxy.",
    dataTypes: "E-Mail des Kontos, gehashte Nutzer-ID, synchronisierte Canvas-Daten (bei der Übertragung per TLS und at-rest auf EU-Infrastruktur verschlüsselt, jedoch nicht Ende-zu-Ende-verschlüsselt — als Verantwortlicher kann Fluera darauf zugreifen, verkauft sie aber niemals und nutzt sie nicht für Werbung), Synchronisierungs-Metadaten.",
    region: "Stockholm, EU (eu-north-1) — Produktion. Dublin, EU (eu-west-1) — Staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (Gemini-Modelle) für Socratic Mode, Ghost Map, LaTeX-OCR und die Generierung der Exam Sessions.",
    dataTypes: "Ausgewählte Canvas-Inhalte, die nur übermittelt werden, wenn in die KI-Funktionen eingewilligt wurde und diese genutzt werden — Textausschnitte und gerenderte PNG-Bilder einzelner Handschrift-Cluster-Bereiche. Niemals das gesamte Heft. Davon getrennt, für die automatische Prüfung auf rechtswidrige Inhalte und ohne Einwilligung in die KI-Funktionen: Vorschaubild, Bilder, Titel und Beschreibung einer Karte, die du in den Katalog hochlädst oder privat teilst, sowie das Profilfoto eines Creators.",
    region: "Ausschließlich Europäische Union — EU-Endpunkte von Vertex AI: die Regionen europe-west4 (Niederlande) und europe-west1 (Belgien) oder der EU-Multi-Region-Endpunkt, den Google auf die EU-Mitgliedstaaten beschränkt. Keine Übermittlung von Canvas-Inhalten außerhalb der EU für die KI-Inferenz.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Verwaltung der Abonnements und Validierung der Belege für Käufe über den App Store und Google Play (iOS, macOS, Android).",
    dataTypes: "Pseudonyme Konto-ID (die Nutzer-ID des Fluera-Kontos oder vor der Anmeldung eine anonyme RevenueCat-ID), Abonnement-Status, Beleg-Metadaten. Übermittelt ab dem App-Start unter iOS, macOS und Android, um das Abonnement zu verwalten. Keine Kartendaten.",
    region: "USA; SCCs.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Crash-Reporting und Fehler-Monitoring.",
    dataTypes: "Stack-Traces, OS-Version, Gerätemodell, App-Version. sendDefaultPii ist explizit deaktiviert und IP-Adressen werden nicht gespeichert — keine Nutzerinhalte.",
    region: "Europäische Union (Frankfurt) — der Produktions-DSN übermittelt in die EU-Datenregion von Sentry. Die Auftragsverarbeiter-Gesellschaft ist in den USA inkorporiert; SCCs.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hosting von share.fluera.dev: Web-Katalog, Kartenseiten, Meldeformular und Konnektor für den KI-Assistenten.",
    dataTypes: "IP-Adresse und Anfragedaten der Besucher (technische Logs). Über das Formular gesendete Meldungen laufen hier durch zu Supabase. Keine Cookies.",
    region: "Globales Edge; Unternehmen mit Sitz in den USA. DPA in die Bedingungen von Deno Deploy einbezogen; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "fluera.dev selbst wird auf GitHub Pages gehostet. GitHub Inc. ist kein Auftragsverarbeiter: GitHub speichert die technischen Daten der Besuche (IP-Adresse, Uhrzeit, Seite), um den eigenen Dienst zu schützen – als eigenständig Verantwortlicher nach seiner eigenen Datenschutzerklärung. Dasselbe gilt für die Schriften, die share.fluera.dev von fluera.dev lädt.";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "Auch Apple und Google sind keine Auftragsverarbeiter. Bei Sign in with Apple, Sign in with Google und Käufen über den App Store und Google Play handeln sie als eigenständig Verantwortliche für die Daten ihrer eigenen Plattformen, nach ihren eigenen Bedingungen und Datenschutzerklärungen.";
---

<BaseLayout
  title="Auftragsverarbeiter"
  description="Die Drittparteien, auf die sich Fluera stützt, um das Produkt zu liefern. Zweck, geteilte Daten, Region und Link zur Datenschutzerklärung jedes Auftragsverarbeiters."
  locale="de"
>
  <PageHero
    kicker="Auftragsverarbeiter"
    title="Jede Drittpartei, auf die wir uns stützen."
    description="Gemäß Art. 28 DSGVO ist hier jeder Auftragsverarbeiter aufgeführt, der personenbezogene Daten in unserem Auftrag verarbeitet — was wir teilen, warum und wo es lebt. Wir benachrichtigen die Kunden vor jeder Änderung."
    breadcrumb={{ label: "Sicherheit", href: "/de/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Letzte Aktualisierung: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Datenschutzerklärung ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Zweck</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Geteilte Daten</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Region</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">Datenschutzerklärung von GitHub ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Datenschutzerklärung von Apple ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Datenschutzerklärung von Google ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Änderungen und Benachrichtigungen</h2>
      <p class="prose-ink text-sm mb-4">
        Wir aktualisieren diese Liste, sobald ein Auftragsverarbeiter hinzugefügt, geändert oder entfernt wird. Institutionelle und Enterprise-Kunden erhalten eine E-Mail-Benachrichtigung mindestens 30 Tage vor der Änderung, gemäß Art. 28 Abs. 2 DSGVO.
      </p>
      <p class="prose-ink text-sm">
        Um dich für die Benachrichtigungen zu Auftragsverarbeiter-Änderungen anzumelden, schreibe an <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> von der E-Mail-Adresse deines Kontos aus.
      </p>
    </div>
  </section>
</BaseLayout>
