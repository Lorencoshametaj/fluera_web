---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Verschlüsselung",
    body: "Auf deinem Gerät ist die Datenbank mit deinen Canvas im Ruhezustand mit sqlite3mc verschlüsselt (ChaCha20-Poly1305, 256-Bit-Schlüssel); Fotos, PDFs und Vorlesungsaudio sind Dateien im privaten Ordner der App, geschützt vom Betriebssystem. Eine exportierte .fluera-Datei ist nicht verschlüsselt; das Verschlüsselte Backup ist mit AES-256-GCM versiegelt. Der Datenverkehr läuft über TLS. Cloud-Sync ist nicht Ende-zu-Ende-verschlüsselt: synchronisierte Canvas liegen auf EU-Infrastruktur (Supabase, eu-north-1), beim Transport und im Ruhezustand auf Infrastrukturebene verschlüsselt. Als Verantwortlicher können wir technisch auf synchronisierte Inhalte zugreifen — wir verkaufen sie aber nie und nutzen sie nie für Werbung.",
  },
  {
    title: "Eigentum an deinen Daten",
    body: "Jedes Byte, das du schreibst, ist mit einem Klick exportierbar: PNG, JPEG, WebP, SVG, PDF und unser .fluera-Format. Deine Canvas leben zuerst auf deinen Geräten. Die Cloud ist ein Komfort, kein Gefängnis — Lock-in ist ein Geschäftsmodell, gegen das wir uns entschieden haben.",
  },
  {
    title: "DSGVO ab Werk",
    body: "Fluera wird auf Servern in Europa gehostet und ist nach den Prinzipien der DSGVO gebaut. Ein Data Processing Agreement steht für jede Bildungseinrichtung auf Anfrage zur Verfügung. Vollständiger Datenexport und Recht auf Vergessenwerden werden innerhalb von 30 Tagen erfüllt (in der Regel innerhalb von 48 Stunden).",
  },
  {
    title: "Local-first, immer",
    body: "Du kannst Fluera komplett offline nutzen. Die Synchronisierung zwischen deinen Geräten ist aus, bis du sie einschaltest, und gilt für dein ganzes Konto. Mit ausgeschaltetem Sync bleiben deine Canvas auf dem Gerät. Alles andere verlässt es nur so, wie es Schalter für Schalter im Leitfaden Datenschutz und KI-Einwilligung steht: Telemetrie zum Beispiel nur mit deiner Einwilligung, an dein Konto gebunden und nie mit Inhalten.",
  },
  {
    title: "Was wir nicht tun",
    body: "Wir schalten keine Werbung. Wir verkaufen deine Daten nicht. Wir trainieren keine Modelle mit deinen Canvas, außer du entscheidest dich dafür: KI-Trainingsdaten sind aus, bis du sie einschaltest. Wir verfolgen dich nicht im Web. Wir geben keine Daten an Dritte weiter außer an benannte Auftragsverarbeiter (auf der Seite Sub-Processors aufgeführt) — alle unter AVV.",
  },
];
---

<BaseLayout
  title="Sicherheit und Datenschutz"
  description="Verschlüsselte lokale Datenbank, DSGVO ab Werk, Server in Europa, null Ad-Tech. Die Sicherheitsarchitektur von Fluera und das Bekenntnis zum Eigentum an deinen Daten."
  locale="de"
>
  <PageHero
    kicker="Sicherheit und Datenschutz"
    title="Lokal verschlüsselt.<br />Cloud-Sync transparent erklärt."
    titleSize="2xl"
    description="Verschlüsselung ab Werk. Kein Ad-Tech. Server in Europa. Vollständiger Export. Datenschutz ist eine Design-Restriktion, keine Compliance-Aufgabe."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Responsible Disclosure</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Etwas gefunden?</h2>
          <p class="prose-ink mb-6">
            Sicherheitsforscher sind hier willkommen. Melde Schwachstellen an <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Wir antworten innerhalb von 5 Werktagen. Es gibt kein Bug-Bounty-Programm.
          </p>
          <p class="text-sm text-ink-500 italic">
            Die Regeln für Meldungen stehen auch in /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Compliance und Deployment</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Adoption an einer Institution geplant?</h2>
          <p class="prose-ink mb-6">
            Universitäten, Schulen, Forschungslabore: wir können dich durch DPA und Liste der Subauftragsverarbeiter führen. Pilotprogramme starten meist mit einem Kurs, einem Semester, ohne Kosten.
          </p>
          <a href="/de/contact" class="btn-primary">Über Deployment sprechen →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Diese Seite deckt das Wesentliche ab. Die vollständige Architektur und das Register der Subauftragsverarbeiter leben unter
        <a href="/de/security/architecture" class="text-paper-300 underline">/de/security/architecture</a> und
        <a href="/de/security/sub-processors" class="text-paper-300 underline">/de/security/sub-processors</a>. Spezifische Compliance-Fragen? Schreibe an
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
