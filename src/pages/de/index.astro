---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/de";
import pricing from "@/data/pricing/de";
import copy from "@/data/homeCopy/de";

const description = "Ein Canvas zum Lernen, keine Notiz-App. Fluera verwandelt deine handschriftlichen Notizen in eine lebendige Karte deines Studiums und fragt dich ab, bevor das Gedächtnis nachlässt.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/de/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="de">
  <PremiumHome locale="de" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
