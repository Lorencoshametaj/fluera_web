---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/fr";
import pricing from "@/data/pricing/fr";
import copy from "@/data/homeCopy/fr";

const description = "Un canvas pour apprendre, pas une app de notes. Fluera transforme vos notes manuscrites en une carte vivante de votre cursus et vous réinterroge avant que la mémoire ne lâche.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/fr/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="fr">
  <PremiumHome locale="fr" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
