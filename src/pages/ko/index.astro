---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/ko";
import pricing from "@/data/pricing/ko";
import copy from "@/data/homeCopy/ko";

const description = "배우기 위한 캔버스, 메모 앱이 아닙니다. Fluera는 손글씨 노트를 전공의 살아 있는 지도로 바꾸고 기억이 흐려지기 전에 다시 물어봅니다.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/ko/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<BaseLayout title={SITE.name} description={description} jsonLd={jsonLd} locale="ko">
  <PremiumHome locale="ko" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
