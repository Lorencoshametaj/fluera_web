---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CatalogueMark from "@/components/CatalogueMark.astro";

// ─────────────────────────────────────────────────────────────────────────────
// Every claim on this page was checked against the shipped source (app, engine,
// Supabase migrations, edge functions) — not against the design docs, which
// describe intent rather than behaviour. Two rules the copy must keep obeying:
//
//   1. No numbers about the catalog or its usage. The catalog is new; any
//      install/creator/template count would be a vanity claim.
//   2. No retention PERCENTAGE. The ranking signal is shipped, but the on-device
//      baseline currently subtracts a superseded forgetting curve
//      (mastery_checkpoint_service.dart:161 uses exp(-N/1.5) while retrievability
//      is measured with the FSRS-6 power curve), so the magnitude is not yet
//      quotable. Describing the ORDERING is fine; publishing a number is not.
//
// See also: the creator terms for publishing are still an unreviewed draft, so this
// page must not link to them or imply that open publishing is a finished product.
// ─────────────────────────────────────────────────────────────────────────────

const whatItCarries = [
  {
    title: "테두리로 잘라낸 한 장",
    body: "노트 전체가 아닙니다. 저자가 자기 캔버스에서 테두리로 잡아낸 한 구획입니다. 그 안에 그은 획, 도형, 입력한 글자, 이미지가 담기고, 테두리 바깥은 한 획도 들어가지 않습니다. 원본 PDF는 딸려 가지 않습니다.",
  },
  {
    title: "개념의 뼈대",
    body: "잉크 아래에 깔린 구조입니다. 어떤 개념이 있고, 각 개념이 어느 주제에 속하며, 무엇이 무엇에 기대고 있는지. 그냥 읽히는 페이지와 가르칠 수 있는 페이지를 가르는 것이 이 뼈대입니다.",
  },
  {
    title: "새 카드 레시피",
    body: "저자의 기억이 아니라 내 기억을 만들 재료입니다. 목표로 삼을 기억 유지율, 자료의 종류, 첫 복습이 돌아오는 시점. 설치하는 순간 이것으로 내 일정이 짜입니다.",
  },
];

const install = [
  {
    step: "01",
    title: "페이지는 잉크째로 건너옵니다",
    body: "그 페이지는 내 캔버스에 그대로 복원됩니다. 렌더링한 PDF가 아니라 진짜 종이에 쓴 진짜 손글씨입니다. 그 위에 덧쓰고, 이어 그리고, 잘라낼 수 있습니다.",
  },
  {
    step: "02",
    title: "개념 하나에 카드 하나",
    body: "이름이 붙은 개념마다 간격 반복 카드가 새로 하나씩 생깁니다. 딸려 오는 복습 이력은 없습니다. 반복 횟수 0, 난이도는 Fluera 범위의 한가운데. 첫 복습은 하루 뒤입니다.",
  },
  {
    step: "03",
    title: "그다음부터 일정은 내 것입니다",
    body: "일정은 디스크에 남고, 직접 쓴 다른 노트와 똑같이 마감 배지와 하루 요약에 그대로 반영됩니다. 같은 템플릿을 다시 설치해도 이미 쌓아 둔 복습 이력은 지워지지 않습니다.",
  },
];

const ranking = [
  {
    label: "측정은 기기에서",
    body: "템플릿의 캔버스를 1일, 7일, 30일째, 또는 그 이후에 다시 열면 Fluera가 숫자 하나를 읽어 냅니다. 간격 반복 모델이 그 개념들을 얼마나 붙들고 있다고 보는지를 담은 값입니다.",
  },
  {
    label: "올라가는 것은 숫자 하나뿐",
    body: "전송되는 것은 그 숫자가 전부입니다. 개념 제목도, 카드 내용도, 복습 이력도, 신원도 따라가지 않습니다. 로그인 상태이고 분석 수집에 동의했을 때만 올라가며, 자기가 만든 템플릿에서는 절대 올라가지 않습니다.",
  },
  {
    label: "다섯 명이 모이기 전까지는 침묵",
    body: "서로 다른 학습자 다섯 명이 숫자를 보내기 전까지 템플릿에는 공개되는 수치가 아예 없습니다. 다섯 명에 못 미치면 정렬 기준이 설치 수로 내려가고, 카드는 아무 말도 하지 않습니다.",
  },
  {
    label: "다운로드 수는 순위가 아닙니다",
    body: "'모든 템플릿' 아래의 목록은 인기가 아니라 측정된 신호로 정렬되는 것이 기본입니다. 빨리 퍼졌다고 해서 그 순위까지 살 수는 없습니다.",
  },
];

const cardMarks = [
  { mark: "공식", body: "자료실이 붙입니다. 저자가 양식에 적어 넣는다고 붙는 것이 아닙니다. 표시 이름에 '공식'이라고 써 넣어 봐야 붙지 않습니다." },
  { mark: "신규", body: "거저 붙지 않습니다. 설치 0, 평점 0, 게시한 지 한 주 이내. 누가 떼 주는 것이 아니라 스스로 떨어져 나갑니다." },
  { mark: "과목", body: "템플릿을 어느 과목에 넣었는지 보여 줍니다. 화학 페이지와 화학 언저리의 페이지를 한눈에 가릅니다." },
  { mark: "평점", body: "실제로 설치한 사람이 실제로 별을 준 뒤에만 뜹니다. 평가가 없는 템플릿은 0점에서 시작하는 대신 아무 말도 하지 않습니다." },
];

const privacy = [
  {
    title: "학습자 모델은 파일에 들어가지 않습니다",
    body: "공개용 뼈대를 만드는 구성 요소는 구조상 복습 이력을 읽지 못합니다. 얼마나 확신했는지도, 몇 번 공부했는지도, 얼마나 잘 붙들고 있었는지도, 그 뒤에 딸린 임베딩도 읽지 못합니다. 통달한 사람과 헤매는 사람이 같은 페이지를 올리면 바이트까지 똑같은 뼈대가 나옵니다.",
  },
  {
    title: "그 선은 CI의 테스트가 지킵니다",
    body: "이 보장은 테스트 하나가 붙들고 있습니다. 직렬화된 결과물을 훑어, 학습자 모델과 행동에 관한 필드 이름 스물여섯 개 가운데 하나라도 나오면 실패하는 테스트입니다. 이름이 붙은 필수 CI 게이트로 돌아가고, 테스트 파일을 지워도 실패합니다.",
  },
  {
    title: "잉크가 정직한 한계입니다",
    body: "아무리 걸러 내도 손글씨 자체에는 닿지 못합니다. 게다가 뼈대에는 인식된 글자의 짧게 잘린 발췌가 실제로 실립니다. 전체 텍스트가 실리는 일은 없지만, 가려 놓지도 않았습니다. 그래서 게시 시트는 무엇이든 올라가기 전에 공개될 바로 그 이미지를 보여 주고, 그 아래에 동의 체크박스를 둡니다.",
  },
  {
    title: "이름이 핸들이 되는 일은 없습니다",
    body: "공개 조회에는 계정 ID가 아예 나오지 않습니다. 제작자는 계정에서 한 방향으로만 뽑아낸 코드로 식별됩니다. 솔트를 섞고, 해시하고, 잘라낸 값입니다. 신원이 아니라 고정된 가명입니다.",
  },
];

const safety = [
  {
    label: "올렸다고 등록되지는 않습니다",
    body: "새 템플릿은 심사 대기 상태로 기록됩니다. 심사를 거치기 전에는 둘러보기에도, 검색에도, 자료실 어디에도 없고, 공유 링크를 눌러도 아무것도 열리지 않습니다.",
  },
  {
    label: "심사는 진짜 파일을 읽습니다",
    body: "분류기는 올린 사람이 붙인 썸네일을 믿는 대신 템플릿 안에 든 이미지를 직접 꺼내 읽고, 그중 가장 나쁜 판정을 기준으로 삼으며, EU 리전에서 돌아갑니다. 항목을 통과시키거나 위로 올려 보낼 수는 있어도, 모더레이터의 결정을 뒤집지는 못합니다.",
  },
  {
    label: "신고는 기계가 아니라 사람에게 갑니다",
    body: "신고는 사람이 보는 대기열로 들어가는 신호입니다. 신고자 한 명에 하나, 자기 신고는 받지 않습니다. 무리를 지으면 주목은 끌 수 있어도, 등록물을 내릴 수는 없습니다.",
  },
  {
    label: "삭제는 바이트까지 지웁니다",
    body: "등록물이 내려가면, 증거를 관리자만 여는 비공개 버킷에 남긴 뒤 게시된 객체를 CDN에서 지웁니다. 목록에서만 빼는 것이 아닙니다.",
  },
  {
    label: "결정에는 이유가 붙습니다",
    body: "제작자는 자기 템플릿에 무슨 일이 있었는지, 그 결정이 자동으로 내려진 것인지까지 함께 통보받고, 이의를 제기할 수 있습니다. 이의가 받아들여지면 등록물은 되돌아옵니다.",
  },
  {
    label: "평점은 얻어야 붙습니다",
    body: "설치한 적 없는 템플릿에는 별을 줄 수 없고, 자기 템플릿에도 줄 수 없으며, 익명으로도 줄 수 없습니다. 평균은 조금씩 더해 올리는 것이 아니라 매번 처음부터 다시 계산합니다.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Fluera 자료실",
  description:
    "설치하면 간격 반복 일정이 되는 손글씨 학습 템플릿 자료실. 순위는 다운로드 수가 아니라 측정된 기억 유지가 정합니다.",
  isPartOf: { "@type": "WebSite", name: "Fluera", url: "https://fluera.dev" },
  inLanguage: "ko",
};
---

<BaseLayout
  title="자료실 — 기억 속에 설치되는 학습 템플릿"
  description="학습 템플릿은 손글씨 한 장과 그 아래에 깔린 개념 구조입니다. 하나를 설치하면 내 캔버스에 간격 반복 일정이 자리 잡습니다. 순위는 다운로드 수가 아니라 측정된 기억 유지가 정합니다."
  ogImage="/og/page/catalogue.png"
  jsonLd={jsonLd}
  locale="ko"
>
  <PageHero
    kicker="자료실"
    title="이 단원은 이미 누군가 풀어 두었습니다.<br />설치하는 순간, 시험받는 쪽은 나입니다."
    titleSize="2xl"
    description="Fluera 학습 템플릿은 PDF도 플래시카드 묶음도 아닙니다. 진짜 손글씨 한 장, 그 아래 깔린 개념 구조, 그리고 앞으로 어떻게 복습할지를 적어 둔 처방입니다. 하나를 설치하면 그 일정이 내 캔버스에 자리 잡습니다."
    orbs
    noise
  >
    <CatalogueMark slot="mark" size={30} class="mb-4" />
    <div slot="copy" class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/ko/beta" class="btn-primary">얼리 액세스 요청 →</a>
      <a href="/ko/features/spaced-repetition" class="btn-secondary">복습 일정이 돌아가는 방식</a>
    </div>
  </PageHero>

  <!-- WHAT A TEMPLATE IS -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="단위"
        title="건너오는 것은 셋입니다. 저자는 건너오지 않습니다."
        sub="다른 스토어는 문서 하나를 건네주고 행운을 빌어 줍니다. 학습 템플릿에는 페이지, 그 페이지를 가르칠 수 있게 만드는 구조, 일정을 짜는 지침이 함께 들어 있습니다. 만든 사람에게 속한 부분만 일부러 뺐습니다."
      />

      <div class="grid md:grid-cols-3 gap-6">
        {whatItCarries.map((c, i) => (
          <article class="card p-7">
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="font-serif text-xl text-paper-50 mb-3">{c.title}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT INSTALLING DOES -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <p class="eyebrow mb-6 text-accent-glow">설치</p>
          <h2 class="font-serif text-display-xl text-paper-50 mb-6">
            파일은 가지는 것이고,<br />일정은 올라타는 것입니다.
          </h2>
          <p class="prose-ink mb-4">
            학습 자료를 내려받는 일은 한 번도 어려웠던 적이 없습니다. 어려운 쪽은 잊기 직전인 그날 그 자료로 돌아오는 것이고, 폴더는 그 문제를 풀어 준 적이 없습니다.
          </p>
          <p class="prose-ink">
            그래서 템플릿 설치는 문서를 어딘가에 놓아 두는 일이 아닙니다. 날짜가 박힌 카드를 심는 일입니다. 저자의 개념과 그 사이의 구조는 물려받지만, 저자의 복습 이력도, 얼마나 확신했는지도, 그것을 얼마나 잘 알았는지도 물려받지 않습니다. 템플릿 형식 자체가 그것들을 담지 못합니다.
          </p>
        </div>

        <ol class="space-y-4 list-none p-0 m-0">
          {install.map((s) => (
            <li class="card p-7">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-xs tracking-widest text-ink-500 shrink-0">{s.step}</span>
                <div>
                  <h3 class="font-serif text-lg text-paper-50 mb-2">{s.title}</h3>
                  <p class="text-sm text-paper-300 leading-relaxed">{s.body}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- RANKING -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="순위"
        title="많이 퍼진 순서가 아니라,<br />머리에 남은 순서입니다."
        sub="다운로드 수는 아직 아무도 아무것도 배우지 않은 시점에 내린 결정을 셉니다. 어느 스토어에서든 부풀리기 가장 쉬운 숫자이기도 합니다. Fluera는 더 나은 기준을 쓸 수 있습니다. 앱이 이미 모든 학습자가 모든 개념을 얼마나 붙들고 있는지 모델링하고 있기 때문입니다."
      />

      <div class="grid sm:grid-cols-2 gap-4 max-w-5xl">
        {ranking.map((r) => (
          <article class="card p-7">
            <h3 class="font-serif text-lg text-paper-50 mb-3">{r.label}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{r.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 max-w-3xl rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
        <p class="text-sm text-paper-300 leading-relaxed">
          <strong class="text-paper-100">이것이 아닌 것.</strong> 이것은, 다시 공부하러 돌아온 학습자들이 템플릿의 개념을 얼마나 붙들고 있다고 모델이 보는지, 그 추정치입니다. 시험 점수가 아니고, 대조군이 아니며, 설치해 놓고 다시는 열지 않은 사람을 두고 하는 말도 아닙니다. 신호를 그럴듯하게 포장하기보다 있는 그대로 설명하는 쪽을 택합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- DISCOVERY -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <SectionHeader
        kicker="찾기"
        title="좁히는 방법이 셋,<br />그리고 내 기기에서만 되는 하나."
        sub="학습 자료실은 늘 같은 방식으로 실패합니다. 이름만 보면 전부 내 과목 이야기인데, 내 강의 이야기는 거의 없습니다. 그래서 필터를 학생이 실제로 떠올리는 단위로 짰습니다."
      />

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <p class="prose-ink mb-4">
            <strong class="text-paper-100">과목</strong>으로 좁히고, <strong class="text-paper-100">강의나 시험</strong>으로 좁힙니다. 여기는 자유 입력이라 <em>Maturità</em>도 <em>MCAT</em>도 <em>해석학 1</em>과 똑같이 유효합니다. 세 번째가 <strong class="text-paper-100">언어</strong>입니다. 필터마다 지금 걸리는 개수가 함께 뜨고, 하나를 고르면 나머지가 그에 맞춰 다시 계산되며, 걸리는 것이 하나도 없는 필터는 아예 나타나지 않습니다. 빈 화면으로 이어지는 선택지는 내놓지 않습니다.
          </p>
          <p class="prose-ink mb-4">
            자료실은 앱에 설정된 언어로 열립니다. 읽지 못하는 자료가 벽처럼 쌓인 곳은 자료실이 아니기 때문입니다. 울타리가 아니라 기본값입니다. 한 번 누르면 모든 언어로 넓어집니다.
          </p>
          <p class="prose-ink">
            검색은 전문 검색이고 악센트 부호에 너그럽습니다. 검색할 때는 순위를 내려놓고 관련도로 정렬합니다. 원하는 것을 이미 적어 넣었다면, 지금 묻고 있는 것은 남들 머리에 무엇이 남았는지가 아니기 때문입니다.
          </p>
        </div>

        <div class="card p-8">
          <h3 class="eyebrow text-accent-glow mb-5">카드에 붙은 표시 읽는 법</h3>
          <dl class="space-y-4 m-0">
            {cardMarks.map((m) => (
              <div>
                <dt class="font-serif text-base text-paper-50 mb-1">{m.mark}</dt>
                <dd class="text-sm text-paper-300 leading-relaxed m-0">{m.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="mt-10 max-w-3xl rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.08] p-6">
        <p class="text-sm text-paper-200 leading-relaxed">
          <strong class="text-paper-50">그리고 다른 누구도 만들 수 없는 줄 하나.</strong> Fluera는 내가 지금 어떤 개념을 붙들고 있는지 이미 압니다. 내가 직접 썼기 때문입니다. 그래서 지금 캔버스에 놓인 것과 얼마나 겹치는지로 템플릿을 줄 세울 수 있습니다. 그 계산은 기기 안에서 끝납니다. 휴대폰 밖으로 나가는 것은 가장 많이 공부한 과목, 그리고 이미 받아 둔 템플릿의 식별자입니다. 개념 집합은 거기에 없습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="가는 것과 가지 않는 것"
        title="페이지를 공개해도, 내가 얼마나 잘하고 있었는지까지 공개되지는 않습니다."
        sub="학습 자료를 나눈다는 것은 아직 배우는 중에 만든 것을 내놓는다는 뜻입니다. 그 둘 사이의 선은 정책 문단이 아니라 코드에 그어져 있습니다."
      />

      <div class="grid md:grid-cols-2 gap-4 max-w-5xl">
        {privacy.map((p) => (
          <article class="card p-7">
            <h3 class="font-serif text-lg text-paper-50 mb-3">{p.title}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href="/ko/security" class="btn-secondary">보안 아키텍처 읽기 →</a>
      </div>
    </div>
  </section>

  <!-- CREATORS -->
  <section class="py-20 md:py-28 border-b border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <p class="eyebrow mb-6 text-accent-glow">제작자에게</p>
          <h2 class="font-serif text-display-xl text-paper-50 mb-6">
            아무리 어려운 개념이어도<br />가장 좋은 설명은 대개 한 장에서 끝납니다.
          </h2>
          <p class="prose-ink mb-4">
            게시는 내 캔버스에서 시작합니다. 나눌 만한 구획을 테두리로 잡으면 Fluera가 그것을 찍어 내고, 시트가 파일로 만들지 등록물로 만들지 묻습니다. 테두리 안에 넣은 것만 나갑니다. 캔버스의 나머지는 그 자리에 그대로 남습니다.
          </p>
          <p class="prose-ink mb-4">
            무엇이든 올라가기 전에 공개될 바로 그 이미지를 보고 확인합니다. 등록물은 단 1바이트가 저장되기 전에 검증되고, 업로드는 한 번만 쓰는 서명 URL로 이뤄집니다. 실패하면 반쯤 만들어진 채 남지 않고 통째로 되돌아갑니다.
          </p>
          <p class="prose-ink">
            모든 템플릿은 무료입니다. Fluera에는 결제 화면이 없고, 게시 API에 가격 필드가 없으며, 정산 장부도 없습니다. 자료실의 가격 열은 정책이 아니라 데이터베이스 제약 조건이 0에 붙들고 있습니다.
          </p>
        </div>

        <div class="card p-8">
          <h3 class="eyebrow text-accent-glow mb-5">게시하면 따라오는 것</h3>
          <ul class="space-y-3.5 text-sm text-paper-200 list-none p-0 m-0 mb-6">
            <li class="flex items-start gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent-glow shrink-0"></span><span>계정도 이메일도 아닌 가명 제작자 핸들</span></li>
            <li class="flex items-start gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent-glow shrink-0"></span><span>원하면 채우는 프로필. 표시 이름, 소개, 아바타. 아바타는 심사를 마칠 때까지 내걸리지 않습니다</span></li>
            <li class="flex items-start gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent-glow shrink-0"></span><span>팔로워, 그리고 가장 최근에 올린 템플릿을 그 팔로워에게 실어 나르는 선반</span></li>
            <li class="flex items-start gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent-glow shrink-0"></span><span>버전 관리. 고친 판을 중복이 아니라 교체본으로 올립니다</span></li>
            <li class="flex items-start gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent-glow shrink-0"></span><span>불리한 결정에 반드시 따라붙는 이유, 그리고 되돌릴 수 있는 이의 제기</span></li>
          </ul>
          <p class="text-xs text-ink-500 leading-relaxed">
            게시하려면 로그인한 계정과 연령 확인이 필요합니다. 둘러보기와 설치에는 둘 다 필요 없습니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SAFETY -->
  <section class="py-20 md:py-28 border-b border-white/[0.04]">
    <div class="container-site">
      <SectionHeader
        kicker="모더레이션과 신뢰"
        title="낯선 사람들의 손글씨를 모아 두는 일에는<br />답할 사람이 있어야 합니다."
        sub="자료실은 누구나 열 수 있습니다. 진짜 일은 두 군데에 있습니다. 무언가 잘못됐을 때 무슨 일이 벌어지는가, 그리고 가장 목소리 큰 쪽이 결정을 쥐지 못하게 어떻게 막는가."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {safety.map((s) => (
          <article class="card p-6">
            <h3 class="font-serif text-base font-medium text-paper-50 mb-2">{s.label}</h3>
            <p class="text-sm text-paper-300 leading-relaxed">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STATUS + CTA -->
  <section class="py-20 md:py-28">
    <div class="container-narrow text-center">
      <p class="eyebrow mb-6 text-accent-glow">제공 현황</p>
      <h2 class="font-serif text-display-lg text-paper-50 mb-6">
        자료실은 앱과 함께 나옵니다.<br />아직 첫 장입니다.
      </h2>
      <p class="prose-ink mb-4 max-w-2xl mx-auto">
        둘러보기, 미리보기, 설치는 Fluera에 들어 있고 앱이 쓰는 열여섯 개 언어 모두로 옮겨져 있습니다. 게시도 로그인한 성인에게 이미 열려 있지만, 일부러 천천히 열고 있습니다. 남의 작업을 맡아 두는 일에는 책임이 따르고, 그 책임은 제대로 지거나 아예 지지 않거나 둘 중 하나이기 때문입니다.
      </p>
      <p class="prose-ink mb-10 max-w-2xl mx-auto">
        그래서 자료실은 작고, 이 페이지에는 템플릿 수도, 설치 수도, 제작자 수도 적혀 있지 않습니다. 그 숫자들은 언젠가 무언가를 뜻하게 될 것입니다. 오늘은 장식일 뿐입니다.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/ko/beta" class="btn-primary">얼리 액세스 요청 →</a>
        <a href="/ko/download" class="btn-secondary">Fluera 다운로드</a>
      </div>
    </div>
  </section>
</BaseLayout>
