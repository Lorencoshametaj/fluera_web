---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "암호화",
    body: "기기에서는 캔버스를 담은 데이터베이스가 sqlite3mc(ChaCha20-Poly1305, 256비트 키)로 저장 시 암호화됩니다. 사진, PDF, 강의 오디오는 앱 전용 폴더의 파일이며 운영체제가 보호합니다. 내보낸 .fluera 파일은 암호화되지 않습니다. 암호화된 백업은 AES-256-GCM으로 봉인됩니다. 통신은 TLS로 이루어집니다. 클라우드 동기화는 종단 간 암호화가 아닙니다. 동기화된 캔버스는 EU 인프라(Supabase, eu-north-1)에 저장되며 전송 중과 인프라 수준의 저장 시에 암호화됩니다. 개인정보 처리자로서 우리는 기술적으로 동기화된 콘텐츠에 접근할 수 있지만, 절대 판매하거나 광고에 사용하지 않습니다.",
  },
  {
    title: "데이터 소유권",
    body: "당신이 쓴 모든 바이트는 클릭 한 번으로 내보낼 수 있습니다: PNG, JPEG, WebP, SVG, PDF, 그리고 .fluera 형식. 캔버스는 먼저 당신의 기기에 있습니다. 클라우드는 편의이지 감옥이 아닙니다 — 락인은 우리가 거부한 비즈니스 모델입니다.",
  },
  {
    title: "GDPR 기본",
    body: "Fluera는 EU 호스팅이며 GDPR 원칙에 따라 설계되었습니다. 어떤 교육 기관이라도 요청 시 Data Processing Agreement를 사용할 수 있습니다. 완전한 데이터 내보내기 및 잊혀질 권리 요청은 30일 이내 (일반적으로 48시간 이내) 처리됩니다.",
  },
  {
    title: "로컬 우선, 항상",
    body: "Fluera는 완전히 오프라인으로 쓸 수 있습니다. 기기 간 동기화는 직접 켜기 전까지 꺼져 있으며, 계정 전체에 적용됩니다. 동기화가 꺼져 있으면 캔버스는 기기에 남습니다. 그 밖의 것은 가이드 「개인정보 및 AI 동의」에 스위치별로 적힌 대로만 기기를 떠납니다. 예를 들어 텔레메트리는 동의한 경우에만, 계정에 연결되어, 콘텐츠 없이 전송됩니다.",
  },
  {
    title: "우리가 하지 않는 것",
    body: "광고를 하지 않습니다. 데이터를 판매하지 않습니다. 직접 선택하지 않는 한 캔버스로 모델을 학습시키지 않습니다: AI 학습 데이터는 직접 켜기 전까지 꺼져 있습니다. 웹에서 당신을 추적하지 않습니다. 명시된 하위 처리자(하위 처리자 페이지에 게시) 외의 제3자에게 데이터를 넘기지 않습니다 — 모두 DPA에 따릅니다.",
  },
];
---

<BaseLayout
  title="보안 및 개인정보"
  description="암호화된 로컬 데이터베이스, 기본 GDPR, EU 서버, 애드테크 없음. Fluera의 보안 아키텍처와 데이터 소유에 대한 약속."
  locale="ko"
>
  <PageHero
    kicker="보안 및 개인정보"
    title="로컬에서 강력하게 암호화.<br />클라우드 동기화도 투명하게."
    titleSize="2xl"
    description="기본 암호화. 광고 기술 없음. EU 호스팅. 완전한 내보내기. 개인정보는 컴플라이언스 작업이 아닌 디자인 제약입니다."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">책임 있는 공개</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">무언가를 발견했습니까?</h2>
          <p class="prose-ink mb-6">
            보안 연구자를 환영합니다. 취약점은 <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>(으)로 신고해 주세요. 영업일 기준 5일 이내에 답변합니다. 버그 바운티 프로그램은 없습니다.
          </p>
          <p class="text-sm text-ink-500 italic">
            신고 규칙은 /.well-known/security.txt(RFC 9116)에도 게시되어 있습니다.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">컴플라이언스 및 배포</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">기관에 Fluera를 배포하나요?</h2>
          <p class="prose-ink mb-6">
            대학, 학교, 연구실: DPA 및 하위 처리자 목록을 안내해 드립니다. 파일럿은 일반적으로 한 클래스, 한 학기, 무료로 시작합니다.
          </p>
          <a href="/ko/contact" class="btn-primary">배포에 대해 상담 →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        이 페이지는 핵심 사항을 다룹니다. 전체 아키텍처와 하위 처리자 등록은
        <a href="/ko/security/architecture" class="text-paper-300 underline">/ko/security/architecture</a> 및
        <a href="/ko/security/sub-processors" class="text-paper-300 underline">/ko/security/sub-processors</a>에 있습니다. 특정 컴플라이언스 질문이 있나요?
        <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>로 작성하세요.
      </p>
    </div>
  </section>
</BaseLayout>
