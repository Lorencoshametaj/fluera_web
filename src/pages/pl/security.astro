---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const pillars = [
  {
    title: "Szyfrowanie",
    body: "Na twoim urządzeniu baza danych z twoimi canvasami jest szyfrowana w spoczynku przez sqlite3mc (ChaCha20-Poly1305, klucz 256-bitowy); zdjęcia, pliki PDF i nagrania z wykładów to pliki w prywatnym folderze aplikacji, chronione przez system operacyjny. Wyeksportowany plik .fluera nie jest szyfrowany; Zaszyfrowana kopia zapasowa jest zapieczętowana AES-256-GCM. Ruch idzie przez TLS. Cloud sync nie jest szyfrowany end-to-end: zsynchronizowane canvasy są przechowywane na infrastrukturze UE (Supabase, eu-north-1), szyfrowane w tranzycie i w spoczynku na poziomie infrastruktury. Jako administrator danych możemy technicznie uzyskać dostęp do zsynchronizowanych treści — ale nigdy ich nie sprzedajemy i nie używamy do reklam.",
  },
  {
    title: "Własność danych",
    body: "Każdy bajt, który napiszesz, możesz wyeksportować jednym kliknięciem: PNG, JPEG, WebP, SVG, PDF i nasz format .fluera. Twoje canvasy żyją najpierw na twoich urządzeniach. Chmura to wygoda, a nie więzienie — lock-in to model biznesowy, który odrzuciliśmy.",
  },
  {
    title: "GDPR-native",
    body: "Fluera jest hostowana w UE i GDPR-native. Umowa o przetwarzaniu danych dostępna na żądanie dla każdej instytucji edukacyjnej. Pełny eksport danych i prawo do bycia zapomnianym honorowane w ciągu 30 dni (zwykle w ciągu 48 godzin).",
  },
  {
    title: "Local-first, zawsze",
    body: "Możesz używać Fluera całkowicie offline. Synchronizacja między twoimi urządzeniami jest wyłączona, dopóki jej nie włączysz, i obejmuje całe twoje konto. Przy wyłączonej synchronizacji twoje canvasy zostają na urządzeniu. Reszta opuszcza je tylko tak, jak opisuje przewodnik Prywatność i zgoda na AI, przełącznik po przełączniku: telemetria na przykład tylko za twoją zgodą, powiązana z twoim kontem i nigdy z treścią.",
  },
  {
    title: "Czego nie robimy",
    body: "Nie wyświetlamy reklam. Nie sprzedajemy twoich danych. Nie trenujemy modeli na twoich canvasach, chyba że sam to wybierzesz: Dane treningowe AI są wyłączone, dopóki ich nie włączysz. Nie śledzimy cię w sieci. Nie przekazujemy danych osobom trzecim poza wymienionymi podmiotami przetwarzającymi (na stronie Podmioty przetwarzające) — wszystkie objęte umową powierzenia.",
  },
];
---

<BaseLayout
  title="Bezpieczeństwo i prywatność"
  description="Szyfrowana lokalna baza danych, RODO od podstaw, serwery w Europie, zero ad-tech. Architektura bezpieczeństwa Fluera i zobowiązanie, że twoje dane są twoje."
  locale="pl"
>
  <PageHero
    kicker="Bezpieczeństwo i prywatność"
    title="Szyfrowanie domyślnie.<br />Local-first od podstaw."
    titleSize="2xl"
    description="Szyfrowanie domyślnie. Brak ad-tech. Hosting w UE. Pełny eksport. Prywatność jest ograniczeniem projektowym, a nie zadaniem zgodności."
    orbs
    noise
  />

  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
        {pillars.map((p, i) => (
          <article class:list={["card p-8", { "md:col-span-2": pillars.length % 2 === 1 && i === pillars.length - 1 }]}>
            <div class="eyebrow text-accent-glow mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="font-serif text-xl text-paper-50 mb-3">{p.title}</h2>
            <p class="text-sm text-paper-200 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl">
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Odpowiedzialne ujawnianie</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Coś znalazłeś?</h2>
          <p class="prose-ink mb-6">
            Badacze bezpieczeństwa są tu mile widziani. Zgłaszaj podatności na <a href={`mailto:${SITE.company.securityEmail}`}>{SITE.company.securityEmail}</a>. Odpowiadamy w ciągu 5 dni roboczych. Nie mamy programu bug bounty.
          </p>
          <p class="text-sm text-ink-500 italic">
            Zasady zgłoszeń są też opublikowane w /.well-known/security.txt (RFC 9116).
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4 text-accent-glow">Zgodność i wdrożenie</p>
          <h2 class="font-serif text-display-lg text-paper-50 mb-4">Wdrażasz Fluerę w swojej instytucji?</h2>
          <p class="prose-ink mb-6">
            Uniwersytety, szkoły i laboratoria badawcze: opowiadamy o naszym DPA i liście podwykonawców. Pilotaże zwykle zaczynają się od jednej klasy, jednego semestru, bez opłat.
          </p>
          <a href="/pl/contact" class="btn-primary">Porozmawiaj o wdrożeniu →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04]">
    <div class="container-narrow text-center">
      <p class="text-xs text-ink-500 max-w-xl mx-auto leading-relaxed">
        Ta strona obejmuje podstawy. Pełna architektura i rejestr podwykonawców mieszkają na
        <a href="/pl/security/architecture" class="text-paper-300 underline">/pl/security/architecture</a> i
        <a href="/pl/security/sub-processors" class="text-paper-300 underline">/pl/security/sub-processors</a>. Konkretne pytania o zgodność?
        Napisz na <a href={`mailto:${SITE.company.securityEmail}`} class="text-paper-300 underline">{SITE.company.securityEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
