---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---

<BaseLayout
  title="Education case studies"
  description="We have not run a pilot yet. This page stays empty until one clears three conditions we wrote down in advance."
>

  <PageHero
    kicker="Case studies"
    title="No case studies yet.<br />That is the honest answer."
    description="We have not run a pilot. Rather than fill this page with something that reads like evidence and is not, here are the three conditions a pilot must clear before anything appears here — written down in advance so you can hold us to them."
    breadcrumb={{ label: "Education", href: "/education" }}
  />

  <section class="py-20 md:py-24 border-b border-white/[0.04]">
    <div class="container-site max-w-4xl">
      <div class="grid md:grid-cols-3 gap-4">
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">One full semester</h2>
          <p class="text-sm text-paper-300">
            Not a demo, not a two-week trial. A cohort uses Fluera for a whole term, exams included, before we write a word about it.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">The faculty signs off</h2>
          <p class="text-sm text-paper-300">
            The teacher reads what we wrote and approves it before it goes up. If they disagree with our reading of their term, it does not get published.
          </p>
        </article>
        <article class="card p-7">
          <h2 class="font-serif text-xl text-paper-100 mb-2">Numbers, anonymised and checked</h2>
          <p class="text-sm text-paper-300">
            Aggregate, anonymised, and reviewed for accuracy. No vendor-selected anecdotes, no quotes without the whole context.
          </p>
        </article>
      </div>

      <div class="mt-12 p-6 rounded-2xl border border-accent-ink/30 bg-accent-ink/[0.05] max-w-3xl">
        <h2 class="font-serif text-xl text-paper-50 mb-2">Want to be the first?</h2>
        <p class="text-sm text-paper-200 mb-4 leading-relaxed">
          We run one pilot per semester — one class, one term, no charge. In exchange we ask for structured feedback and the option to publish an anonymised case study at the end, under the three conditions above.
        </p>
        <a href="/contact/sales" class="btn-primary">Start a pilot conversation →</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-500 max-w-xl mx-auto">
        Why is this page empty? Because a case study with real numbers takes time to gather honestly — and publishing marketing-grade "case studies" based on vendor-selected anecdotes is the exact genre of content we do not want to produce. An empty page is the version of this page we can defend.
      </p>
    </div>
  </section>

</BaseLayout>
