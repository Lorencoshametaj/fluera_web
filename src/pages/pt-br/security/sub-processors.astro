---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/lib/site";

const processors = [
  {
    name: "Supabase Inc.",
    purpose: "Banco de dados, autenticação, storage cloud, colaboração em tempo real, Edge Functions como proxy de IA.",
    dataTypes: "E-mail da conta, ID do usuário hasheado, dados do canvas sincronizado (criptografados em trânsito por TLS e em repouso na infraestrutura da UE; não criptografados de ponta a ponta — o Fluera, como controlador de dados, pode acessá-los, mas nunca os vende nem os usa para publicidade), metadados de sincronização.",
    region: "Estocolmo, UE (eu-north-1) — produção. Dublin, UE (eu-west-1) — staging.",
    privacy: "https://supabase.com/privacy",
  },
  {
    name: "Google Cloud (Google Ireland Ltd.)",
    purpose: "Vertex AI (modelos Gemini) para Socratic Mode, Ghost Map, OCR de LaTeX e geração das exam sessions.",
    dataTypes: "Conteúdo selecionado do canvas, enviado apenas quando há consentimento para as funções de IA e estas são utilizadas — trechos de texto e imagens PNG renderizadas de regiões individuais de clusters de escrita à mão. Nunca o caderno inteiro. À parte, para a verificação automática de conteúdo ilegal e sem o consentimento às funções de IA: a miniatura, as imagens, o título e a descrição de um card que você envia ao catálogo ou compartilha em privado, e a foto de perfil de um criador.",
    region: "Exclusivamente União Europeia — endpoints do Vertex AI na UE: as regiões europe-west4 (Países Baixos) e europe-west1 (Bélgica), ou o endpoint multirregional da UE, que o Google limita aos Estados-membros da UE. Nenhuma transferência de conteúdo do canvas para fora da UE para a inferência de IA.",
    privacy: "https://cloud.google.com/terms/data-processing-addendum",
  },
  {
    name: "RevenueCat Inc.",
    purpose: "Gestão de assinaturas e validação de recibos das compras feitas na App Store e no Google Play (iOS, macOS, Android).",
    dataTypes: "ID pseudônimo da conta (o ID de usuário da conta Fluera, ou um ID anônimo do RevenueCat antes do login), status de assinatura, metadados de recibo. Enviados desde a abertura do app em iOS, macOS e Android, para gerenciar a assinatura. Nenhum dado de cartão.",
    region: "EUA; SCCs.",
    privacy: "https://www.revenuecat.com/privacy",
  },
  {
    name: "Functional Software Inc. (Sentry)",
    purpose: "Crash reporting e monitoramento de erros.",
    dataTypes: "Stack traces, versão do SO, modelo do dispositivo, versão do app. sendDefaultPii está explicitamente desabilitado e os endereços IP não são armazenados — nenhum conteúdo do usuário.",
    region: "União Europeia (Frankfurt) — o DSN de produção faz a ingestão na região de dados da UE do Sentry. A entidade operadora está constituída nos EUA; SCCs.",
    privacy: "https://sentry.io/privacy/",
  },
  {
    name: "Deno Land Inc.",
    purpose: "Hospedagem de share.fluera.dev: catálogo web, páginas das fichas, formulário de denúncia e conector do assistente de IA.",
    dataTypes: "Endereço IP e dados das requisições dos visitantes (logs técnicos). As denúncias enviadas pelo formulário passam por aqui até o Supabase. Sem cookies.",
    region: "Edge global; empresa sediada nos EUA. DPA incorporado aos termos do Deno Deploy; SCC.",
    privacy: "https://docs.deno.com/deploy/privacy_policy/",
  },
];

const lastUpdated = "2026-10-15";
// fluera.dev e' su GitHub Pages: GitHub non e' un sub-processor (titolare
// autonomo dei log delle visite, nessun DPA con un account gratuito).
const notaGithub = "O próprio fluera.dev é hospedado no GitHub Pages. A GitHub Inc. não é um suboperador: registra os dados técnicos das visitas (endereço IP, hora, página) para proteger o próprio serviço, como controladora independente e segundo a própria política de privacidade. O mesmo vale para as fontes que share.fluera.dev carrega de fluera.dev.";
// Apple e Google non sono sub-processor (informativa 1.8.6 §4,
// docs/processor_agreements.md): titolari autonomi per accesso e acquisti.
const notaAppleGoogle = "A Apple e o Google também não são suboperadores. No Sign in with Apple, no Sign in with Google e nas compras pela App Store e pelo Google Play, atuam como controladores independentes dos dados das próprias plataformas, segundo os próprios termos e políticas de privacidade.";
---

<BaseLayout
  title="Suboperadores"
  description="As terceiras partes sobre as quais o Fluera se apoia para entregar o produto. Finalidade, dados compartilhados, região e link para a política de privacidade de cada suboperador."
  locale="pt-br"
>
  <PageHero
    kicker="Suboperadores"
    title="Cada terceira parte sobre a qual nos apoiamos."
    description="Nos termos do art. 28 GDPR, todo suboperador que trata dados pessoais por nossa conta está listado aqui — o que compartilhamos, por quê e onde vive. Notificamos os clientes antes de qualquer mudança."
    breadcrumb={{ label: "Segurança", href: "/pt-br/security" }}
  >
    <p slot="copy" class="mt-6 text-sm text-ink-500 font-mono">Última atualização: {lastUpdated}</p>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="space-y-4 list-none p-0 max-w-5xl">
        {processors.map((p) => (
          <li class="card p-6 md:p-7">
            <div class="grid md:grid-cols-4 gap-6">
              <div class="md:col-span-1">
                <h2 class="font-serif text-xl text-paper-50 mb-2">{p.name}</h2>
                <a href={p.privacy} class="text-xs text-accent-glow underline underline-offset-4 font-mono" rel="noopener">
                  Política de privacidade ↗
                </a>
              </div>
              <dl class="md:col-span-3 grid gap-3 text-sm">
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Finalidade</dt>
                  <dd class="text-paper-200">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Dados compartilhados</dt>
                  <dd class="text-paper-200">{p.dataTypes}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-ink-500 mb-1">Região</dt>
                  <dd class="text-paper-200">{p.region}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="prose-ink text-sm mt-8 max-w-5xl">{notaGithub} <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">Política de privacidade do GitHub ↗</a></p>
      <p class="prose-ink text-sm mt-4 max-w-5xl">{notaAppleGoogle} <a href="https://www.apple.com/legal/privacy/" rel="noopener">Política de privacidade da Apple ↗</a> · <a href="https://policies.google.com/privacy" rel="noopener">Política de privacidade do Google ↗</a></p>
    </div>
  </section>

  <section class="py-16 border-t border-white/[0.04] bg-ink-900/40">
    <div class="container-narrow">
      <h2 class="font-serif text-xl text-paper-50 mb-4">Mudanças e notificações</h2>
      <p class="prose-ink text-sm mb-4">
        Atualizamos esta lista sempre que um suboperador é adicionado, alterado ou removido. Os clientes Institucionais e enterprise recebem notificação por e-mail com pelo menos 30 dias de antecedência da mudança, nos termos do art. 28(2) GDPR.
      </p>
      <p class="prose-ink text-sm">
        Para se inscrever nas notificações de mudança de suboperador, escreva para <a href={`mailto:${SITE.company.privacyEmail}`}>{SITE.company.privacyEmail}</a> a partir do endereço da sua conta.
      </p>
    </div>
  </section>
</BaseLayout>
