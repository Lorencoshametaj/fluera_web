---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PremiumHome from "@/components/PremiumHome.astro";
import { SITE } from "@/lib/site";
import home from "@/data/home/pt-br";
import pricing from "@/data/pricing/pt-br";
import copy from "@/data/homeCopy/pt-br";

const description = "Um canvas para aprender, não um app de notas. A Fluera transforma suas anotações à mão em um mapa vivo da graduação e te reestuda antes que a memória falhe.";
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: ["EducationalApplication", "ProductivityApplication"],
  operatingSystem: "iOS, iPadOS, Android, macOS, Windows, Linux, Web",
  description,
  url: `${SITE.url}/pt-br/`,
  audience: [
    { "@type": "EducationalAudience", educationalRole: "student" },
    { "@type": "Audience", audienceType: "knowledge worker" },
    { "@type": "EducationalAudience", educationalRole: "teacher" },
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
},
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Fluera",
    url: "https://fluera.dev/",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Fluera",
    url: "https://fluera.dev/",
    logo: "https://fluera.dev/press/logo-full.png",
    sameAs: ["https://github.com/Lorencoshametaj/fluera_engine"],
  },
];
---

<BaseLayout title="Fluera — o caderno digital que estuda você" description={description} jsonLd={jsonLd} locale="pt-br">
  <PremiumHome locale="pt-br" home={home} pricing={pricing} copy={copy} />
</BaseLayout>
