---
/**
 * LocaleBanner — non-intrusive banner that suggests switching to the user's
 * browser locale when it differs from the current page locale.
 *
 * Design: SSR-renders one hidden `<aside>` per available locale (each fully
 * pre-translated). A blocking script in Head reads navigator.languages BEFORE
 * first paint and stamps `<html data-lb="…">`; pure CSS then shows the right
 * variant and reserves its (constant) height, so the banner never shifts the
 * page. This keeps the page static, SEO-clean, and CLS-free.
 *
 * Pattern follows Apple/GitHub — visible suggestion, never auto-redirect.
 *
 * Dismissal is persisted in localStorage (key: "fluera.localeBanner.dismissed")
 * so the banner only appears once per visitor per ~30 days.
 *
 * To localize for a new locale: add the four "localeBanner.*" keys to the
 * locale's JSON file. The banner picks them up automatically.
 */
import { LOCALES, DEFAULT_LOCALE, t, localeFromPathname, type Locale } from "@/lib/i18n";
import { languageSwitchHref } from "@/lib/site";

export interface Props {
  /** Per-locale URLs of this page's real translations (see BaseLayout). When
   *  set, a locale without a translation offers its home page, not a 404. */
  alternates?: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentLocale = localeFromPathname(pathname);

// Pre-render one banner per *non-current* locale. Each banner contains the
// CTA, dismiss label, and language name in its own locale (so an Italian
// visitor on /es sees the prompt phrased in Italian, not Spanish).
const bannerVariants = LOCALES
  .filter((l) => l !== currentLocale)
  .map((l) => ({
    code: l,
    href: alternates
      ? (alternates[l] ?? (l === DEFAULT_LOCALE ? "/" : `/${l}/`))
      : languageSwitchHref(pathname, l),
    text: t("localeBanner.text", l).replace("{language}", t("localeBanner.languageName", l)),
    cta: t("localeBanner.cta", l).replace("{language}", t("localeBanner.languageName", l)),
    dismiss: t("localeBanner.dismiss", l),
  }));
const variantVisibilityCss = LOCALES
  .map((l) => `html[data-lb="${l}"] #locale-banner .locale-banner-variant[data-locale="${l}"]{display:flex !important}`)
  .join("\n");
---

<style is:global set:html={variantVisibilityCss}></style>

<aside
  id="locale-banner"
  hidden
  class="locale-banner-root fixed top-16 inset-x-0 z-40 border-b border-white/[0.08] bg-ink-900"
  data-current-locale={currentLocale}
>
  {bannerVariants.map((b) => (
    <div
      class="locale-banner-variant container-site h-full flex flex-nowrap items-center gap-x-4 text-sm"
      data-locale={b.code}
      hidden
    >
      <span class="text-paper-200 flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">{b.text}</span>
      <a
        href={b.href}
        class="text-accent-glow hover:text-paper-50 underline-offset-4 hover:underline font-medium shrink-0 whitespace-nowrap"
        data-banner-cta
      >
        {b.cta} →
      </a>
      <button
        type="button"
        class="text-paper-300 hover:text-paper-50 px-2 py-1 rounded-md text-xs shrink-0 whitespace-nowrap"
        data-banner-dismiss
        aria-label={b.dismiss}
      >
        {b.dismiss}
      </button>
    </div>
  ))}
</aside>

<style>
  /* Tailwind's `flex` utility wins over the HTML `hidden` attribute by
     specificity, so `<div class="flex" hidden>` would still render visible.
     Force `hidden` to win for elements inside the locale banner. */
  .locale-banner-root[hidden],
  .locale-banner-variant[hidden] {
    display: none !important;
  }

  /* Shift-free mechanics: the pre-paint script in Head stamps
     <html data-lb="…">, these rules show the banner AND reserve its space in
     the very first paint. The banner height is a constant (single-line row,
     message ellipsises) precisely so this reservation can be static — the old
     flow measured offsetHeight after load and pushed the page down by ~73px
     (a 0.09 layout shift for every cross-language visitor). */
  :global(html) { --lb-h: 3.25rem; }
  .locale-banner-root { height: var(--lb-h); }
  :global(html[data-lb]) .locale-banner-root[hidden] {
    display: block !important;
  }
  :global(html[data-lb] main#main-content) {
    padding-top: calc(4rem + var(--lb-h)) !important;
  }
  :global(html[data-lb] .docs-sidebar) {
    top: calc(4rem + var(--lb-h));
    height: calc(100vh - 4rem - var(--lb-h));
  }
  :global(html[data-lb] .docs-mobile-nav) {
    top: calc(4rem + var(--lb-h));
  }
</style>

<script is:inline>
  // Visibility and space reservation are handled pre-paint (Head stamps
  // <html data-lb>, CSS shows the matching variant). This script only makes
  // the semantics honest (clears `hidden` on what CSS already shows) and
  // wires dismissal. Removing data-lb shifts layout, but it is user-initiated
  // input, which CLS excludes.
  (() => {
    const STORAGE_KEY = "fluera.localeBanner.dismissed";
    const pref = document.documentElement.dataset.lb;
    const banner = document.getElementById("locale-banner");
    if (!pref || !banner) return;
    const variant = banner.querySelector(`.locale-banner-variant[data-locale="${CSS.escape(pref)}"]`);
    if (!variant) { delete document.documentElement.dataset.lb; return; }
    banner.hidden = false;
    variant.hidden = false;
    const store = () => {
      try { localStorage.setItem(STORAGE_KEY, new Date().toISOString()); } catch (e) {}
    };
    const dismissBtn = variant.querySelector("[data-banner-dismiss]");
    dismissBtn && dismissBtn.addEventListener("click", () => {
      store();
      banner.hidden = true;
      delete document.documentElement.dataset.lb;
    });
    const ctaLink = variant.querySelector("[data-banner-cta]");
    ctaLink && ctaLink.addEventListener("click", store);
  })();
</script>
