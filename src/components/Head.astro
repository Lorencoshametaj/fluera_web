---
import { SITE, languageSwitchHref } from "@/lib/site";
import { LOCALES, DEFAULT_LOCALE, type Locale } from "@/lib/i18n";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  canonical?: string;
  locale?: Locale;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Explicit hreflang alternates per locale (relative or absolute URLs). Used by
   * dynamic [slug].astro templates that know their localized counterparts via
   * content collection lookup. When absent, falls back to `languageSwitchHref()`
   * which routes to each locale's matching static page or homepage.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Run the pre-paint locale-banner decision (off for chromeless pages). */
  localeBannerBoot?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = "/og/default.png",
  noIndex = false,
  canonical,
  locale = "en",
  jsonLd,
  alternates,
  localeBannerBoot = true,
} = Astro.props;

// The locale banner must be decided BEFORE first paint: shown after load it
// pushes the whole page down (~0.09 CLS for every cross-language visitor).
// This blocking script stamps the preferred locale on <html data-lb="…">;
// CSS does the rest at first paint. Matching goes through ALL site locales:
// the visitor's best-matching language wins, and when that IS the page's
// locale no banner shows (the old variant-list matching skipped the current
// locale, so an Italian browser on the Italian page got offered English).
const bannerBootLocales = LOCALES;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const fullTitle = title === SITE.name ? SITE.name : `${title} — ${SITE.name}`;

const jsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

// og:locale maps to a BCP 47 territory tag — needed by Facebook/LinkedIn parsers.
const OG_LOCALE: Record<Locale, string> = {
  en: "en_US", it: "it_IT", es: "es_ES", "pt-br": "pt_BR",
  fr: "fr_FR", de: "de_DE", ja: "ja_JP", ko: "ko_KR",
  hi: "hi_IN", ar: "ar_SA", pl: "pl_PL", nl: "nl_NL",
  sv: "sv_SE", da: "da_DK", no: "nb_NO", fi: "fi_FI",
};

// hreflang code = BCP 47 (Google requires region casing: pt-BR not pt-br).
const HREFLANG_CODE: Record<Locale, string> = {
  en: "en", it: "it", es: "es", "pt-br": "pt-BR",
  fr: "fr", de: "de", ja: "ja", ko: "ko",
  hi: "hi", ar: "ar", pl: "pl", nl: "nl",
  sv: "sv", da: "da", no: "no", fi: "fi",
};

// Build hreflang alternates + x-default (= EN root).
// Two regimes, and they must not mix:
//  - No explicit map: the page exists in every locale (static mirrored pages),
//    so languageSwitchHref() prefix-swaps the current path for all 16.
//  - Explicit map: the page KNOWS which translations exist (content lookup).
//    Locales absent from the map have no translation — emitting a prefix-swapped
//    URL for them advertises a 404 to search engines, so they are omitted.
// Alternate URLs must name the page's final form (…/path/), not the 301 that
// leads there — the canonical and the sitemap already carry the slash.
const withSlash = (p: string) => (p.endsWith("/") || /\.[a-z0-9]+$/i.test(p) ? p : `${p}/`);
const hreflangLinks = LOCALES.flatMap((loc) => {
  const path = alternates
    ? alternates[loc]
    : languageSwitchHref(Astro.url.pathname, loc);
  if (!path) return [];
  return [{
    code: HREFLANG_CODE[loc],
    href: new URL(withSlash(path), SITE.url).toString(),
  }];
});
const xDefaultHref = new URL(
  withSlash(
    alternates
      ? (alternates[DEFAULT_LOCALE] ?? "/")
      : languageSwitchHref(Astro.url.pathname, DEFAULT_LOCALE),
  ),
  SITE.url,
).toString();

// Plausible analytics — opt-in via env var. The "outbound-links + tagged-events"
// script gives us automatic outbound link tracking PLUS support for custom events
// triggered by `class="plausible-event-name=Foo+Bar"` on any element. ~1KB extra.
// Setup: add `PUBLIC_PLAUSIBLE_DOMAIN=fluera.dev` to .env once Plausible account
// is provisioned. Without env var, no script is emitted (zero impact, GDPR-safe).
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC
  ?? "https://plausible.io/js/script.outbound-links.tagged-events.js";
const plausibleOrigin = plausibleDomain ? (() => {
  try {
    return new URL(plausibleSrc).origin;
  } catch {
    return null;
  }
})() : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- Theme init (anti-FOUC): apply saved or OS-preferred theme before first paint -->
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem("theme");
      if (t !== "light" && t !== "dark") {
        t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      }
      if (t === "light") document.documentElement.classList.add("light");
    } catch (e) {}
  })();
</script>

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{/* hreflang alternates — one per locale + x-default. Google uses these to
    serve the right localized URL in SERPs based on user's language settings.
    Both HTML head AND sitemap.xml emit hreflang; Google reads both. */}
{hreflangLinks.map((h) => (
  <link rel="alternate" hreflang={h.code} href={h.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={OG_LOCALE[locale] ?? "en_US"} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={`@${SITE.company.twitter}`} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<meta name="theme-color" content="#151517" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="color-scheme" content="dark light" />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{/* Every page's LCP is a display headline set in these two faces: preloading
    them removes the swap flash without blocking render (font-display: swap). */}
<link rel="preload" href="/fonts/Sora-Bold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/PlayfairDisplay-SemiBoldItalic.woff2" as="font" type="font/woff2" crossorigin />

{localeBannerBoot && (
  <script is:inline define:vars={{ current: locale, avail: bannerBootLocales }}>
    (() => {
      try {
        const raw = localStorage.getItem("fluera.localeBanner.dismissed");
        if (raw && (Date.now() - new Date(raw).getTime()) / 864e5 < 30) return;
      } catch (e) { /* private browsing: show the banner */ }
      const langs = (navigator.languages || [navigator.language || "en"])
        .map((l) => (l || "").toLowerCase());
      for (const nl of langs) {
        const hit = avail.includes(nl) ? nl : (avail.includes(nl.split("-")[0]) ? nl.split("-")[0] : null);
        if (hit) {
          // First match decides: if it IS this page's locale, no banner.
          if (hit !== current) document.documentElement.dataset.lb = hit;
          return;
        }
      }
    })();
  </script>
)}

{plausibleOrigin && (
  <>
    <link rel="dns-prefetch" href={plausibleOrigin} />
    <link rel="preconnect" href={plausibleOrigin} crossorigin />
  </>
)}
{jsonLdArray.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}

{plausibleDomain && (
  <script
    is:inline
    defer
    data-domain={plausibleDomain}
    src={plausibleSrc}
  />
)}
