---
import ProductVisual from "@/components/ProductVisual.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { baseFeatureSlug, featureVisualKind } from "@/lib/features";
import { t, type Locale } from "@/lib/i18n";
import { featureSeo } from "@/lib/seo-templates";
import { localizedHref } from "@/lib/site";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";

export interface Props {
  feature: CollectionEntry<"features">;
  locale: Locale;
}

type FeatureDetailCopy = {
  step: string;
  cycle: string;
  scienceKicker: string;
  scienceTitle: string;
  authorsKicker: string;
  authorsTitle: string;
  betaTitle: string;
  betaBody: string;
  platformAssurance: string;
};

const COPY = {
  en: {
    step: "Step", cycle: "The cycle",
    scienceKicker: "The science behind it", scienceTitle: "Principles this feature is built on.",
    authorsKicker: "Whose work", authorsTitle: "The minds behind the evidence.",
    betaTitle: "Try it in the beta.",
    betaBody: "Request access on any platform. The client labels describe maturity; they do not limit who can join the beta.",
    platformAssurance: "Access open across every platform",
  },
  it: {
    step: "Passo", cycle: "Il ciclo",
    scienceKicker: "La scienza dietro", scienceTitle: "Principi su cui poggia questa funzione.",
    authorsKicker: "Chi c’è dietro", authorsTitle: "Le menti dietro l’evidenza.",
    betaTitle: "Provalo nella beta.",
    betaBody: "Richiedi l’accesso da qualsiasi piattaforma. Le etichette dei client ne descrivono la maturità, non limitano chi può entrare nella beta.",
    platformAssurance: "Accesso aperto su tutte le piattaforme",
  },
  es: {
    step: "Paso", cycle: "El ciclo",
    scienceKicker: "La ciencia detrás", scienceTitle: "Principios sobre los que se apoya esta función.",
    authorsKicker: "Quién está detrás", authorsTitle: "Las mentes detrás de la evidencia.",
    betaTitle: "Pruébalo en la beta.",
