  metaTitle: string;
  metaDescription: string;
  kicker: string;
  status: string;
  title: string;
  body: string;
  /** Il contatore di Mentore, come lo mostra l'app: percentuale del mese. */
  meterKicker: string;
  meterExample: string;
  meterLabel: string;
  meterValue: string;
  meterLeft: string;
  meterPace: string;
  meterRefill: string;
  meterNote: string;
  plansKicker: string;
  plansTitle: string;
  everywhere: string;
  included: string;
  request: string;
  betaNote: string;
