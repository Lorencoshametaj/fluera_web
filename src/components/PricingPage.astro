    faqKicker: "Tydliga svar",
    faqTitle: "Innan du väljer.",
  },
  da: {
    metaTitle: "Priser",
    metaDescription: "Fluera gratis, Fluera Overalt, Fluera Mentor og Overalt + Mentor: klare priser, 14 dages prøve på Mentor og en tæller, der altid er synlig.",
    kicker: "Gennemsigtige priser",
    status: "Privat beta · Planlagte priser",
    title: "To abonnementer.<br />Tag kun det, du bruger.",
    body: "Canvas, repetition og kurser er gratis. Overalt bringer alt til hver enhed, Mentor læser det, du skriver, og hjælper dig med at lære det: vælg dem hver for sig eller sammen, og se altid, hvor meget Mentor du har tilbage.",
    meterKicker: "Mentor-tælleren",
    meterExample: "Eksempel",
    meterLabel: "Månedens Mentor",
    meterValue: "72 %",
    meterLeft: "tilbage",
    meterPace: "I dit tempo rækker den måneden ud.",
    meterRefill: "Fyldes op den 1. i måneden.",
    meterNote: "Altid synlig i appen. Ingen skjulte grænser.",
    plansKicker: "Planerne",
    plansTitle: "Overalt og Mentor, hver for sig eller sammen.",
    everywhere: "Køb én gang, det gælder på alle dine enheder.",
    included: "Inkluderet",
    request: "Anmod om adgang",
    betaNote: "Det er Flueras planlagte offentlige priser, i euro inklusive moms; uden for euroområdet gælder prisen, som butikken viser. Under betaen åbnes adgangen i kohorter; købsvilkårene vises, før et abonnement bekræftes.",
    faqKicker: "Klare svar",
    faqTitle: "Før du vælger.",
  },
  no: {
    metaTitle: "Priser",
    metaDescription: "Fluera gratis, Fluera Overalt, Fluera Mentor og Overalt + Mentor: tydelige priser, 14 dagers prøve på Mentor og en teller som alltid er synlig.",
    kicker: "Tydelige priser",
    status: "Privat beta · Planlagte priser",
    title: "To abonnementer.<br />Ta bare det du bruker.",
    body: "Canvas, repetisjon og kurs er gratis. Overalt tar alt med til hver enhet, Mentor leser det du skriver og hjelper deg å lære det: velg dem hver for seg eller sammen, og se alltid hvor mye Mentor du har igjen.",
    meterKicker: "Mentor-telleren",
    meterExample: "Eksempel",
    meterLabel: "Månedens Mentor",
    meterValue: "72 %",
    meterLeft: "igjen",
    meterPace: "I ditt tempo holder den ut måneden.",
    meterRefill: "Fylles på den 1. hver måned.",
    meterNote: "Alltid synlig i appen. Ingen skjulte grenser.",
    plansKicker: "Planene",
    plansTitle: "Overalt og Mentor, hver for seg eller sammen.",
    everywhere: "Kjøp én gang, det gjelder på alle enhetene dine.",
    included: "Inkludert",
    request: "Be om tilgang",
    betaNote: "Dette er Flueras planlagte offentlige priser, i euro inkludert mva.; utenfor euroområdet gjelder prisen butikken viser. Under betaen åpnes tilgangen i kohorter; kjøpsvilkårene vises før et abonnement bekreftes.",
    faqKicker: "Tydelige svar",
    faqTitle: "Før du velger.",
  },
  fi: {
    metaTitle: "Hinnoittelu",
    metaDescription: "Fluera ilmaiseksi, Fluera Kaikkialla, Fluera Mentori ja Kaikkialla + Mentori: selkeät hinnat, 14 päivän kokeilu Mentorissa ja aina näkyvä laskuri.",
    kicker: "Läpinäkyvä hinnoittelu",
    status: "Yksityinen beta · Suunnitellut hinnat",
    title: "Kaksi tilausta.<br />Ota vain se, mitä käytät.",
    body: "Canvas, kertaus ja kurssit ovat ilmaisia. Kaikkialla tuo kaiken jokaiselle laitteelle, Mentori lukee kirjoittamasi ja auttaa opiskelemaan sen: valitse ne erikseen tai yhdessä, ja näe aina, paljonko Mentoria on jäljellä.",
    meterKicker: "Mentorin laskuri",
    meterExample: "Esimerkki",
    meterLabel: "Kuukauden Mentori",
    meterValue: "72 %",
    meterLeft: "jäljellä",
    meterPace: "Tahdillasi se riittää kuun loppuun.",
    meterRefill: "Täyttyy kuukauden 1. päivänä.",
    meterNote: "Aina näkyvissä sovelluksessa. Ei piilotettuja rajoja.",
    plansKicker: "Tilaukset",
    plansTitle: "Kaikkialla ja Mentori, erikseen tai yhdessä.",
    everywhere: "Osta kerran, se toimii kaikilla laitteillasi.",
    included: "Sisältää",
    request: "Pyydä käyttöoikeutta",
    betaNote: "Nämä ovat Flueran suunnitellut julkiset hinnat, euroina ja arvonlisäveroineen; euroalueen ulkopuolella pätee kaupan näyttämä hinta. Betan aikana käyttö avautuu kohortteina; ostoehdot näytetään ennen minkään tilauksen vahvistamista.",
    faqKicker: "Selkeät vastaukset",
    faqTitle: "Ennen valintaa.",
  },
};

const { locale, pricing } = Astro.props;
const copy = COPY[locale];
const { tiers, faq } = pricing;
const arrow = locale === "ar" ? "←" : "→";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  locale={locale}
  jsonLd={jsonLd}
>
  <section class="pricing-hero border-b border-white/[0.06]">
    <div class="container-site pricing-hero-grid py-20 md:py-28">
      <div class="pricing-hero-copy">
        <div class="pricing-status"><span></span>{copy.status}</div>
        <p class="eyebrow text-accent-glow mb-6">{copy.kicker}</p>
        <h1 class="text-display-2xl text-paper-50 mb-6" set:html={copy.title} />
        <p class="prose-ink text-lg md:text-xl max-w-2xl">{copy.body}</p>
      </div>

      <figure class="pricing-continuum">
        <div class="continuum-heading">
          <span>{copy.meterKicker}</span>
          <em>{copy.meterExample}</em>
        </div>
        <svg viewBox="0 0 720 250" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <pattern id={`pricing-dots-${locale}`} width="18" height="18" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1" class="pricing-dot" />
            </pattern>
          </defs>
          <rect width="720" height="250" fill={`url(#pricing-dots-${locale})`} />
          <path class="contour contour-a" d="M-24 207C87 111 183 157 254 92s167-43 225 13 136 67 268-35" />
          <path class="contour contour-b" d="M-31 229C78 151 194 198 276 133s151-45 216 5 138 59 258-12" />
        </svg>
        <div class="ai-meter">
          <p class="ai-meter-label">{copy.meterLabel}</p>
          <p class="ai-meter-value"><strong>{copy.meterValue}</strong> <span>{copy.meterLeft}</span></p>
          <div class="ai-meter-bar" role="presentation"><span style={`--fill:${METER_FILL}%`}></span></div>
          <p class="ai-meter-pace">{copy.meterPace}</p>
          <p class="ai-meter-refill">{copy.meterRefill}</p>
        </div>
        <figcaption class="ai-meter-note">{copy.meterNote}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section pricing-plans-section">
    <div class="container-site">
      <div class="pricing-section-intro">
        <div>
          <p class="eyebrow text-accent-glow mb-5">{copy.plansKicker}</p>
          <h2 class="text-display-xl text-paper-50">{copy.plansTitle}</h2>
        </div>
        <div class="pricing-intro-side">
          <p class="pricing-everywhere">{copy.everywhere}</p>
          <p class="pricing-beta-note">{copy.betaNote}</p>
        </div>
      </div>

      <div class="pricing-grid mt-14">
        {tiers.map((tier, index) => (
          <article class:list={["pricing-plan", tier.highlighted && "is-highlighted"]} data-tier={tier.id}>
            <header class="plan-header">
              <span class="plan-index">{String(index + 1).padStart(2, "0")}</span>
              <div class="plan-name-row">
                <h2>{tier.name}</h2>
                {tier.badge && <span class="plan-badge">{tier.badge}</span>}
              </div>
              <div class="plan-price">
                <strong>{tier.price}</strong>
                <span>{tier.period}</span>
              </div>
              <p>{tier.tagline}</p>
            </header>

            <div class="plan-features">
              <p class="eyebrow">{copy.included}</p>
              <ul>
                {tier.features.map((feature) => (
                  <li>
                    <svg viewBox="0 0 18 18" aria-hidden="true"><path d="m4 9.5 3.1 3L14 5.8" /></svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a href={localizedHref(tier.cta.href, locale)} class={tier.highlighted ? "btn-primary plan-cta" : "btn-secondary plan-cta"}>
              {copy.request} <span aria-hidden="true">{arrow}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section pricing-faq border-t border-white/[0.06] bg-ink-900/40">
    <div class="container-site faq-grid">
      <div class="faq-heading">
        <p class="eyebrow text-accent-glow mb-5">{copy.faqKicker}</p>
        <h2 class="text-display-lg text-paper-50">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {faq.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{item.q}</span>
              <i aria-hidden="true"></i>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <style>
    .pricing-hero { position:relative;overflow:hidden; }
    .pricing-hero::before { content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,rgb(91 141 239 / .12) .7px,transparent .8px);background-size:25px 25px;mask-image:linear-gradient(105deg,transparent 8%,#000 60%,transparent 95%);opacity:.35; }
    .pricing-hero-grid { position:relative;display:grid;gap:clamp(42px,8vw,96px);align-items:center; }
    .pricing-hero-copy h1 { max-width:800px;letter-spacing:-.055em; }
    .pricing-status { display:inline-flex;align-items:center;gap:9px;margin-bottom:24px;padding:7px 10px;color:var(--muted-fg);border:1px solid rgb(91 141 239 / .24);border-radius:8px;background:rgb(37 99 235 / .07);font-size:.72rem;font-weight:600; }
    .pricing-status span { width:6px;height:6px;border-radius:50%;background:theme("colors.accent.glow");box-shadow:0 0 0 4px rgb(91 141 239 / .1); }

    .pricing-continuum { position:relative;min-height:360px;margin:0;overflow:hidden;border:1px solid rgb(255 255 255 / .09);border-radius:18px;background:#221e16;box-shadow:0 28px 75px rgb(0 0 0 / .25);isolation:isolate; }
    .continuum-heading { position:absolute;z-index:3;top:21px;inset-inline:22px;display:flex;align-items:center;justify-content:space-between;color:#f2ece0; }
    .continuum-heading span { padding-inline-start:11px;border-inline-start:2px solid #5b8def;font-size:.78rem;font-weight:650; }
    .pricing-continuum>svg { position:absolute;inset:62px 0 0;width:100%;height:calc(100% - 62px); }
    .continuum-heading em { padding:4px 8px;color:#a79e8a;border:1px solid rgb(229 222 206 / .16);border-radius:6px;font-size:.62rem;font-style:normal;font-weight:600; }
    .pricing-dot { fill:rgb(229 222 206 / .11); }
    .contour { fill:none;stroke:rgb(91 141 239 / .14);stroke-width:1.2;stroke-dasharray:4 8; }
    .contour-b { stroke:rgb(229 222 206 / .1); }
    .ai-meter { position:relative;z-index:2;width:min(340px,calc(100% - 44px));margin:96px auto 0;padding:22px 22px 20px;color:#f2ece0;border:1px solid rgb(229 222 206 / .14);border-radius:14px;background:#221e16;box-shadow:0 18px 45px rgb(0 0 0 / .28); }
    .ai-meter p { margin:0; }
    .ai-meter-label { color:#a79e8a;font-size:.72rem;font-weight:600; }
    .ai-meter-value { display:flex;align-items:baseline;gap:8px;margin-top:10px !important; }
    .ai-meter-value strong { font-size:clamp(2.4rem,6vw,3.2rem);font-weight:650;letter-spacing:-.05em;line-height:1; }
    .ai-meter-value span { color:#a79e8a;font-size:.85rem; }
    .ai-meter-bar { height:6px;margin-top:16px;overflow:hidden;border-radius:99px;background:rgb(229 222 206 / .1); }
    .ai-meter-bar span { display:block;width:var(--fill);height:100%;border-radius:inherit;background:linear-gradient(90deg,#2563eb,#5b8def); }
    .ai-meter-pace { margin-top:14px !important;font-size:.8rem;line-height:1.5; }
    .ai-meter-refill { margin-top:4px !important;color:#a79e8a;font-size:.72rem; }
    .ai-meter-note { position:relative;z-index:2;margin:18px 22px 22px;color:#a79e8a;font-size:.74rem;text-align:center; }

    .pricing-section-intro { display:grid;gap:26px;align-items:end; }
    .pricing-section-intro h2 { max-width:760px; }
    .pricing-intro-side { display:flex;flex-direction:column;gap:12px;max-width:520px; }
    .pricing-everywhere { color:var(--body-fg);font-size:1rem;font-weight:600;line-height:1.5; }
    .pricing-beta-note { max-width:520px;color:var(--dim-fg);font-size:.78rem;line-height:1.7; }
    .pricing-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;align-items:stretch; }
    .pricing-plan { position:relative;display:flex;flex-direction:column;min-width:0;padding:clamp(22px,3vw,30px);overflow:hidden;border:1px solid rgb(255 255 255 / .09);border-radius:16px;background:theme("colors.ink.900"); }
    .pricing-plan.is-highlighted { border-color:rgb(91 141 239 / .42);box-shadow:inset 0 2px 0 theme("colors.accent.ink"),0 22px 55px rgb(0 0 0 / .12); }
    .plan-index { display:block;margin-bottom:22px;color:var(--dim-fg);font:650 .63rem/1 ui-monospace,monospace;letter-spacing:.14em; }
    .plan-name-row { display:flex;align-items:center;justify-content:space-between;gap:12px; }
    .plan-name-row h2 { color:var(--body-fg);font-size:1.35rem; }
    .plan-badge { padding:5px 8px;color:theme("colors.accent.glow");border:1px solid rgb(91 141 239 / .3);border-radius:6px;background:rgb(37 99 235 / .09);font-size:.62rem;font-weight:650;white-space:nowrap; }
    .plan-price { margin-top:28px; }
    .plan-price strong { display:block;color:var(--body-fg);font-size:clamp(2.2rem,4vw,3.2rem);font-weight:650;letter-spacing:-.06em;line-height:1; }
    .plan-price span { display:block;min-height:34px;margin-top:7px;color:var(--dim-fg);font-size:.68rem;line-height:1.45; }
    .plan-header>p { min-height:68px;margin-top:20px;color:var(--muted-fg);font-size:.83rem;line-height:1.65; }
    .plan-features { flex:1;margin-top:25px;padding-top:20px;border-top:1px solid rgb(255 255 255 / .07); }
    .plan-features>.eyebrow { margin-bottom:17px;color:var(--dim-fg);font-size:.6rem; }
    .plan-features ul { display:flex;flex-direction:column;gap:12px;margin:0;padding:0;list-style:none; }
    .plan-features li { display:grid;grid-template-columns:16px 1fr;gap:9px;color:var(--muted-fg);font-size:.75rem;line-height:1.55; }
    .plan-features svg { width:15px;height:15px;margin-top:1px;fill:none;stroke:theme("colors.accent.glow");stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round; }
    .plan-cta { width:100%;margin-top:28px; }

    .faq-grid { display:grid;gap:48px;align-items:start; }
    .faq-heading { position:sticky;top:100px; }
    .faq-list { border-top:1px solid rgb(255 255 255 / .08); }
    .faq-item { border-bottom:1px solid rgb(255 255 255 / .08); }
    .faq-item summary { display:flex;align-items:flex-start;justify-content:space-between;gap:28px;padding:22px 0;color:var(--body-fg);cursor:pointer;font-size:1rem;font-weight:600;list-style:none; }
    .faq-item summary::-webkit-details-marker { display:none; }
    .faq-item summary i { position:relative;width:16px;height:16px;margin-top:3px;flex:none; }
    .faq-item summary i::before,.faq-item summary i::after { content:"";position:absolute;inset-inline-start:0;top:7px;width:16px;height:1px;background:var(--dim-fg);transition:transform .18s ease; }
    .faq-item summary i::after { transform:rotate(90deg); }.faq-item[open] summary i::after{transform:rotate(0)}
    .faq-item>p { max-width:720px;padding-block:0 22px;padding-inline-end:42px;color:var(--muted-fg);font-size:.85rem;line-height:1.75; }

    @media(min-width:900px){.pricing-hero-grid{grid-template-columns:minmax(0,.9fr) minmax(480px,1.1fr)}.pricing-section-intro{grid-template-columns:1.1fr .9fr}.faq-grid{grid-template-columns:minmax(220px,.65fr) minmax(0,1.35fr)}}
    @media(max-width:1199px){.pricing-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:699px){.pricing-grid{grid-template-columns:1fr}}
    @media(max-width:899px){.plan-header>p{min-height:0}.pricing-plan{max-width:680px;width:100%;margin-inline:auto}.faq-heading{position:static}}
    @media(max-width:560px){.pricing-continuum{min-height:0}.ai-meter{margin-top:78px}.pricing-section-intro h2{font-size:clamp(2rem,11vw,3.2rem)}}

    /* accent.glow on the badge's own light tint is 2.85:1 — under the 4.5:1 AA
       floor at this size. #1d4ed8 is the site's light-theme blue. */
    :global(html.light) .plan-badge { color:#1d4ed8; }
    :global(html.light) .pricing-continuum { background:#faf8f2;border-color:rgb(61 54 41 / .13);box-shadow:0 24px 60px rgb(49 43 31 / .13); }
    :global(html.light) .continuum-heading,:global(html.light) .ai-meter { color:#23211b; }
    :global(html.light) .continuum-heading em,:global(html.light) .ai-meter-label,:global(html.light) .ai-meter-value span,:global(html.light) .ai-meter-refill,:global(html.light) .ai-meter-note { color:#6e6656; }
    :global(html.light) .ai-meter { border-color:rgb(61 54 41 / .14);background:rgb(255 253 248 / .96);box-shadow:0 12px 35px rgb(49 43 31 / .11); }
    :global(html.light) .ai-meter-bar { background:rgb(61 54 41 / .1); }
    :global(html.light) .plan-features { border-color:rgb(0 0 0 / .09); }
    :global(html.light) .pricing-dot { fill:rgb(110 102 86 / .12); }
    :global(html.light) .pricing-plan,:global(html.light) .faq-list,:global(html.light) .faq-item { border-color:rgb(0 0 0 / .09); }
    :global(html.light) .pricing-plan { background:#fff; }
    /* Column-sized type, appended last so it beats earlier media queries:
     the h1 tracks its own column via cqw instead of the viewport, which
     put desktop-scale type in a ~450px grid share (one word per line). */
  .pricing-hero-copy{container-type:inline-size}
  .pricing-hero-copy h1{font-size:clamp(2.5rem,10.5cqw,5rem)}
</style>
</BaseLayout>
