---
export interface Props {
  label: string;
  title: string;
  description: string;
  citation: string;
  href: string;
  status?: "stable" | "beta" | "coming-soon";
  reverse?: boolean;
  visual?: "ghost" | "socratic" | "fog" | "exam" | "canvas" | "atlas";
}
import ProductVisual, { type VisualKind } from "@/components/ProductVisual.astro";
import { localeFromPathname, t } from "@/lib/i18n";
import { localizedHref } from "@/lib/site";

const { label, title, description, citation, href, status = "beta", reverse = false, visual } = Astro.props;
const locale = localeFromPathname(Astro.url.pathname);
const normalized = `${label} ${title}`.toLowerCase();
const inferredVisual: VisualKind = visual
  ?? (normalized.includes("ghost") ? "ghost"
    : normalized.includes("socrat") ? "socratic"
      : normalized.includes("fog") ? "fog"
        : normalized.includes("exam") ? "exam"
          : normalized.includes("atlas") ? "atlas"
            : "canvas");
const statusKey = status === "stable" ? "status.available" : status === "coming-soon" ? "status.comingSoon" : "status.beta";
const localizedTarget = localizedHref(href, locale);
---

<article class={`grid md:grid-cols-2 gap-8 md:gap-16 items-center ${reverse ? "md:[&>*:first-child]:order-2" : ""}`}>
  <div class="order-2 md:order-none">
    <div class="eyebrow mb-3 text-accent-glow">{label}</div>
    <h3 class="font-serif text-display-lg text-paper-50 mb-5">{title}</h3>
    <p class="prose-ink mb-4">{description}</p>
    <p class="text-sm text-ink-500 italic mb-6">{citation}</p>
    <div class="flex items-center gap-4 flex-wrap">
      <a href={localizedTarget} class="btn-secondary">{t("cta.tryInBeta", locale)}</a>
      <span class="pill text-[11px]">{t(statusKey, locale)}</span>
    </div>
  </div>

  <div class="order-1 md:order-none">
    <ProductVisual
      kind={inferredVisual}
      slot={`home-${inferredVisual}-loop`}
      label={`${label}: ${title}`}
    />
  </div>
</article>
