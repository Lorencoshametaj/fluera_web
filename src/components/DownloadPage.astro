const { locale } = Astro.props;
const copy = COPY[locale];
const href = (path: string) => localizedHref(path, locale);
const platforms = [
  { name: "iOS / iPadOS", stage: "beta" },
  { name: "macOS", stage: "beta" },
  { name: "Android", stage: "alpha" },
  { name: "Windows", stage: "alpha" },
  { name: "Linux", stage: "alpha" },
  { name: "Web", stage: "demo" },
] as const;
const stageCopy = {
  beta: { label: copy.beta, note: copy.betaNote },
  alpha: { label: copy.alpha, note: copy.alphaNote },
  demo: { label: copy.demo, note: copy.demoNote },
};
