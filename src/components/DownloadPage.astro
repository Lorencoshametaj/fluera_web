<BaseLayout title={copy.metaTitle} description={copy.description} locale={locale} bodyClass="premium-page">
  <div>
    <section class="download-hero">
      <div class="container-site download-hero-grid">
        <div class="download-copy">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 set:html={copy.title} />
          <p class="download-description">{copy.description}</p>
          <div class="download-actions">
            <a href={href("/beta")} class="btn-primary">{copy.cta} <span aria-hidden="true">→</span></a>
            <span><i></i>{copy.access}</span>
          </div>
        </div>

        <figure class="continuity-map">
          <div class="map-meta"><span>FLUERA</span><b>{copy.sameCanvas}</b></div>
          <svg viewBox="0 0 640 390" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
