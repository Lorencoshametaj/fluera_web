            <path class="territory territory-b" d="M74 312c41-97 121-133 199-86s143 37 217-39 114-53 145-17" />
            <path class="canvas-shadow" d="M-12 251C67 246 96 136 178 145s95 91 176 44 119-129 301-73" />
            <path class="canvas-thread" d="M-12 251C67 246 96 136 178 145s95 91 176 44 119-129 301-73" />
            <g class="nodes">
              <circle cx="65" cy="238" r="7" /><circle cx="178" cy="145" r="7" />
