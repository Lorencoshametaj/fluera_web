---
export interface DocLink {
  title: string;
  href: string;
  current?: boolean;
}

export interface DocSection {
  label: string;
  slug: string;
  links: DocLink[];
}

export interface Props {
  sections: DocSection[];
  rootHref: string;
  rootLabel: string;
}

const { sections, rootHref, rootLabel } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<aside class="docs-sidebar" aria-label={rootLabel}>
  <div class="docs-root">
    <a href={rootHref}>
      <span class="docs-root-mark" aria-hidden="true">
        <svg viewBox="0 0 34 34"><path d="M3 25c6-1 7-10 14-9s7 7 14 2"/><circle cx="17" cy="16" r="2.5"/></svg>
      </span>
      <span><small>FLUERA / GUIDE</small><strong>{rootLabel}</strong></span>
    </a>
  </div>

  <nav class="docs-nav">
    {sections.map((sec) => (
      <div class="docs-group">
        <p>{sec.label}</p>
        <ul>
          {sec.links.map((link) => {
            const isActive = currentPath === link.href.replace(/\/$/, "");
            return (
              <li>
                <a
                  href={link.href}
                  class:list={["docs-link", isActive && "is-active"]}
                  aria-current={isActive ? "page" : undefined}
                >
                  <i aria-hidden="true"></i>
                  {link.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  .docs-sidebar {
    position: sticky;
    top: 4rem;
    height: calc(100vh - 4rem);
    overflow-y: auto;
    border-inline-end: 1px solid var(--hairline);
    background:color-mix(in srgb,var(--body-bg) 97%,var(--body-fg));
    scrollbar-width:thin;
    scrollbar-color:var(--hairline-strong) transparent;
  }
  .docs-root{padding:1.4rem 1.25rem;border-bottom:1px solid var(--hairline)}
  .docs-root>a{display:flex;align-items:center;gap:.8rem;color:var(--body-fg)}
  .docs-root-mark{display:grid;width:34px;height:34px;flex:none;place-items:center;border:1px solid rgb(37 99 235/.25);border-radius:9px;background:rgb(37 99 235/.07);color:#2563eb}
  .docs-root-mark svg{width:27px;height:27px}.docs-root-mark path{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}.docs-root-mark circle{fill:var(--body-bg);stroke:currentColor;stroke-width:1.5}
  .docs-root a>span:last-child{display:flex;min-width:0;flex-direction:column;gap:.25rem}.docs-root small{color:#5b8def;font:650 .46rem/1 ui-monospace,monospace;letter-spacing:.13em}.docs-root strong{overflow:hidden;font-size:.83rem;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
  .docs-nav{padding:1.35rem .8rem 3rem}.docs-group+.docs-group{margin-top:1.75rem}.docs-group>p{margin:0 0 .55rem;padding:0 .75rem;color:var(--dim-fg);font:650 .52rem/1.2 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.docs-group ul{margin:0;padding:0;list-style:none}
  .docs-link{position:relative;display:flex;align-items:center;gap:.6rem;min-height:34px;padding:.42rem .7rem;color:var(--muted-fg);font-size:.78rem;line-height:1.35;transition:color 150ms ease,background 150ms ease}.docs-link i{width:3px;height:3px;flex:none;border-radius:50%;background:var(--dim-fg);opacity:.45}.docs-link:hover{color:var(--body-fg);background:color-mix(in srgb,var(--body-bg) 90%,var(--body-fg))}.docs-link.is-active{color:var(--body-fg);font-weight:650}.docs-link.is-active::before{content:"";position:absolute;inset-block:.35rem;inset-inline-start:-.8rem;width:2px;background:#2563eb}.docs-link.is-active i{width:5px;height:5px;background:#2563eb;opacity:1}
  :global(html.light) .docs-sidebar{background:#faf8f2}
</style>
